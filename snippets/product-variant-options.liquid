
{% comment %}
  ===================================================
  RIYAN CREATION | PREMIUM VARIANT SELECTOR V3
  Shopify Dawn 16.1.0

  Fixes:
  - Invisible selected variant text
  - White-on-white selected buttons
  - Hover colour conflicts
  - Mobile size button responsiveness
  - Unavailable variant presentation

  Preserves:
  - Shopify variant switching
  - Product form binding
  - Combined listing product URLs
  - Swatch support
  - Dropdown support
  - Option value IDs
  ===================================================
{% endcomment %}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- if option.position == 1 -%}
<style>
/* ===========================================
   RIYAN CREATION | VARIANT SELECTOR V3
   =========================================== */

#MainProduct-{{ section.id }} {
  --ry-variant-primary: #591c27;
  --ry-variant-dark: #481722;
  --ry-variant-background: #ffffff;
  --ry-variant-hover: #fbf2ee;
  --ry-variant-border: #e6d2c7;
  --ry-variant-muted: #8b7275;
}

/* FIELDSET */

#MainProduct-{{ section.id }}
.product-form__input--pill {
  max-width: 100%;
  margin-bottom: 15px;
  padding: 0;
  min-width: 0;
}

/* LABEL / LEGEND */

#MainProduct-{{ section.id }}
.product-form__input--pill legend {
  display: block;
  width: 100%;
  margin-bottom: 11px;
  padding: 0;

  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  line-height: 1.5;
  letter-spacing: .025em;

  color: var(--ry-variant-primary);
}

/* ===========================================
   DEFAULT VARIANT BUTTON
   =========================================== */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"] + label.ry-option-label {

  position: relative;
  display: inline-flex !important;

  align-items: center;
  justify-content: center;

  vertical-align: middle;

  min-width: 48px;
  min-height: 44px;

  max-width: 100%;

  margin: 0 7px 8px 0;
  padding: 10px 13px;

  border: 1px solid var(--ry-variant-border) !important;
  border-radius: 8px !important;

  background: var(--ry-variant-background) !important;
  background-color: var(--ry-variant-background) !important;
  background-image: none !important;

  color: var(--ry-variant-primary) !important;
  -webkit-text-fill-color: var(--ry-variant-primary) !important;

  opacity: 1;

  box-shadow: none !important;

  font-family: inherit;
  font-size: 12px;
  font-weight: 700;

  line-height: 1.2;
  letter-spacing: .01em;
  text-align: center;

  text-decoration: none !important;
  text-transform: none;

  white-space: nowrap;
  cursor: pointer;

  transition:
    background-color .22s ease,
    border-color .22s ease,
    color .22s ease,
    box-shadow .22s ease,
    transform .22s ease;
}

/* ===========================================
   UNSELECTED HOVER
   =========================================== */

@media (hover: hover) {

  #MainProduct-{{ section.id }}
  .product-form__input--pill
  input[type="radio"]:not(:checked):not(:disabled)
  + label.ry-option-label:hover {

    background: var(--ry-variant-hover) !important;
    background-color: var(--ry-variant-hover) !important;

    color: var(--ry-variant-primary) !important;
    -webkit-text-fill-color: var(--ry-variant-primary) !important;

    border-color: #bd9c8e !important;

    box-shadow: 0 3px 9px rgba(89,28,39,.07) !important;

    transform: translateY(-1px);
  }
}

/* ===========================================
   SELECTED SIZE
   Highest-priority visual state
   =========================================== */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label,

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label:hover,

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label:active {

  background: #591c27 !important;
  background-color: #591c27 !important;
  background-image: none !important;

  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;

  border: 1px solid #591c27 !important;

  opacity: 1 !important;

  text-decoration: none !important;

  box-shadow:
    0 4px 12px rgba(89,28,39,.18) !important;

  transform: none;
}

/* Keep any nested visible text in sync */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label span:not(.visually-hidden),

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label strong {

  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
}

/* Prevent decorative label overlays from
   covering the selected background */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label::before,

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:checked
+ label.ry-option-label::after {

  background: transparent !important;
  box-shadow: none !important;
}

/* ===========================================
   UNAVAILABLE VARIANTS
   Shopify's visually unavailable class
   =========================================== */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"].disabled:not(:checked)
+ label.ry-option-label {

  opacity: .58 !important;

  background: #faf7f5 !important;
  background-color: #faf7f5 !important;

  color: #8b7275 !important;
  -webkit-text-fill-color: #8b7275 !important;

  border-style: dashed !important;

  text-decoration: line-through !important;
  text-decoration-thickness: 1px !important;
}

/* Selected but unavailable */
#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"].disabled:checked
+ label.ry-option-label {

  opacity: .85 !important;

  background: #591c27 !important;
  background-color: #591c27 !important;

  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
}

/* ===========================================
   KEYBOARD ACCESSIBILITY
   =========================================== */

#MainProduct-{{ section.id }}
.product-form__input--pill
input[type="radio"]:focus-visible
+ label.ry-option-label {

  outline: 2px solid #a87966 !important;
  outline-offset: 3px !important;
}

/* ===========================================
   DROPDOWN VARIANTS
   =========================================== */

#MainProduct-{{ section.id }}
.product-form__input--dropdown
.select__select {

  min-height: 46px;

  border-radius: 8px;

  color: #591c27;
  background-color: #fffdfa;

  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
}

#MainProduct-{{ section.id }}
.product-form__input--dropdown
.select::before,

#MainProduct-{{ section.id }}
.product-form__input--dropdown
.select::after {
  border-radius: 8px;
}

/* ===========================================
   MOBILE
   =========================================== */

@media screen and (max-width: 749px) {

  #MainProduct-{{ section.id }}
  .product-form__input--pill {
    margin-bottom: 12px;
  }

  #MainProduct-{{ section.id }}
  .product-form__input--pill legend {
    font-size: 11px;
    margin-bottom: 9px;
  }

  #MainProduct-{{ section.id }}
  .product-form__input--pill
  input[type="radio"] + label.ry-option-label {

    min-width: 43px;
    min-height: 41px;

    margin: 0 5px 7px 0;
    padding: 9px 11px;

    font-size: 11px;
    border-radius: 7px !important;
  }
}

/* SMALL PHONES */

@media screen and (max-width: 360px) {

  #MainProduct-{{ section.id }}
  .product-form__input--pill
  input[type="radio"] + label.ry-option-label {

    min-width: 39px;
    min-height: 39px;

    margin-right: 4px;
    padding: 8px;

    font-size: 10px;
  }
}

/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  #MainProduct-{{ section.id }}
  .product-form__input--pill
  input[type="radio"] + label.ry-option-label {

    transition: none !important;
    transform: none !important;
  }
}
</style>
{%- endif -%}

{%- for value in option.values -%}

  {%- liquid
    assign swatch_focal_point = null
    assign swatch_value = null

    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point

    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- assign input_id = input_id | strip -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- assign input_name = input_name | strip -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url | escape }}"
    data-option-value-id="{{ value.id }}"
    data-option-name="{{ option.name | escape }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {%- assign escaped_value = value | escape -%}

  {%- if picker_type == 'swatch' -%}

    {%- capture help_text -%}
      <span class="visually-hidden">
        {{ escaped_value }}
      </span>

      {{ label_unavailable }}
    {%- endcapture -%}

    {% render 'swatch-input',
      id: input_id,
      name: input_name,
      value: escaped_value,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}

  {%- elsif picker_type == 'button' -%}

    <input
      type="radio"
      id="{{ input_id }}"
      name="{{ input_name | escape }}"
      value="{{ escaped_value }}"
      form="{{ product_form_id }}"

      {% if value.selected %}
        checked
      {% endif %}

      {% if option_disabled %}
        class="disabled"
      {% endif %}

      {{ input_dataset }}
    >

    <label
      class="ry-option-label"
      for="{{ input_id }}"
    >
      {{- value | escape -}}
      {{ label_unavailable }}
    </label>

  {%- elsif picker_type == 'dropdown'
    or picker_type == 'swatch_dropdown'
  -%}

    <option
      id="{{ input_id }}"
      value="{{ escaped_value }}"

      {% if value.selected %}
        selected="selected"
      {% endif %}

      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value | escape }}"

        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point | escape }}"
        {% endif %}
      {% endif %}

      {{ input_dataset }}
    >

      {% if option_disabled %}
        {{- 'products.product.value_unavailable'
          | t: option_value: value -}}
      {% else %}
        {{- value | escape -}}
      {% endif %}

    </option>

  {%- endif -%}

{%- endfor -%}
