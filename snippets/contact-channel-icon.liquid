{%- comment -%}
  Renders the icon used by the direct-contact cards.
  Accepts: icon - email, whatsapp, or location
{%- endcomment -%}
{%- case icon -%}
  {%- when 'email' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3.75 5.75h16.5v12.5H3.75zM4.5 6.5l7.5 6 7.5-6"/>
    </svg>
  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.2 11.8a8.2 8.2 0 0 1-12.1 7.2L4 20l1.1-4A8.2 8.2 0 1 1 20.2 11.8Z"/>
      <path d="M9.1 7.8c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.5l.7 1.7c.1.3 0 .5-.2.7l-.6.7c-.2.2-.1.4 0 .6.5.9 1.3 1.7 2.2 2.2.2.1.4.2.6 0l.8-1c.2-.2.4-.3.7-.2l1.8.9c.3.2.4.3.4.6 0 .3-.1 1.3-.8 1.8-.6.5-1.4.8-2.4.5-1-.2-2.3-.8-3.9-2.2-1.3-1.2-2.2-2.7-2.5-3.7-.4-1-.1-2 .3-2.5.4-.4.8-.6 1.2-.2Z"/>
    </svg>
  {%- when 'location' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/>
      <circle cx="12" cy="10" r="2.25"/>
    </svg>
{%- endcase -%}
