{% doc %}
Renders the GoKwik cart checkout control.
{% enddoc %}

{% if settings.goEnable %}
  <div class="gokwik-checkout"{% if settings.hideFlow %} hidden{% endif %}>
    <button
      type="button"
      class="button button--primary button--full-width disabled"
      disabled
      onclick="onCheckoutClick(this)"
    >
      <span class="btn-text">
        <span>{{ settings.main-titile | escape }}</span>
        <span>{{ settings.sub-titile | escape }}</span>
      </span>
      {% if settings.enableLogo %}
        <span class="pay-opt-icon" aria-hidden="true">
          <img src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt="" width="92" height="18">
          <img src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt="" width="15" height="15">
        </span>
      {% endif %}
      <span class="addloadr btn-loader" aria-hidden="true">
        <span class="cir-loader"></span>
      </span>
    </button>
  </div>
{% endif %}
