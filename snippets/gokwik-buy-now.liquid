{% doc %}
Renders the GoKwik Buy Now control inside a native Shopify product form.

@param {string} [button_id] - Unique button ID. The main product form uses the canonical GoKwik ID.
{% enddoc %}

{% if settings.goBuynowEnable %}
  <button
    {% if button_id == blank or button_id == 'gokwik-buy-now' %}
      id="gokwik-buy-now"
    {% else %}
      id="{{ button_id | escape }}"
    {% endif %}
    type="button"
    class="gokwik-buy-now button button--primary button--full-width disabled"
    disabled
    onclick="onBuyNowClick(this)"
    {% if settings.hideFlow %}hidden{% endif %}
  >
    <span class="addloadr btn-loader" aria-hidden="true">
      <span class="cir-loader"></span>
    </span>
    <span class="btn-text">
      <span>{{ settings.buyNowText | escape }}</span>
      <span>{{ settings.sub-titile | escape }}</span>
    </span>
    {% if settings.enableLogo %}
      <span class="pay-opt-icon" aria-hidden="true">
        <img src="https://cdn.gokwik.co/v4/images/upi-icons.svg" alt="" width="92" height="18">
        <img src="https://cdn.gokwik.co/v4/images/right-arrow.svg" alt="" width="15" height="15">
      </span>
    {% endif %}
  </button>
{% endif %}
