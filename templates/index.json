    "luxury_faq_TLpGWX": {
      "type": "luxury-faq",
      "blocks": {
        "faq_dYjEf4": {
          "type": "faq",
          "settings": {
            "question": "How do I care for my jewellery?",
            "answer": "<p>To keep your VEYZARA jewellery looking beautiful, avoid direct contact with water, perfumes, and harsh chemicals. Gently wipe each piece with a soft, dry cloth and store it separately in a cool, dry place.</p>"
          }
        },
        "faq_JqtqHf": {
          "type": "faq",
          "settings": {
            "question": "Is VEYZARA jewellery suitable for everyday wear?",
            "answer": "<p>Absolutely! Our collection features elegant, lightweight, and versatile designs that complement your everyday outfits as well as special occasions. Handle your jewellery with care to maintain its shine.</p>"
          }
        },
        "faq_frL39U": {
          "type": "faq",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>Delivery times may vary depending on your location. Once your order is shipped, you'll receive tracking information so you can follow your package until it reaches your doorstep.</p>"
          }
        },
        "faq_fwgkRD": {
          "type": "faq",
          "settings": {
            "question": "Can I return or exchange my jewellery?",
            "answer": "<p>Returns and exchanges are subject to our store policies. If you receive a damaged or incorrect product, please contact our support team with your order details and relevant photographs for assistance.</p>"
          }
        },
        "faq_xP4bWa": {
          "type": "faq",
          "settings": {
            "question": "How can I contact VEYZARA for assistance?",
            "answer": "<p>We're here to make your shopping experience effortless. For questions about products, orders, shipping, or returns, simply reach out through our Contact Us page. Our team will be happy to assist you.</p>"
          }
        }
      },
