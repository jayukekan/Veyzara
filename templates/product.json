dding: 13px;\n  gap: 8px;\n  border: 1px solid var(--ry-border);\n  border-radius: 10px;\n  background: var(--ry-card);\n  scroll-snap-align: start;\n  transition:\n    background .25s ease,\n    border-color .25s ease,\n    transform .25s ease;\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__card:hover {\n  background: var(--ry-card-hover);\n  border-color: #DAC0BD;\n  transform: translateY(-1px);\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__info {\n  flex: 1 1 auto;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 5px;\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__eyebrow {\n  font-size: 9px;\n  font-weight: 700;\n  color: var(--ry-primary-light);\n  line-height: 1.3;\n  letter-spacing: .7px;\n  text-transform: uppercase;\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__offer strong {\n  display: block;\n  font-size: 23px;\n  font-weight: 750;\n  line-height: 1.1;\n  letter-spacing: -.7px;\n  color: var(--ry-primary);\n  white-space: nowrap;\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__info p {\n  margin: 0;\n  font-size: 10px;\n  font-weight: 400;\n  line-height: 1.4;\n  color: var(--ry-muted);\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__coupon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: nowrap;\n  flex: 0 0 auto;\n  gap: 5px;\n  border: 1px dashed #D6B7B3;\n  border-radius: 6px;\n  padding: 8px 9px;\n  background: #FFFFFF;\n  color: var(--ry-primary);\n  font-family: inherit;\n  cursor: pointer;\n  min-width: 0;\n  min-height: 34px;\n  line-height: 1;\n  transition: background .2s, border-color .2s;\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__coupon:hover {\n  background: #FFF8F6;\n  border-color: var(--ry-primary);\n}\n\n#ry-offers-{{ ry_offer_uid }} .ry-offers-v7__coupon-text {\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: .2px;\n  white-space: nowrap;\n  text-transform: uppercase;\n}\n\n#ry-offers-{{ ry_offer_uid 