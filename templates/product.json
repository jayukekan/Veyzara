 }} .ry-offers-v7__copy-label {\n    display: none;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__automatic {\n    padding: 6px;\n    font-size: 9px;\n  }\n}\n\n/* MOBILE SLIDER */\n@media screen and (max-width: 749px) {\n  #ry-offers-{{ ry_offer_uid }} {\n    padding: 10px;\n    border-radius: 10px;\n    margin: 8px 0;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__head {\n    margin-bottom: 8px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__heading {\n    font-size: 11px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__brand {\n    font-size: 8px;\n    letter-spacing: .6px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__gift {\n    width: 23px;\n    height: 23px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__card {\n    flex: 0 0 100%;\n    min-height: 84px;\n    padding: 12px;\n    gap: 8px;\n    border-radius: 9px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__offer strong {\n    font-size: 23px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__eyebrow {\n    font-size: 9px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__navigation {\n    display: flex;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__coupon {\n    padding: 8px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__copy-label {\n    display: none;\n  }\n}\n\n/* EXTRA SMALL MOBILE */\n@media screen and (max-width: 360px) {\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__card {\n    padding: 10px 9px;\n    gap: 6px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__offer strong {\n    font-size: 21px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__eyebrow {\n    font-size: 8px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__coupon-text {\n    font-size: 10px;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__automatic {\n    font-size: 9px;\n    padding: 7px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  #ry-offers-{{ ry_offer_uid }} *,\n  #ry-offers-{{ ry_offer_uid }} *::before,\n  #ry-offers-{{ ry_offer_uid }} *::after {\n    transition: none !important;\n    animation: none !important;\n  }\n\n  #ry-offers-{{ ry_offer_uid }} .ry-offers-v7__viewport {\n    scroll-behavior: auto;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const rootId = 'ry-offers-{{ ry_offer_uid }}';\n\n  function initRiyanOffersV7() {\n    const root = document.getElementById(rootId);\n\n    if (!root || root.dataset.ryReady === 'true') return;\n    root.dataset.ryReady = 'true';\n\n    const viewport = root.querySelector('.ry-offers-v7__viewport');\n    const cards = Array.from(root.querySelectorAll('.ry-offers-v7__card'));\n    const dots = Array.from(root.querySelectorAll('.ry-offers-v7__dot'));\n    const copyButton = root.querySelector('.ry-offers-v7__coupon');\n    const status = root.querySelector('.ry-offers-v7__status');\n\n    if (!viewport || !cards.length) return;\n\n    const mobileQuery = window.matchMedia('(max-width: 749px)');\n    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    let autoplay = null;\n    let resumeTimer = null;\n    let scrollTimer = null;\n\n    function getCurrentSlide() {\n      let closest = 0;\n      let minDistance = Infinity;\n\n      cards.forEach((card, index) => {\n        const position = card.offsetLeft - cards[0].offsetLeft;\n        const distance = Math.abs(viewport.scrollLeft - position);\n\n        if (distance < minDistance) {\n          minDistance = distance;\n          closest = index;\n        }\n      });\n\n      return closest;\n    }\n\n    function updateDots(index = getCurrentSlide()) {\n      dots.forEach((dot, i) => {\n        const active = index === i;\n        dot.classList.toggle('is-active', active);\n        dot.setAttribute('aria-current', String(active));\n      });\n    }\n\n    function goTo(index) {\n      if (!mobileQuery.matches || !cards[index]) return;\n\n      const left = cards[index].offsetLeft - cards[0].offsetLeft;\n\n      viewport.scrollTo({\n        left: left,\n        behavior: motionQuery.matches ? 'instant' : 'smooth'\n      });\n\n      updateDots(index);\n    }\n\n    function stopAutoplay() {\n      if (autoplay) {\n        clearInterval(autoplay);\n        autoplay = null;\n      }\n    }\n\n    function startAutoplay() {\n      stopAutoplay();\n\n      if (\n        !mobileQuery.matches ||\n        motionQuery.matches ||\n        document.hidden ||\n        root.matches(':hover') ||\n        root.contains(document.activeElement) ||\n        cards.length < 2\n      ) return;\n\n      autoplay = setInterval(() => {\n        goTo((getCurrentSlide() + 1) % cards.length);\n      }, 4000);\n    }\n\n    function resumeLater() {\n      clearTimeout(resumeTimer);\n      resumeTimer = setTimeout(startAutoplay, 5000);\n    }\n\n    dots.forEach((dot, index) => {\n      dot.addEventListener('click', () => {\n        stopAutoplay();\n        goTo(index);\n        resumeLater();\n      });\n    });\n\n    viewport.addEventListener('scroll', () => {\n      clearTimeout(scrollTimer);\n      scrollTimer = setTimeout(() => updateDots(), 90);\n    }, { passive: true });\n\n    viewport.addEventListener('touchstart', () => {\n      stopAutoplay();\n      clearTimeout(resumeTimer);\n    }, { passive: true });\n\n    viewport.addEventListener('touchend', resumeLater, {\n      passive: true\n    });\n\n    root.addEventListener('mouseenter', stopAutoplay);\n    root.addEventListener('mouseleave', startAutoplay);\n    root.addEventListener('focusin', stopAutoplay);\n    root.addEventListener('focusout', () => {\n      setTimeout(startAutoplay, 0);\n    });\n\n    window.addEventListener('resize', () => {\n      if (!mobileQuery.matches) viewport.scrollLeft = 0;\n      updateDots();\n      startAutoplay();\n    });\n\n    document.addEventListener('visibilitychange', startAutoplay);\n\n    if (copyButton) {\n      copyButton.addEventListener('click', async () => {\n        const code = copyButton.dataset.code;\n        const label = copyButton.querySelector('.ry-offers-v7__copy-label');\n\n        let copied = false;\n\n        try {\n          if (navigator.clipboard && window.isSecureContext) {\n            await navigator.clipboard.writeText(code);\n            copied = true;\n          }\n        } catch (error) {\n          copied = false;\n        }\n\n        if (!copied) {\n          const textArea = document.createElement('textarea');\n          textArea.value = code;\n          textArea.style.position = 'fixed';\n          textArea.style.opacity = '0';\n          document.body.appendChild(textArea);\n          textArea.select();\n\n          try {\n            copied = document.execCommand('copy');\n          } catch (error) {\n            copied = false;\n          }\n\n          textArea.remove();\n        }\n\n        if (copied) {\n          copyButton.classList.add('is-copied');\n          copyButton.setAttribute('aria-label', 'Coupon copied: ' + code);\n          if (label) label.textContent = 'Copied!';\n          if (status) status.textContent = 'Copied coupon code ' + code;\n\n          setTimeout(() => {\n            copyButton.classList.remove('is-copied');\n            copyButton.setAttribute('aria-label', 'Copy coupon code ' + code);\n            if (label) label.textContent = 'Copy';\n          }, 2200);\n        } else {\n          if (status) status.textContent = 'Unable to copy. Coupon code is ' + code;\n        }\n      });\n    }\n\n    startAutoplay();\n  }\n\n  initRiyanOffersV7();\n\n  document.addEventListener('shopify:section:load', initRiyanOffersV7);\n})();\n</script>"
