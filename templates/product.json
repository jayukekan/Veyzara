        "custom_liquid_VjeUda": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  VEYZARA GLOBAL — PREMIUM PAYMENT ICONS\n  Original Shopify CDN Images\n  Custom Liquid Compatible\n  Desktop + Mobile Responsive\n{% endcomment %}\n\n<div class=\"rc-premium-payments\">\n\n  <div class=\"rc-premium-payments__grid\">\n\n    <!-- PhonePe -->\n    <div class=\"rc-premium-payments__item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0892/3892/9719/files/download_17954508-c3dc-4d03-87b2-f11bae4d1a81.png?v=1792235701\"\n        alt=\"PhonePe\"\n        width=\"150\"\n        height=\"80\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <!-- Google Pay -->\n    <div class=\"rc-premium-payments__item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0892/3892/9719/files/download_a247c5c9-949e-4a18-a3c8-84f0207e5b2e.png?v=1792235710\"\n        alt=\"Google Pay\"\n        width=\"150\"\n        height=\"80\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <!-- CRED -->\n    <div class=\"rc-premium-payments__item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0892/3892/9719/files/download_92765148-e118-458c-b48e-89d5b645d3f0.png?v=1792235715\"\n        alt=\"CRED\"\n        width=\"150\"\n        height=\"80\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <!-- Paytm -->\n    <div class=\"rc-premium-payments__item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0892/3892/9719/files/download_8de876c7-197f-4174-85e8-5d6d654a5149.png?v=1792235756\"\n        alt=\"Paytm\"\n        width=\"150\"\n        height=\"80\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <!-- Visa -->\n    <div class=\"rc-premium-payments__item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0892/3892/9719/files/download_c51fad86-e938-4cd4-b870-58a853b7eaec.png?v=1792235723\"\n        alt=\"Visa\"\n        width=\"150\"\n        height=\"80\"\n        loading=\"lazy\"\n      >\n    </div>\n\n  </div>\n\n</div>\n\n<style>\n.rc-premium-payments {\n  width: 100%;\n  margin: 14px 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n.rc-premium-payments *,\n.rc-premium-payments *::before,\n.rc-premium-payments *::after {\n  box-sizing: border-box;\n}\n\n.rc-premium-payments__grid {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 9px;\n  width: 100%;\n  align-items: center;\n}\n\n.rc-premium-payments__item {\n  width: 100%;\n  min-width: 0;\n  height: 60px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 9px;\n\n  background: #ffffff;\n  border: 1px solid #eadedb;\n  border-radius: 9px;\n  overflow: hidden;\n\n  transition:\n    transform 0.25s ease,\n    box-shadow 0.25s ease,\n    border-color 0.25s ease;\n}\n\n.rc-premium-payments__item:hover {\n  transform: translateY(-3px);\n  border-color: #c5a29f;\n  box-shadow: 0 6px 16px rgba(72, 28, 43, 0.09);\n}\n\n.rc-premium-payments__item img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  max-width: 100%;\n  max-height: 100%;\n  object-fit: contain;\n  object-position: center;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  box-shadow: none;\n}\n\n/* Tablet */\n@media screen and (max-width: 989px) {\n  .rc-premium-payments__grid {\n    gap: 7px;\n  }\n\n  .rc-premium-payments__item {\n    height: 52px;\n    padding: 6px;\n    border-radius: 7px;\n  }\n}\n\n/* Mobile */\n@media screen and (max-width: 749px) {\n  .rc-premium-payments {\n    margin: 11px 0;\n  }\n\n  .rc-premium-payments__grid {\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 5px;\n  }\n\n  .rc-premium-payments__item {\n    height: 44px;\n    padding: 4px;\n    border-radius: 6px;\n  }\n}\n\n/* Small mobile screens */\n@media screen and (max-width: 359px) {\n  .rc-premium-payments__grid {\n    gap: 4px;\n  }\n\n  .rc-premium-payments__item {\n    height: 39px;\n    padding: 3px;\n  }\n}\n\n/* Accessibility */\n@media (prefers-reduced-motion: reduce) {\n  .rc-premium-payments__item {\n    transition: none;\n  }\n\n  .rc-premium-payments__item:hover {\n    transform: none;\n  }\n}\n</style>"
