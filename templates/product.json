          "settings": {
            "custom_liquid": "{% comment %}\n  VEYZARA GLOBAL — PREMIUM SIZE GUIDE DRAWER\n  Add to Product Information > Custom Liquid\n{% endcomment %}\n\n{% assign ry_size_key = section.id | append: '-' | append: product.id %}\n\n<div id=\"ry-size-entry-{{ ry_size_key }}\" class=\"ry-size-entry\">\n\n  <button\n    class=\"ry-size-open\"\n    type=\"button\"\n    aria-haspopup=\"dialog\"\n    aria-controls=\"ry-size-dialog-{{ ry_size_key }}\"\n  >\n    <span class=\"ry-size-open-left\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\"\n        stroke=\"currentColor\" stroke-width=\"1.6\"\n        aria-hidden=\"true\">\n        <rect x=\"2.5\" y=\"6\" width=\"19\" height=\"12\" rx=\"2\"/>\n        <path d=\"M6 6v5m4-5v3m4-3v5m4-5v3\"/>\n      </svg>\n      <span>Find Your Perfect Fit</span>\n    </span>\n\n    <span class=\"ry-size-open-right\">\n      SIZE GUIDE\n      <span aria-hidden=\"true\">↗</span>\n    </span>\n  </button>\n\n  <dialog\n    id=\"ry-size-dialog-{{ ry_size_key }}\"\n    class=\"ry-size-dialog\"\n    aria-labelledby=\"ry-size-title-{{ ry_size_key }}\"\n    aria-describedby=\"ry-size-desc-{{ ry_size_key }}\"\n  >\n    <div class=\"ry-size-panel\">\n\n      <header class=\"ry-size-panel-head\">\n\n        <span class=\"ry-size-eyebrow\">\n          VEYZARA GLOBAL · THE FIT EDIT\n        </span>\n\n        <button\n          type=\"button\"\n          class=\"ry-size-close\"\n          aria-label=\"Close size guide\"\n        >\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.8\"\n            aria-hidden=\"true\">\n            <path d=\"M6 6l12 12M18 6 6 18\"/>\n          </svg>\n        </button>\n\n        <h2 id=\"ry-size-title-{{ ry_size_key }}\">\n          Your Perfect Fit\n        </h2>\n\n        <p id=\"ry-size-desc-{{ ry_size_key }}\">\n          An effortless guide to finding your size.\n        </p>\n\n      </header>\n\n      <div class=\"ry-size-panel-body\">\n\n        <div class=\"ry-size-table-head\">\n          <span>SIZE</span>\n          <span>CHEST · INCHES</span>\n        </div>\n\n        <div\n          class=\"ry-size-measurements\"\n          role=\"table\"\n          aria-label=\"VEYZARA Global chest size chart\"\n        >\n          {% assign ry_size_labels = 'XS,S,M,L,XL,XXL,XXXL,XXXXL' | split: ',' %}\n          {% assign ry_chest_sizes = '34,36,39,40,42,44,46,48' | split: ',' %}\n\n          {% for ry_label in ry_size_labels %}\n            <div class=\"ry-size-measure-row\" role=\"row\">\n              <span role=\"cell\">{{ ry_label }}</span>\n              <strong role=\"cell\">\n                {{ ry_chest_sizes[forloop.index0] }}&Prime;\n              </strong>\n            </div>\n          {% endfor %}\n        </div>\n\n        <div class=\"ry-size-advice\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.7\"\n            aria-hidden=\"true\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n            <path d=\"M12 11v5m0-8h.01\"/>\n          </svg>\n\n          <span>\n            All measurements are in inches.\n            Compare against your preferred garment\n            for a comfortable fit.\n          </span>\n        </div>\n\n      </div>\n\n      <footer class=\"ry-size-panel-foot\">\n        <button type=\"button\" class=\"ry-size-done\">\n          CONTINUE SHOPPING\n          <span aria-hidden=\"true\">→</span>\n        </button>\n      </footer>\n\n    </div>\n  </dialog>\n\n</div>\n\n<style>\n/* =======================================\n   VEYZARA GLOBAL PREMIUM SIZE GUIDE\n======================================= */\n\n/* COMPACT TRIGGER */\n\n#ry-size-entry-{{ ry_size_key }} {\n  --ry-wine: #591C27;\n  --ry-gold: #B18A65;\n  --ry-cream: #FCF8F4;\n\n  font-family: inherit;\n  width: 100%;\n  margin: 9px 0;\n}\n\n#ry-size-entry-{{ ry_size_key }} * {\n  box-sizing: border-box;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open {\n  width: 100%;\n  min-height: 46px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 10px 14px;\n  background: #FFFDFB;\n  border: 1px solid #E5D7CD;\n  border-radius: 7px;\n  color: var(--ry-wine);\n  font-family: inherit;\n  cursor: pointer;\n  transition:\n    border-color .22s,\n    background .22s,\n    box-shadow .22s;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open:hover {\n  background: #FAF3EF;\n  border-color: #C9A98C;\n  box-shadow: 0 4px 15px rgba(89,28,39,.05);\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open:focus-visible {\n  outline: 2px solid var(--ry-wine);\n  outline-offset: 3px;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open-left {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  min-width: 0;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: .1px;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open-left svg {\n  width: 17px;\n  height: 17px;\n  color: var(--ry-gold);\n  flex-shrink: 0;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open-right {\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.3px;\n  color: #9C765C;\n  white-space: nowrap;\n}\n\n#ry-size-entry-{{ ry_size_key }} .ry-size-open-right span {\n  font-size: 17px;\n  margin-left: 7px;\n  vertical-align: middle;\n  color: var(--ry-wine);\n}\n\n/* FLOATING DRAWER */\n\n#ry-size-dialog-{{ ry_size_key }} {\n  --ry-wine: #591C27;\n  --ry-gold: #B18A65;\n\n  box-sizing: border-box;\n  position: fixed;\n  inset: 0 0 0 auto;\n  margin: 0;\n  padding: 0;\n  width: min(440px, 100vw);\n  max-width: 100vw;\n  height: 100dvh;\n  max-height: 100dvh;\n  border: 0;\n  border-left: 1px solid #E6D7CB;\n  border-radius: 0;\n  background: #FFFEFD;\n  color: #392C30;\n  box-shadow: -15px 0 60px rgba(38,15,23,.14);\n  overflow: hidden;\n  font-family: inherit;\n  opacity: 0;\n  transform: translateX(24px);\n  transition:\n    opacity .25s ease,\n    transform .25s ease,\n    display .25s allow-discrete,\n    overlay .25s allow-discrete;\n  z-index: 2147483000;\n}\n\n#ry-size-dialog-{{ ry_size_key }}[open] {\n  opacity: 1;\n  transform: translateX(0);\n}\n\n@starting-style {\n  #ry-size-dialog-{{ ry_size_key }}[open] {\n    opacity: 0;\n    transform: translateX(24px);\n  }\n}\n\n#ry-size-dialog-{{ ry_size_key }}::backdrop {\n  background: rgba(24,13,18,.54);\n  backdrop-filter: blur(2px);\n}\n\n#ry-size-dialog-{{ ry_size_key }} *,\n#ry-size-dialog-{{ ry_size_key }} *::before,\n#ry-size-dialog-{{ ry_size_key }} *::after {\n  box-sizing: border-box;\n}\n\n/* DRAWER STRUCTURE */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-panel {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n/* DRAWER HEADER */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-panel-head {\n  flex-shrink: 0;\n  position: relative;\n  padding: 37px 28px 21px;\n  background: linear-gradient(\n    145deg,\n    #FFFCF8,\n    #F9F0EA\n  );\n  border-bottom: 1px solid #EBDDD4;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-eyebrow {\n  font-size: 10px;\n  letter-spacing: 2px;\n  font-weight: 700;\n  color: #AB8463;\n}\n\n#ry-size-dialog-{{ ry_size_key }} h2 {\n  margin: 15px 0 8px;\n  padding: 0;\n  font-family: Georgia, 'Times New Roman', serif;\n  font-size: 34px;\n  font-weight: 400;\n  line-height: 1.14;\n  color: #591C27;\n  letter-spacing: -.7px;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-panel-head p {\n  margin: 0;\n  font-size: 12px;\n  color: #8B746C;\n  line-height: 1.6;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-close {\n  position: absolute;\n  right: 20px;\n  top: 22px;\n  width: 35px;\n  height: 35px;\n  border: 1px solid #E5D5C9;\n  border-radius: 50%;\n  background: #FFFFFF;\n  color: #591C27;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n  transition: transform .2s, background .2s;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-close:hover {\n  transform: rotate(90deg);\n  background: #F6EBE5;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-close svg {\n  width: 16px;\n  height: 16px;\n}\n\n/* SCROLLABLE CONTENT */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-panel-body {\n  padding: 24px 28px;\n  overflow: auto;\n  flex: 1;\n  min-height: 0;\n  overscroll-behavior: contain;\n}\n\n/* SIZE TABLE */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-table-head {\n  display: flex;\n  justify-content: space-between;\n  padding: 0 4px 10px;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: #B18A65;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measurements {\n  border: 1px solid #E8DAD0;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 45px;\n  padding: 9px 16px;\n  border-bottom: 1px solid #EDE2DB;\n  font-size: 13px;\n  line-height: 1.4;\n  background: #FFFFFF;\n  transition: background .2s;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row:nth-child(even) {\n  background: #FCF8F5;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row:last-child {\n  border-bottom: 0;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row:hover {\n  background: #F7EEE8;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row span {\n  font-weight: 700;\n  color: #591C27;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row strong {\n  font-size: 13px;\n  color: #57464A;\n  font-variant-numeric: tabular-nums;\n}\n\n/* FIT ADVICE */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-advice {\n  display: flex;\n  gap: 10px;\n  align-items: flex-start;\n  margin-top: 18px;\n  padding: 14px;\n  border: 1px solid #EBDDD1;\n  border-radius: 7px;\n  background: #FBF5F0;\n  font-size: 11px;\n  line-height: 1.6;\n  color: #806E68;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-advice svg {\n  width: 17px;\n  height: 17px;\n  flex-shrink: 0;\n  color: #B18A65;\n}\n\n/* FOOTER BUTTON */\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-panel-foot {\n  padding: 14px 28px max(17px, env(safe-area-inset-bottom));\n  border-top: 1px solid #EFE5DD;\n  background: #FFFFFF;\n  flex-shrink: 0;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-done {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  width: 100%;\n  min-height: 46px;\n  background: #591C27;\n  border: 1px solid #591C27;\n  border-radius: 5px;\n  color: #FFFFFF;\n  font-family: inherit;\n  font-size: 11px;\n  font-weight: 700;\n  line-height: 1.4;\n  letter-spacing: 1.4px;\n  cursor: pointer;\n  transition: background .2s, transform .2s;\n}\n\n#ry-size-dialog-{{ ry_size_key }} .ry-size-done:hover {\n  background: #743646;\n  transform: translateY(-1px);\n}\n\n#ry-size-dialog-{{ ry_size_key }} button:focus-visible {\n  outline: 2px solid #B18A65;\n  outline-offset: 3px;\n}\n\n/* MOBILE BOTTOM SHEET */\n\n@media (max-width: 749px) {\n\n  #ry-size-entry-{{ ry_size_key }} .ry-size-open {\n    min-height: 43px;\n    padding: 9px 11px;\n  }\n\n  #ry-size-entry-{{ ry_size_key }} .ry-size-open-left {\n    font-size: 11px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} {\n    inset: auto 0 0 0;\n    width: 100vw;\n    height: min(85dvh, 760px);\n    max-height: 85dvh;\n    border: 0;\n    border-radius: 16px 16px 0 0;\n    transform: translateY(22px);\n  }\n\n  #ry-size-dialog-{{ ry_size_key }}[open] {\n    transform: translateY(0);\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-panel-head {\n    padding: 28px 20px 17px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} h2 {\n    font-size: 29px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-close {\n    right: 17px;\n    top: 15px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-panel-body {\n    padding: 16px 20px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-measure-row {\n    min-height: 41px;\n  }\n\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-panel-foot {\n    padding: 12px 20px max(13px, env(safe-area-inset-bottom));\n  }\n}\n\n/* ACCESSIBILITY */\n\n@media (prefers-reduced-motion: reduce) {\n\n  #ry-size-dialog-{{ ry_size_key }},\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-close,\n  #ry-size-dialog-{{ ry_size_key }} .ry-size-done,\n  #ry-size-entry-{{ ry_size_key }} .ry-size-open {\n    transition: none;\n  }\n}\n</style>\n\n<script>\n(function () {\n\n  var entry = document.getElementById(\n    'ry-size-entry-{{ ry_size_key }}'\n  );\n\n  var dialog = document.getElementById(\n    'ry-size-dialog-{{ ry_size_key }}'\n  );\n\n  if (!entry || !dialog ||\n      entry.dataset.rySizeReady === 'true') {\n    return;\n  }\n\n  entry.dataset.rySizeReady = 'true';\n\n  var trigger = entry.querySelector('.ry-size-open');\n  var closeButton = dialog.querySelector('.ry-size-close');\n  var doneButton = dialog.querySelector('.ry-size-done');\n\n  /*\n    Move the dialog outside the theme's\n    product information column.\n    This prevents clipping and layout conflicts.\n  */\n  document.body.appendChild(dialog);\n\n  function closeGuide() {\n    if (dialog.open) {\n      dialog.close();\n    }\n  }\n\n  /*\n    OPEN DRAWER\n  */\n  trigger.addEventListener('click', function () {\n    if (!dialog.isConnected) {\n      document.body.appendChild(dialog);\n    }\n\n    if (!dialog.open) {\n      dialog.showModal();\n    }\n  });\n\n  /*\n    CLOSE BUTTONS\n  */\n  closeButton.addEventListener('click', closeGuide);\n  doneButton.addEventListener('click', closeGuide);\n\n  /*\n    CLOSE WHEN CLICKING OUTSIDE PANEL\n  */\n  dialog.addEventListener('click', function (event) {\n\n    if (event.target !== dialog) {\n      return;\n    }\n\n    var r = dialog.getBoundingClientRect();\n\n    if (\n      event.clientX < r.left ||\n      event.clientX > r.right ||\n      event.clientY < r.top ||\n      event.clientY > r.bottom\n    ) {\n      closeGuide();\n    }\n  });\n\n  /*\n    RESTORE FOCUS AFTER CLOSING\n  */\n  dialog.addEventListener('close', function () {\n    if (trigger.isConnected) {\n      trigger.focus({ preventScroll: true });\n    }\n  });\n\n  /*\n    SHOPIFY THEME EDITOR CLEANUP\n  */\n  document.addEventListener(\n    'shopify:section:unload',\n    function (event) {\n      if (event.target && event.target.contains(entry)) {\n        closeGuide();\n        dialog.remove();\n      }\n    }\n  );\n\n})();\n</script>"
          }
