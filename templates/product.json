        "custom_liquid_YJARVC": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  VEYZARA GLOBAL | THE VEYZARA PROMISE V6\n  Premium compact USP slider\n  Desktop: 4 USP cards\n  Mobile: 2 cards per slide\n  Native swipe + autoplay + interactive dots\n  Dawn compatible | No dependencies\n{% endcomment %}\n\n{% assign ry_usp_uid = block.id | default: section.id | default: 'main' | replace: '_', '-' %}\n\n<div id=\"ry-usp-{{ ry_usp_uid }}\" class=\"ry-usp-v6\">\n\n  <div class=\"ry-usp-v6__header\">\n    <div class=\"ry-usp-v6__heading\">\n      <span class=\"ry-usp-v6__heading-icon\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"1.6\"\n          stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 3 14.6 9.4 21 12l-6.4 2.6L12 21l-2.6-6.4L3 12l6.4-2.6L12 3Z\"/>\n          <path d=\"m19 2 .8 2.2L22 5l-2.2.8L19 8l-.8-2.2L16 5l2.2-.8L19 2Z\"/>\n        </svg>\n      </span>\n      <span>THE VEYZARA PROMISE</span>\n    </div>\n    <span class=\"ry-usp-v6__header-tag\">\n      Thoughtfully Crafted\n    </span>\n  </div>\n\n  <div class=\"ry-usp-v6__viewport\"\n    tabindex=\"0\"\n    role=\"region\"\n    aria-roledescription=\"carousel\"\n    aria-label=\"VEYZARA Global shopping benefits\">\n\n    <div class=\"ry-usp-v6__track\">\n\n      <!-- USP 1: SHIPPING -->\n      <div class=\"ry-usp-v6__item\">\n        <span class=\"ry-usp-v6__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.5\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M3 6.5h11.5V17H3z\"/>\n            <path d=\"M14.5 10h4l3 4v3h-7\"/>\n            <circle cx=\"7.5\" cy=\"17.5\" r=\"1.7\"/>\n            <circle cx=\"18\" cy=\"17.5\" r=\"1.7\"/>\n            <path d=\"M3 10.5H1.5\"/>\n            <path d=\"M3 13.5H2\"/>\n          </svg>\n        </span>\n\n        <span class=\"ry-usp-v6__text\">\n          <strong>Free Shipping</strong>\n          <small>Across India</small>\n        </span>\n      </div>\n\n      <!-- USP 2: EXCHANGE -->\n      <div class=\"ry-usp-v6__item\">\n        <span class=\"ry-usp-v6__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.5\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M20 7H5\"/>\n            <path d=\"m9 3-4 4 4 4\"/>\n            <path d=\"M4 17h15\"/>\n            <path d=\"m15 13 4 4-4 4\"/>\n          </svg>\n        </span>\n\n        <span class=\"ry-usp-v6__text\">\n          <strong>Easy Exchange</strong>\n          <small>7-Day Window</small>\n        </span>\n      </div>\n\n      <!-- USP 3: PAYMENT -->\n      <div class=\"ry-usp-v6__item\">\n        <span class=\"ry-usp-v6__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.5\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M12 2.5 20 6v6c0 5-3.2 8-8 10-4.8-2-8-5-8-10V6l8-3.5Z\"/>\n            <path d=\"m8.5 12 2.2 2.2 4.8-4.8\"/>\n          </svg>\n        </span>\n\n        <span class=\"ry-usp-v6__text\">\n          <strong>Secure Payment</strong>\n          <small>Protected Checkout</small>\n        </span>\n      </div>\n\n      <!-- USP 4: PREMIUM STYLES -->\n      <div class=\"ry-usp-v6__item\">\n        <span class=\"ry-usp-v6__icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.5\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M6 4h12l4 6-10 12L2 10l4-6Z\"/>\n            <path d=\"M2 10h20\"/>\n            <path d=\"m6 4 6 18 6-18\"/>\n          </svg>\n        </span>\n\n        <span class=\"ry-usp-v6__text\">\n          <strong>Premium Styles</strong>\n          <small>Timeless Fashion</small>\n        </span>\n      </div>\n\n    </div>\n  </div>\n\n  <!-- MOBILE NAVIGATION -->\n  <div class=\"ry-usp-v6__navigation\"\n    role=\"group\"\n    aria-label=\"Benefit slider navigation\">\n\n    <button\n      type=\"button\"\n      class=\"ry-usp-v6__dot is-active\"\n      data-page=\"0\"\n      aria-label=\"Show benefits 1 and 2\"\n      aria-current=\"true\">\n    </button>\n\n    <button\n      type=\"button\"\n      class=\"ry-usp-v6__dot\"\n      data-page=\"1\"\n      aria-label=\"Show benefits 3 and 4\"\n      aria-current=\"false\">\n    </button>\n\n  </div>\n\n</div>\n\n<style>\n#ry-usp-{{ ry_usp_uid }} {\n  --ry-wine: #652B42;\n  --ry-wine-dark: #542A3A;\n  --ry-wine-soft: #806671;\n  --ry-background: #FFFAF8;\n  --ry-card: #FFFFFF;\n  --ry-icon-bg: #F8EEEA;\n  --ry-icon-border: #EBDAD5;\n  --ry-border: #EBDDD8;\n\n  display: block;\n  position: relative;\n  width: 100%;\n  max-width: 100%;\n  margin: 9px 0;\n  padding: 10px;\n  background: var(--ry-background);\n  border: 1px solid var(--ry-border);\n  border-radius: 11px;\n  overflow: hidden;\n  box-sizing: border-box;\n  font-family: var(--font-body-family, Arial, sans-serif);\n}\n\n#ry-usp-{{ ry_usp_uid }} *,\n#ry-usp-{{ ry_usp_uid }} *::before,\n#ry-usp-{{ ry_usp_uid }} *::after {\n  box-sizing: border-box;\n}\n\n/* HEADER */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 9px;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__heading {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--ry-wine);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .85px;\n  line-height: 1.3;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__heading-icon {\n  display: inline-flex;\n  width: 16px;\n  height: 16px;\n  align-items: center;\n  justify-content: center;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__heading-icon svg {\n  width: 16px;\n  height: 16px;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__header-tag {\n  color: #9F848B;\n  font-size: 9px;\n  font-weight: 500;\n  letter-spacing: .2px;\n  white-space: nowrap;\n}\n\n/* SLIDER VIEWPORT */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__viewport {\n  width: 100%;\n  max-width: 100%;\n  overflow-x: auto;\n  overflow-y: hidden;\n  scrollbar-width: none;\n  scroll-snap-type: x mandatory;\n  scroll-behavior: smooth;\n  overscroll-behavior-x: contain;\n  -webkit-overflow-scrolling: touch;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__viewport::-webkit-scrollbar {\n  display: none;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__track {\n  display: flex;\n  gap: 7px;\n}\n\n/* USP CARDS */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__item {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 8px;\n  flex: 0 0 calc((100% - 21px) / 4);\n  min-width: 0;\n  min-height: 60px;\n  padding: 8px;\n  background: var(--ry-card);\n  border: 1px solid var(--ry-border);\n  border-radius: 8px;\n  scroll-snap-align: start;\n  transition:\n    background .25s ease,\n    border-color .25s ease,\n    transform .25s ease,\n    box-shadow .25s ease;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__item:hover {\n  background: #FFFFFF;\n  border-color: #DDC6C6;\n  box-shadow: 0 3px 12px rgba(80, 30, 45, .055);\n}\n\n/* DARK, VISIBLE ICONS */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon {\n  display: flex;\n  flex: 0 0 34px;\n  width: 34px;\n  height: 34px;\n  align-items: center;\n  justify-content: center;\n  background: var(--ry-icon-bg);\n  border: 1px solid var(--ry-icon-border);\n  border-radius: 7px;\n  color: var(--ry-wine);\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon svg {\n  display: block;\n  width: 21px;\n  height: 21px;\n  flex-shrink: 0;\n  stroke: currentColor;\n}\n\n/* TEXT */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  min-width: 0;\n  gap: 3px;\n  text-align: left;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text strong {\n  display: block;\n  width: 100%;\n  color: var(--ry-wine-dark);\n  font-size: 11px;\n  line-height: 1.3;\n  font-weight: 650;\n  letter-spacing: 0;\n  overflow-wrap: break-word;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text small {\n  display: block;\n  width: 100%;\n  color: var(--ry-wine-soft);\n  font-size: 9px;\n  line-height: 1.35;\n  font-weight: 400;\n  overflow-wrap: break-word;\n}\n\n/* NAVIGATION */\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__navigation {\n  display: none;\n  justify-content: center;\n  align-items: center;\n  gap: 6px;\n  padding-top: 9px;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__dot {\n  display: block;\n  width: 6px;\n  height: 6px;\n  min-width: 0;\n  min-height: 0;\n  padding: 0;\n  border: 0;\n  border-radius: 10px;\n  background: #DECAC9;\n  cursor: pointer;\n  transition:\n    width .3s ease,\n    background .3s ease;\n}\n\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__dot.is-active {\n  width: 20px;\n  background: var(--ry-wine);\n}\n\n#ry-usp-{{ ry_usp_uid }} button:focus-visible,\n#ry-usp-{{ ry_usp_uid }} .ry-usp-v6__viewport:focus-visible {\n  outline: 2px solid var(--ry-wine);\n  outline-offset: 2px;\n}\n\n/* MOBILE: TWO CARDS PER PAGE */\n@media screen and (max-width: 749px) {\n  #ry-usp-{{ ry_usp_uid }} {\n    padding: 8px;\n    margin: 8px 0;\n    border-radius: 9px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__header {\n    margin-bottom: 8px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__heading {\n    font-size: 9.5px;\n    letter-spacing: .65px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__header-tag {\n    font-size: 8px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__track {\n    gap: 6px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__item {\n    flex: 0 0 calc((100% - 6px) / 2);\n    min-height: 57px;\n    padding: 7px;\n    gap: 7px;\n    border-radius: 7px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon {\n    flex-basis: 31px;\n    width: 31px;\n    height: 31px;\n    border-radius: 6px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon svg {\n    width: 19px;\n    height: 19px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text {\n    gap: 2px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text strong {\n    font-size: 10px;\n    line-height: 1.25;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text small {\n    font-size: 8.5px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__navigation {\n    display: flex;\n  }\n}\n\n/* SMALL MOBILE */\n@media screen and (max-width: 370px) {\n  #ry-usp-{{ ry_usp_uid }} {\n    padding: 6px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__item {\n    padding: 6px 5px;\n    gap: 5px;\n    min-height: 54px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon {\n    flex-basis: 27px;\n    width: 27px;\n    height: 27px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__icon svg {\n    width: 17px;\n    height: 17px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text strong {\n    font-size: 9px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__text small {\n    font-size: 8px;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__header-tag {\n    font-size: 7px;\n  }\n}\n\n/* REDUCED MOTION */\n@media (prefers-reduced-motion: reduce) {\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__viewport {\n    scroll-behavior: auto;\n  }\n\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__item,\n  #ry-usp-{{ ry_usp_uid }} .ry-usp-v6__dot {\n    transition: none;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const rootId = 'ry-usp-{{ ry_usp_uid }}';\n\n  function initRiyanUSP() {\n    const root = document.getElementById(rootId);\n\n    if (!root || root.dataset.ryUspReady === 'true') return;\n\n    const viewport = root.querySelector('.ry-usp-v6__viewport');\n    const items = Array.from(root.querySelectorAll('.ry-usp-v6__item'));\n    const dots = Array.from(root.querySelectorAll('.ry-usp-v6__dot'));\n\n    if (!viewport || items.length < 2) return;\n\n    root.dataset.ryUspReady = 'true';\n\n    const mobileQuery = window.matchMedia('(max-width: 749px)');\n    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n\n    let autoplay = null;\n    let resumeTimer = null;\n    let scrollTimer = null;\n\n    const pageCount = Math.ceil(items.length / 2);\n\n    function getPosition(page) {\n      const target = items[page * 2];\n\n      if (!target) return 0;\n\n      const first = items[0].getBoundingClientRect();\n      const rect = target.getBoundingClientRect();\n\n      return viewport.scrollLeft + rect.left - first.left;\n    }\n\n    function currentPage() {\n      if (!mobileQuery.matches) return 0;\n\n      let closest = 0;\n      let distance = Infinity;\n\n      for (let i = 0; i < pageCount; i++) {\n        const gap = Math.abs(viewport.scrollLeft - getPosition(i));\n\n        if (gap < distance) {\n          distance = gap;\n          closest = i;\n        }\n      }\n\n      return closest;\n    }\n\n    function updateDots(page = currentPage()) {\n      dots.forEach((dot, index) => {\n        const active = page === index;\n        dot.classList.toggle('is-active', active);\n        dot.setAttribute('aria-current', String(active));\n      });\n    }\n\n    function goTo(page) {\n      if (!mobileQuery.matches) return;\n\n      const safePage = Math.max(0, Math.min(pageCount - 1, page));\n\n      viewport.scrollTo({\n        left: getPosition(safePage),\n        behavior: motionQuery.matches ? 'auto' : 'smooth'\n      });\n\n      updateDots(safePage);\n    }\n\n    function stopAutoplay() {\n      if (autoplay) {\n        clearInterval(autoplay);\n        autoplay = null;\n      }\n    }\n\n    function startAutoplay() {\n      stopAutoplay();\n\n      if (\n        !mobileQuery.matches ||\n        motionQuery.matches ||\n        document.hidden ||\n        root.matches(':hover') ||\n        root.contains(document.activeElement)\n      ) return;\n\n      autoplay = setInterval(function () {\n        const next = (currentPage() + 1) % pageCount;\n        goTo(next);\n      }, 3800);\n    }\n\n    function resumeLater() {\n      clearTimeout(resumeTimer);\n      resumeTimer = setTimeout(startAutoplay, 5000);\n    }\n\n    dots.forEach(function (dot, index) {\n      dot.addEventListener('click', function () {\n        stopAutoplay();\n        goTo(index);\n        resumeLater();\n      });\n    });\n\n    viewport.addEventListener('scroll', function () {\n      clearTimeout(scrollTimer);\n      scrollTimer = setTimeout(function () {\n        updateDots();\n      }, 90);\n    }, { passive: true });\n\n    viewport.addEventListener('touchstart', function () {\n      stopAutoplay();\n      clearTimeout(resumeTimer);\n    }, { passive: true });\n\n    viewport.addEventListener('touchend', resumeLater, {\n      passive: true\n    });\n\n    root.addEventListener('mouseenter', stopAutoplay);\n    root.addEventListener('mouseleave', startAutoplay);\n\n    root.addEventListener('focusin', stopAutoplay);\n    root.addEventListener('focusout', function () {\n      setTimeout(startAutoplay, 0);\n    });\n\n    document.addEventListener('visibilitychange', startAutoplay);\n\n    window.addEventListener('resize', function () {\n      if (!mobileQuery.matches) {\n        viewport.scrollLeft = 0;\n      }\n\n      updateDots();\n      startAutoplay();\n    });\n\n    startAutoplay();\n  }\n\n  initRiyanUSP();\n\n  document.addEventListener('shopify:section:load', initRiyanUSP);\n})();\n</script>"
          }
