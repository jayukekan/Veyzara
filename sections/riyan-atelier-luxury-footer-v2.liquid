</style>

{% schema %}
{
  "name": "Riyan Premium Footer V6",
  "tag": "section",
  "class": "section-riyan-premium-footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Brand identity"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 100,
      "max": 300,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "RIYAN CREATION"
    },
    {
      "type": "text",
      "id": "brand_eyebrow",
      "label": "Small brand eyebrow",
      "default": "THE ART OF DRESSING BEAUTIFULLY"
    },
    {
