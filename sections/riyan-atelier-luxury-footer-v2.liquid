{% liquid
  assign fid = 'riyan-footer-' | append: section.id
%}
<footer id="{{ fid }}" class="rf-footer" style="
  --rf-bg:{{ section.settings.bg }};
  --rf-surface:{{ section.settings.surface }};
  --rf-text:{{ section.settings.ink }};
  --rf-muted:{{ section.settings.muted }};
  --rf-accent:{{ section.settings.accent }};
  --rf-line:{{ section.settings.line }};
  --rf-button-bg:{{ section.settings.button_bg }};
  --rf-button-text:{{ section.settings.button_text }};
  --rf-input-bg:{{ section.settings.input_bg }};
  --rf-service-bg:{{ section.settings.service_bg }};
  --rf-width:{{ section.settings.max_width }}px;
  --rf-top:{{ section.settings.padding_top }}px;
  --rf-bottom:{{ section.settings.padding_bottom }}px;
  --rf-mobile-top:{{ section.settings.mobile_padding_top }}px;
  --rf-gap:{{ section.settings.column_spacing }}px;
  --rf-brand-size:{{ section.settings.brand_font_size }}px;
  --rf-news-size:{{ section.settings.newsletter_font_size }}px;
  --rf-body-size:{{ section.settings.body_font_size }}px;
  --rf-heading-size:{{ section.settings.menu_heading_size }}px;
  --rf-menu-link-size:{{ section.settings.menu_link_size }}px;
  --rf-mobile-menu-size:{{ section.settings.mobile_menu_link_size }}px;
  --rf-mobile-heading-size:{{ section.settings.mobile_menu_heading_size }}px;
  --rf-news-title-color:{{ section.settings.newsletter_heading_color }};
  --rf-logo-width:{{ section.settings.logo_width }}px;
  --rf-font-heading:{% if section.settings.heading_font_style == 'serif' %}Georgia, 'Times New Roman', serif{% elsif section.settings.heading_font_style == 'sans' %}Arial, Helvetica, sans-serif{% else %}var(--font-heading-family, Georgia, serif){% endif %};
">
  {% if section.settings.show_service_strip %}
    <div class="rf-services">
      <div class="rf-wrap rf-services-grid">
        <div class="rf-service"><svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 10h17v13H3zM20 14h5l4 5v4h-9z"/><circle cx="9" cy="24" r="2.5"/><circle cx="24" cy="24" r="2.5"/></svg><span>{{ section.settings.service_one | escape }}</span></div>
        <div class="rf-service"><svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3 27 8v8c0 8-5 11-11 14C10 27 5 24 5 16V8L16 3Z"/><path d="m11 16 4 4 7-8"/></svg><span>{{ section.settings.service_two | escape }}</span></div>
        <div class="rf-service"><svg viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 29 4 17C-2 9 9 2 16 11 23 2 34 9 28 17L16 29Z"/></svg><span>{{ section.settings.service_three | escape }}</span></div>
      </div>
    </div>
  {% endif %}
  <div class="rf-wrap">
    <div class="rf-top">
      <div class="rf-brand">
        {% if section.settings.brand_eyebrow != blank %}<span class="rf-eyebrow">{{ section.settings.brand_eyebrow | escape }}</span>{% endif %}
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'rf-logo', widths: '180,300,450,600', loading: 'lazy', alt: section.settings.brand_name }}
        {% else %}
          <div class="rf-wordmark">{{ section.settings.brand_name | default: shop.name | escape }}</div>
        {% endif %}
        {% if section.settings.tagline != blank %}<p class="rf-tagline">{{ section.settings.tagline | escape }}</p>{% endif %}
        {% if section.settings.brand_description != blank %}<p class="rf-description">{{ section.settings.brand_description | escape }}</p>{% endif %}
        {% if section.settings.instagram != blank or section.settings.facebook != blank or section.settings.pinterest != blank or section.settings.youtube != blank %}
          <div class="rf-social">
            {% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram <span aria-hidden="true">↗</span></a>{% endif %}
            {% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook <span aria-hidden="true">↗</span></a>{% endif %}
            {% if section.settings.pinterest != blank %}<a href="{{ section.settings.pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">Pinterest <span aria-hidden="true">↗</span></a>{% endif %}
            {% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">YouTube <span aria-hidden="true">↗</span></a>{% endif %}
          </div>
        {% endif %}
      </div>
      {% if section.settings.show_newsletter %}
        <div class="rf-newsletter">
          {% if section.settings.newsletter_eyebrow != blank %}<span class="rf-eyebrow">{{ section.settings.newsletter_eyebrow | escape }}</span>{% endif %}
          <h2 class="rf-newsletter-title">{{ section.settings.newsletter_title | escape }}</h2>
          {% if section.settings.newsletter_description != blank %}<p class="rf-news-description">{{ section.settings.newsletter_description | escape }}</p>{% endif %}
          {% form 'customer', class: 'rf-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="rf-visually-hidden" for="rf-email-{{ section.id }}">Email address</label>
            <div class="rf-field">
              <input id="rf-email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ section.settings.email_placeholder | escape }}" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="254" value="{{ form.email | escape }}" required aria-required="true" {% if form.errors %}aria-invalid="true" aria-describedby="rf-email-error-{{ section.id }}"{% endif %}>
              <button type="submit" aria-label="{{ section.settings.newsletter_button | escape }}"><span>{{ section.settings.newsletter_button | escape }}</span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h16m-7-7 7 7-7 7"/></svg></button>
            </div>
            {% if form.posted_successfully? %}<p class="rf-form-message rf-form-success" role="status">Thank you for subscribing. You are on the list.</p>{% endif %}
            {% if form.errors %}<div id="rf-email-error-{{ section.id }}" class="rf-form-message rf-form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          {% endform %}
          {% if section.settings.newsletter_note != blank %}<p class="rf-news-note">{{ section.settings.newsletter_note | escape }}</p>{% endif %}
        </div>
      {% endif %}
    </div>
    <div class="rf-rule"><span aria-hidden="true">✦</span></div>
    <div class="rf-navigation">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div class="rf-nav-col" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              {% if block.settings.menu != blank %}
                <ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
              {% elsif request.design_mode %}<p class="rf-empty">Choose a navigation menu in the theme editor.</p>{% endif %}
            </div>
          {% when 'contact' %}
            <div class="rf-nav-col rf-contact" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              {% if block.settings.intro != blank %}<p>{{ block.settings.intro | escape }}</p>{% endif %}
              {% if block.settings.email != blank %}<a href="mailto:{{ block.settings.email | strip | escape }}">{{ block.settings.email | escape }}</a>{% endif %}
              {% if block.settings.phone != blank %}{% assign phone_link = block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}<a href="tel:{{ phone_link | escape }}">{{ block.settings.phone | escape }}</a>{% endif %}
              {% if block.settings.whatsapp != blank %}{% assign wa = block.settings.whatsapp | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' %}<a href="https://wa.me/{{ wa | escape }}" target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗</a>{% endif %}
            </div>
        {% endcase %}
      {% endfor %}
      {% if section.settings.show_editorial_note %}
        <div class="rf-nav-col rf-editorial">
          <span class="rf-eyebrow">{{ section.settings.editorial_eyebrow | escape }}</span>
          <p>{{ section.settings.editorial_quote | escape | newline_to_br }}</p>
          <span class="rf-editorial-sign">{{ section.settings.brand_name | escape }} <span aria-hidden="true">✦</span></span>
        </div>
      {% endif %}
    </div>
    {% if section.settings.show_big_brand %}<div class="rf-bigbrand" aria-hidden="true">{{ section.settings.brand_name | default: shop.name | escape }}</div>{% endif %}
    <div class="rf-bottom">
      <div class="rf-copyright">© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name | escape }}. All rights reserved.</div>
      {% if section.settings.show_policies %}<nav class="rf-legal" aria-label="Footer policies">{% for policy in shop.policies %}{% if policy.url != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>{% endif %}
      {% if section.settings.show_payments and shop.enabled_payment_types.size > 0 %}<div class="rf-payments" aria-label="Accepted payment methods">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'rf-payment-icon' }}{% endfor %}</div>{% endif %}
    </div>
    {% if section.settings.show_developer_credit %}
      <div class="rf-credit" aria-label="Website design and development credit">
        <span class="rf-credit-rule" aria-hidden="true"></span>
        <span class="rf-credit-content">
          <span class="rf-credit-label">{{ section.settings.developer_credit_label | escape }}</span>
          <a class="rf-credit-link" href="{{ section.settings.developer_credit_url | default: 'https://blueslag.com/' | escape }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.developer_credit_name | escape }}
            <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15 15 5M7 5h8v8"/></svg>
          </a>
        </span>
        <span class="rf-credit-rule" aria-hidden="true"></span>
      </div>
    {% endif %}
  </div>
</footer>
