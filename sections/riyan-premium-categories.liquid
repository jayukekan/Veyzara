{% liquid
  assign sid = 'riyan-cat-' | append: section.id
%}
<section id="{{ sid }}" class="riyan-cat" style="
  --rc-bg: {{ section.settings.section_bg }};
  --rc-card: {{ section.settings.card_bg }};
  --rc-heading: {{ section.settings.heading_color }};
  --rc-text: {{ section.settings.text_color }};
  --rc-accent: {{ section.settings.accent_color }};
  --rc-border: {{ section.settings.border_color }};
  --rc-ratio: {{ section.settings.image_ratio }};
  --rc-radius: {{ section.settings.card_radius }}px;
  --rc-cols: {{ section.settings.desktop_columns }};
  --rc-gap: {{ section.settings.desktop_gap }}px;
  --rc-mobile-gap: {{ section.settings.mobile_gap }}px;
  --rc-page-width: {{ section.settings.page_width }}px;
  --rc-top: {{ section.settings.padding_top }}px;
  --rc-bottom: {{ section.settings.padding_bottom }}px;
  --rc-mobile-top: {{ section.settings.mobile_padding_top }}px;
  --rc-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
">
  <div class="riyan-cat__container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="riyan-cat__header">
        <div class="riyan-cat__heading-group">
          {% if section.settings.eyebrow != blank %}
            <p class="riyan-cat__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}<span></span></p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="riyan-cat__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="riyan-cat__description">{{ section.settings.subheading | escape }}</p>
          {% endif %}
        </div>
        {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
          <a href="{{ section.settings.view_all_link }}" class="riyan-cat__all riyan-cat__all--desktop">
            {{ section.settings.view_all_label | escape }} <span aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </header>
    {% endif %}

    <div class="riyan-cat__grid {% if section.settings.mobile_layout == 'slider' %}riyan-cat__grid--slider{% endif %}">
      {% for block in section.blocks %}
        {% liquid
          assign cat_title = block.settings.title
          assign cat_image = block.settings.image
          assign cat_url = block.settings.link
          if block.settings.collection != blank
            if cat_title == blank
              assign cat_title = block.settings.collection.title
            endif
            if cat_image == blank
              assign cat_image = block.settings.collection.featured_image
            endif
            if cat_url == blank
              assign cat_url = block.settings.collection.url
            endif
          endif
          if cat_title == blank
            assign cat_title = 'Explore collection'
          endif
        %}
        <article class="riyan-cat__item" {{ block.shopify_attributes }}>
          {% if cat_url != blank %}
            <a class="riyan-cat__card" href="{{ cat_url }}" aria-label="Shop {{ cat_title | escape }}">
          {% else %}
            <div class="riyan-cat__card">
          {% endif %}
              <div class="riyan-cat__photo">
                {% if cat_image != blank %}
                  {% liquid
                    assign img_loading = 'lazy'
                    if forloop.index <= 2
                      assign img_loading = 'eager'
                    endif
                  %}
                  {{ cat_image | image_url: width: 1200 | image_tag: class: 'riyan-cat__image', loading: img_loading, widths: '180, 240, 320, 420, 540, 720, 900, 1200', sizes: '(max-width: 749px) 46vw, (max-width: 989px) 31vw, 24vw', alt: cat_title }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'riyan-cat__placeholder' }}
                {% endif %}
                {% if block.settings.show_overlay %}<div class="riyan-cat__gradient"></div>{% endif %}
                {% if block.settings.badge != blank %}
                  <span class="riyan-cat__badge">{{ block.settings.badge | escape }}</span>
                {% endif %}
                <span class="riyan-cat__image-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span>
              </div>
              <div class="riyan-cat__details">
                <div class="riyan-cat__details-inner">
                  {% if section.settings.show_icon %}
                    <span class="riyan-cat__emblem" aria-hidden="true">
                      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
                        {% case block.settings.category_icon %}
                          {% when 'hanger' %}<path d="M13 10a3 3 0 1 1 4 2.83V16l11 8H4l12-8"/>
                          {% when 'crown' %}<path d="M4 11l6 6 6-9 6 9 6-6-3 14H7L4 11Z"/><path d="M9 28h14"/>
                          {% when 'heart' %}<path d="M16 26S5 19.3 5 12.5a6.5 6.5 0 0 1 11-4.3 6.5 6.5 0 0 1 11 4.3C27 19.3 16 26 16 26Z"/>
                          {% when 'sparkle' %}<path d="M16 3l2.9 10.1L29 16l-10.1 2.9L16 29l-2.9-10.1L3 16l10.1-2.9L16 3Z"/>
                          {% when 'bow' %}<path d="M16 14C9 7 3 9 3 14s6 7 13 2c7 5 13 3 13-2s-6-7-13 0Z"/><circle cx="16" cy="15" r="2.5"/><path d="M14 18l-4 10M18 18l4 10"/>
                          {% when 'leaf' %}<path d="M25 5C12 5 7 12 8 20c8 2 16-4 17-15Z"/><path d="M6 27c4-8 9-12 16-16"/>
                          {% else %}<path d="M16 27c-2-5-2-9 0-14 2 5 2 9 0 14ZM16 17C10 10 9 6 16 3c7 3 6 7 0 14ZM15 22C7 22 3 19 3 14c7-1 11 2 12 8ZM17 22c8 0 12-3 12-8-7-1-11 2-12 8Z"/>
                        {% endcase %}
                      </svg>
                    </span>
                  {% endif %}
                  <h3 class="riyan-cat__name">{{ cat_title | escape }}</h3>
                  {% if block.settings.subtitle != blank %}
                    <p class="riyan-cat__subtitle">{{ block.settings.subtitle | escape }}</p>
                  {% endif %}
                  {% if section.settings.show_shop_link %}
                    <span class="riyan-cat__explore">{{ section.settings.shop_text | escape }} <span aria-hidden="true">→</span></span>
                  {% endif %}
                </div>
              </div>
          {% if cat_url != blank %}</a>{% else %}</div>{% endif %}
        </article>
      {% endfor %}
    </div>

    {% if section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <div class="riyan-cat__mobile-all">
        <a href="{{ section.settings.view_all_link }}" class="riyan-cat__all">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">↗</span></a>
      </div>
    {% endif %}
  </div>
</section>

