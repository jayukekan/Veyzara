  #{{ sid }} *,#{{ sid }} *::before,#{{ sid }} *::after{box-sizing:border-box}
  #{{ sid }} .riyan-cat__container{width:min(calc(100% - 64px),var(--rc-page-width));margin-inline:auto;position:relative;z-index:1}
