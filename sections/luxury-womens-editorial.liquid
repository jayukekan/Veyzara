{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.product_limit
%}
<section id="fashion-edit-{{ section.id }}" class="fe-section fe-luxe" style="--fe-bg:{{ section.settings.bg }};--fe-ink:{{ section.settings.ink }};--fe-muted:{{ section.settings.muted }};--fe-accent:{{ section.settings.accent }};--fe-tile:{{ section.settings.tile }};--fe-gap:{{ section.settings.gap }}px;--fe-radius:{{ section.settings.radius }}px;--fe-width:{{ section.settings.page_width }}px;--fe-top:{{ section.settings.padding_top }}px;--fe-bottom:{{ section.settings.padding_bottom }}px;--fe-mtop:{{ section.settings.mobile_padding_top }}px;--fe-mbottom:{{ section.settings.mobile_padding_bottom }}px;">
  {% comment %}Decorative images are behind all section content and never capture clicks.{% endcomment %}
  {% if section.blocks.size > 0 %}
    <div class="fe-background-art" aria-hidden="true">
      {% for block in section.blocks %}
        {% if block.type == 'background_element' and block.settings.image != blank %}
          <div class="fe-background-art__item{% unless block.settings.show_mobile %} fe-background-art__item--hide-mobile{% endunless %}"
            style="--art-x:{{ block.settings.x }}%;--art-y:{{ block.settings.y }}%;--art-width:{{ block.settings.width }}px;--art-rotate:{{ block.settings.rotation }}deg;--art-opacity:{{ block.settings.opacity | divided_by: 100.0 }};--art-mobile-x:{{ block.settings.mobile_x }}%;--art-mobile-y:{{ block.settings.mobile_y }}%;--art-mobile-width:{{ block.settings.mobile_width }}px;--art-mobile-rotate:{{ block.settings.mobile_rotation }}deg;--art-mobile-opacity:{{ block.settings.mobile_opacity | divided_by: 100.0 }};"
            {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'fe-background-art__image', alt: '', widths: '200, 400, 600, 800, 1000, 1200' }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
  <div class="fe-container">
    <div class="fe-edition-strip"><span>{{ section.settings.topline | escape }}</span><span class="fe-edition-line"></span><span>{{ section.settings.edition | escape }}</span></div>
    <header class="fe-heading-row">
      <div class="fe-heading-copy">
        <span class="fe-heading-icon" aria-hidden="true">✳</span>
        {% if section.settings.eyebrow != blank %}<div class="fe-kicker"><span class="fe-kicker-rule"></span>{{ section.settings.eyebrow | escape }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="fe-heading">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="fe-description">{{ section.settings.description }}</div>{% endif %}
      </div>
      {% if section.settings.show_view_all and featured_collection != blank %}
        <a href="{{ featured_collection.url }}" class="fe-view fe-view-top">{{ section.settings.view_all_text | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>
      {% endif %}
    <div class="fe-header-number" aria-hidden="true">0{{ section.settings.section_number }}</div>
    </header>

    <div class="fe-products-wrap">
      <div class="fe-products {% if section.settings.desktop_slider %}fe-products--slider{% endif %}" data-fe-track>
        {% if featured_collection != blank and featured_collection.products_count > 0 %}
          {% for product in featured_collection.products limit: product_limit %}
            {% liquid
              assign chosen_variant = product.selected_or_first_available_variant
              assign is_sale = false
              if chosen_variant.compare_at_price > chosen_variant.price
                assign is_sale = true
                assign discount_amount = chosen_variant.compare_at_price | minus: chosen_variant.price
                assign discount_percent = discount_amount | times: 100.0 | divided_by: chosen_variant.compare_at_price | round
              endif
              assign second_image = product.images[1]
              assign product_card_url = product.url | within: featured_collection
            %}
            <article class="fe-card card-wrapper product-card-wrapper" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle | escape }}" style="--fe-order:{{ forloop.index0 }};">
              <div class="fe-card-index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</div>
              {% comment %}
                  GroPulse Wishlist scans product media containers configured in its app.
                  Keep card--media on THIS element and a real product URL/ID on the card.
                  The app owns the heart/button and persisted wishlist state; do not
                  create an independent heart button (that would duplicate it).
                {% endcomment %}
              <div class="fe-media{% if section.settings.enable_gp_wishlist %} card--media{% endif %}" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle | escape }}">
                <span class="fe-image-corner" aria-hidden="true"></span>
                <a class="fe-media-link" href="{{ product_card_url }}" aria-label="View {{ product.title | escape }}">
                  {% if product.featured_image != blank %}
                    {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'fe-photo fe-photo-primary', loading: 'lazy', widths: '180, 300, 420, 600, 800, 1000', sizes: '(min-width: 990px) 24vw, (min-width: 600px) 45vw, 47vw', alt: product.featured_image.alt | default: product.title }}
                    {% if section.settings.image_hover and second_image != blank %}
                      {{ second_image | image_url: width: 1000 | image_tag: class: 'fe-photo fe-photo-secondary', loading: 'lazy', widths: '180, 300, 420, 600, 800, 1000', sizes: '(min-width: 990px) 24vw, (min-width: 600px) 45vw, 47vw', alt: second_image.alt | default: product.title }}
                    {% endif %}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'fe-placeholder' }}
                  {% endif %}
                </a>
                <div class="fe-badges">
                  {% if section.settings.show_sale and is_sale %}<span class="fe-badge fe-badge-sale">{{ discount_percent }}% OFF</span>{% endif %}
                  {% if section.settings.show_sold_out and product.available == false %}<span class="fe-badge">Sold out</span>{% endif %}
                  {% if section.settings.show_new and product.tags contains 'New' %}<span class="fe-badge">New</span>{% endif %}
                </div>
                {% if section.settings.show_quick_view %}<a href="{{ product_card_url }}" class="fe-quick" aria-label="View details for {{ product.title | escape }}"><span>Discover piece</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>{% endif %}
              </div>
              <div class="fe-details">
                <div class="fe-card-meta"><span>{{ section.settings.meta_text | escape }}</span><span class="fe-meta-spark" aria-hidden="true">✦</span></div>
                {% if section.settings.show_vendor and product.vendor != blank %}<span class="fe-vendor">{{ product.vendor | escape }}</span>{% endif %}
                <a class="fe-name" href="{{ product_card_url }}" title="{{ product.title | escape }}">{{ product.title | escape }}</a>
                <div class="fe-price-line">
                  
                  <span class="fe-price">{{ chosen_variant.price | money }}</span>
                  {% if section.settings.show_compare and is_sale %}<s class="fe-compare">{{ chosen_variant.compare_at_price | money }}</s>{% endif %}
                </div>
                {% if section.settings.show_swatches %}
                  {% assign color_option_index = -1 %}
                  {% for option in product.options_with_values %}
                    {% assign low_name = option.name | downcase %}
                    {% if low_name == 'color' or low_name == 'colour' %}{% assign color_option_index = forloop.index0 %}{% endif %}
                  {% endfor %}
                  {% if color_option_index >= 0 %}
                    <div class="fe-swatches" aria-label="Available colours">
                      {% assign seen_colours = '|' %}
                      {% assign swatch_count = 0 %}
                      {% for variant in product.variants %}
                        {% assign colour_value = variant.options[color_option_index] %}
                        {% assign colour_token = colour_value | handleize | prepend: '|' | append: '|' %}
                        {% unless seen_colours contains colour_token %}
                          {% assign seen_colours = seen_colours | append: colour_token %}
                          {% assign swatch_count = swatch_count | plus: 1 %}
                          <span class="fe-swatch" title="{{ colour_value | escape }}" aria-label="{{ colour_value | escape }}" style="--fe-swatch:{{ colour_value | escape }}"></span>
                        {% endunless %}
                        {% if swatch_count >= section.settings.max_swatches %}{% break %}{% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endif %}
              </div>
            </article>
          {% endfor %}
        {% else %}
          {% for i in (1..4) %}
            <article class="fe-card" style="--fe-order:{{ forloop.index0 }}">
              <div class="fe-media">{{ 'product-1' | placeholder_svg_tag: 'fe-placeholder' }}</div>
              <div class="fe-details"><span class="fe-vendor">THE COLLECTION</span><span class="fe-name">Your signature style</span><div class="fe-price-line"><span class="fe-price">{{ 299900 | money }}</span></div></div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
      {% if section.settings.desktop_slider %}
        <div class="fe-controls" aria-label="Collection navigation">
          <button type="button" data-fe-prev class="fe-arrow" aria-label="Previous products"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
          <button type="button" data-fe-next class="fe-arrow" aria-label="Next products"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
        </div>
      {% endif %}
    </div>
    <div class="fe-footer-rule"><span>✧</span> {{ section.settings.footer_note | escape }} <span>✧</span></div>
    {% if section.settings.show_view_all and featured_collection != blank %}<div class="fe-view-mobile"><a href="{{ featured_collection.url }}" class="fe-view">{{ section.settings.view_all_text | escape }} <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></div>{% endif %}
  </div>
</section>
<style>
#fashion-edit-{{ section.id }}{background:var(--fe-bg);color:var(--fe-ink);padding:var(--fe-top) 0 var(--fe-bottom);overflow:hidden;font-family:inherit}
#fashion-edit-{{ section.id }} *{box-sizing:border-box}
#fashion-edit-{{ section.id }}{position:relative;isolation:isolate}
#fashion-edit-{{ section.id }} .fe-background-art{position:absolute;inset:0;z-index:0;pointer-events:none;overflow:hidden}
#fashion-edit-{{ section.id }} .fe-background-art__item{position:absolute;left:var(--art-x);top:var(--art-y);width:var(--art-width);max-width:none;opacity:var(--art-opacity);transform:translate(-50%,-50%) rotate(var(--art-rotate));transform-origin:center;pointer-events:none}
#fashion-edit-{{ section.id }} .fe-background-art__image{display:block;width:100%;height:auto;object-fit:contain}
#fashion-edit-{{ section.id }} .fe-container{position:relative;z-index:1}
@media(max-width:749px){#fashion-edit-{{ section.id }} .fe-background-art__item{left:var(--art-mobile-x);top:var(--art-mobile-y);width:var(--art-mobile-width);opacity:var(--art-mobile-opacity);transform:translate(-50%,-50%) rotate(var(--art-mobile-rotate))}#fashion-edit-{{ section.id }} .fe-background-art__item--hide-mobile{display:none}}

#fashion-edit-{{ section.id }} a{color:inherit;text-decoration:none}
#fashion-edit-{{ section.id }} .fe-container{max-width:var(--fe-width);padding:0 30px;margin:auto}
#fashion-edit-{{ section.id }} .fe-edition-strip{display:flex;align-items:center;gap:16px;color:var(--fe-accent);font-size:12px;font-weight:600;letter-spacing:.24em;margin:0 0 31px;text-transform:uppercase}
#fashion-edit-{{ section.id }} .fe-edition-strip span:last-child{color:var(--fe-muted);letter-spacing:.14em}
#fashion-edit-{{ section.id }} .fe-edition-line{flex:1;height:1px;background:linear-gradient(90deg,var(--fe-accent),rgba(89,28,39,.08))}
#fashion-edit-{{ section.id }} .fe-heading-row{position:relative;display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:30px;padding-bottom:22px;border-bottom:1px solid rgba(89,28,39,.16)}
#fashion-edit-{{ section.id }} .fe-heading-copy{position:relative;padding-left:35px}
#fashion-edit-{{ section.id }} .fe-heading-icon{position:absolute;top:-4px;left:0;color:var(--fe-accent);font-size:22px;line-height:1}
#fashion-edit-{{ section.id }} .fe-kicker{display:flex;align-items:center;gap:10px;margin:0 0 10px;color:var(--fe-accent);font-size:10px;line-height:1.2;font-weight:600;letter-spacing:.23em;text-transform:uppercase}
#fashion-edit-{{ section.id }} .fe-kicker-rule{width:18px;height:1px;background:currentColor;display:block}
#fashion-edit-{{ section.id }} .fe-heading{margin:0;color:var(--fe-ink);font-family:Georgia,'Times New Roman',serif;font-size:{{ section.settings.heading_size }}px;font-weight:400;line-height:1.03;letter-spacing:-.055em}
#fashion-edit-{{ section.id }} .fe-description{max-width:540px;margin-top:12px;color:var(--fe-muted);font-size:13px;line-height:1.65;letter-spacing:.01em}
#fashion-edit-{{ section.id }} .fe-description p{margin:0}
#fashion-edit-{{ section.id }} .fe-header-number{position:absolute;right:0;top:-12px;font:italic 56px Georgia,serif;color:rgba(89,28,39,.09);pointer-events:none;z-index:0}
#fashion-edit-{{ section.id }} .fe-view{display:inline-flex;align-items:center;justify-content:center;gap:15px;padding:13px 18px;border:1px solid rgba(89,28,39,.35);background:transparent;color:var(--fe-accent);font-size:10px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;white-space:nowrap;transition:background .3s,color .3s,transform .3s;position:relative;z-index:1}
#fashion-edit-{{ section.id }} .fe-view:hover{color:#fff;background:var(--fe-accent);transform:translateY(-2px)}
#fashion-edit-{{ section.id }} svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
#fashion-edit-{{ section.id }} .fe-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--fe-gap)}
#fashion-edit-{{ section.id }} .fe-card{position:relative;min-width:0;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
@media(hover:hover){#fashion-edit-{{ section.id }} .fe-card:hover{transform:translateY(-5px)}}
#fashion-edit-{{ section.id }} .fe-card-index{color:var(--fe-accent);font:italic 14px Georgia,serif;padding:0 0 9px 1px;opacity:.75}
#fashion-edit-{{ section.id }} .fe-media{position:relative;aspect-ratio:{{ section.settings.image_ratio }};overflow:hidden;isolation:isolate;background:var(--fe-tile);border-radius:var(--fe-radius)}
#fashion-edit-{{ section.id }} .fe-media:after{content:"";position:absolute;inset:0;border:1px solid rgba(89,28,39,.07);pointer-events:none;z-index:4}
#fashion-edit-{{ section.id }} .fe-image-corner{position:absolute;right:12px;bottom:12px;width:21px;height:21px;border-top:1px solid rgba(255,255,255,.9);border-right:1px solid rgba(255,255,255,.9);z-index:3;pointer-events:none}
#fashion-edit-{{ section.id }} .fe-media-link{display:block;width:100%;height:100%;overflow:hidden}
#fashion-edit-{{ section.id }} .fe-photo,#fashion-edit-{{ section.id }} .fe-placeholder{display:block;width:100%;height:100%;object-fit:{{ section.settings.image_fit }};object-position:center top;transition:transform .9s cubic-bezier(.2,.7,.12,1),opacity .5s ease}
#fashion-edit-{{ section.id }} .fe-photo-secondary{position:absolute;inset:0;opacity:0}
@media(hover:hover){#fashion-edit-{{ section.id }} .fe-card:hover .fe-photo-primary{transform:scale(1.055)}#fashion-edit-{{ section.id }} .fe-card:hover .fe-photo-secondary{transform:scale(1.055);opacity:1}}
#fashion-edit-{{ section.id }} .fe-badges{position:absolute;top:13px;left:13px;display:flex;flex-direction:column;align-items:start;gap:5px;pointer-events:none;z-index:3}
#fashion-edit-{{ section.id }} .fe-badge{padding:7px 10px;background:#fffcf8;color:var(--fe-accent);font-size:9px;line-height:1;font-weight:650;letter-spacing:.13em;text-transform:uppercase;box-shadow:0 2px 12px rgba(0,0,0,.03)}
#fashion-edit-{{ section.id }} .fe-badge-sale{background:var(--fe-accent);color:#fff}
#fashion-edit-{{ section.id }} .fe-quick{position:absolute;z-index:4;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:16px 19px;background:rgba(255,252,248,.97);color:var(--fe-accent)!important;font-size:10px;font-weight:650;letter-spacing:.18em;text-transform:uppercase;transform:translateY(102%);transition:transform .4s cubic-bezier(.2,.8,.2,1)}
#fashion-edit-{{ section.id }} .fe-quick svg{transition:transform .25s}
#fashion-edit-{{ section.id }} .fe-quick:hover svg{transform:translateX(5px)}
@media(hover:hover){#fashion-edit-{{ section.id }} .fe-card:hover .fe-quick{transform:translateY(0)}}
#fashion-edit-{{ section.id }} .fe-quick:focus-visible{transform:translateY(0);outline:2px solid var(--fe-accent);outline-offset:-3px}
#fashion-edit-{{ section.id }} .fe-details{padding:13px 1px 0}
#fashion-edit-{{ section.id }} .fe-card-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px;color:var(--fe-accent);font-size:9px;font-weight:550;letter-spacing:.18em;text-transform:uppercase}
#fashion-edit-{{ section.id }} .fe-meta-spark{font-size:12px;opacity:.55}
#fashion-edit-{{ section.id }} .fe-vendor{display:block;color:var(--fe-muted);font-size:9px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:5px}
#fashion-edit-{{ section.id }} .fe-name{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--fe-ink);font-family:Georgia,'Times New Roman',serif;font-size:clamp(15px,1.45vw,19px);font-weight:400;line-height:1.35;letter-spacing:-.025em;transition:color .25s}
#fashion-edit-{{ section.id }} .fe-name:hover{color:var(--fe-accent)}
#fashion-edit-{{ section.id }} .fe-price-line{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;margin-top:7px}
#fashion-edit-{{ section.id }} .fe-price{font-size:13px;font-weight:650;letter-spacing:.005em}
#fashion-edit-{{ section.id }} .fe-from{font-size:11px;color:var(--fe-muted)}
#fashion-edit-{{ section.id }} .fe-compare{font-size:12px;color:var(--fe-muted);opacity:.8}
#fashion-edit-{{ section.id }} .fe-swatches{display:flex;gap:9px;align-items:center;margin-top:12px}
#fashion-edit-{{ section.id }} .fe-swatch{display:block;width:13px;height:13px;border-radius:50%;background:var(--fe-swatch);border:1px solid rgba(0,0,0,.22);box-shadow:0 0 0 2px var(--fe-bg);outline:1px solid rgba(89,28,39,.15)}
#fashion-edit-{{ section.id }} .fe-products--slider{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
#fashion-edit-{{ section.id }} .fe-products--slider::-webkit-scrollbar{display:none}
#fashion-edit-{{ section.id }} .fe-products--slider .fe-card{flex:0 0 calc((100% - 3 * var(--fe-gap))/4);scroll-snap-align:start}
#fashion-edit-{{ section.id }} .fe-controls{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
#fashion-edit-{{ section.id }} .fe-arrow{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(89,28,39,.3);border-radius:0;background:transparent;color:var(--fe-accent);cursor:pointer;transition:background .2s,color .2s}
#fashion-edit-{{ section.id }} .fe-arrow:hover{background:var(--fe-accent);color:white}
#fashion-edit-{{ section.id }} .fe-arrow:disabled{opacity:.3;cursor:default;background:transparent;color:var(--fe-accent)}
#fashion-edit-{{ section.id }} .fe-footer-rule{display:flex;gap:18px;align-items:center;justify-content:center;margin-top:34px;padding-top:22px;border-top:1px solid rgba(89,28,39,.15);color:var(--fe-muted);font:italic 15px Georgia,serif;letter-spacing:.01em;text-align:center}
#fashion-edit-{{ section.id }} .fe-footer-rule span{color:var(--fe-accent)}
#fashion-edit-{{ section.id }} .fe-view-mobile{display:none}
@media(max-width:989px){#fashion-edit-{{ section.id }} .fe-container{padding:0 22px}#fashion-edit-{{ section.id }} .fe-products{grid-template-columns:repeat(2,minmax(0,1fr))}#fashion-edit-{{ section.id }} .fe-products--slider .fe-card{flex-basis:calc((100% - var(--fe-gap))/2)}}
@media(max-width:749px){#fashion-edit-{{ section.id }}{padding:var(--fe-mtop) 0 var(--fe-mbottom)}#fashion-edit-{{ section.id }} .fe-container{padding:0 13px}#fashion-edit-{{ section.id }} .fe-edition-strip{font-size:8px;gap:8px;margin-bottom:22px;letter-spacing:.1em}#fashion-edit-{{ section.id }} .fe-edition-strip span:last-child{font-size:8px;letter-spacing:0}#fashion-edit-{{ section.id }} .fe-heading-row{margin-bottom:20px;padding-bottom:16px}#fashion-edit-{{ section.id }} .fe-heading-copy{padding-left:19px}#fashion-edit-{{ section.id }} .fe-heading-icon{font-size:16px}#fashion-edit-{{ section.id }} .fe-heading{font-size:clamp(29px,8vw,38px)}#fashion-edit-{{ section.id }} .fe-kicker{font-size:8px;letter-spacing:.13em;margin-bottom:8px}#fashion-edit-{{ section.id }} .fe-kicker-rule{width:12px}#fashion-edit-{{ section.id }} .fe-description{font-size:11px;line-height:1.5;max-width:280px;margin-top:8px}#fashion-edit-{{ section.id }} .fe-header-number{font-size:37px;opacity:.7}#fashion-edit-{{ section.id }} .fe-view-top{display:none}#fashion-edit-{{ section.id }} .fe-view-mobile{display:flex;justify-content:center;margin-top:22px}#fashion-edit-{{ section.id }} .fe-products{gap:22px 11px}#fashion-edit-{{ section.id }} .fe-products--slider{display:grid;gap:22px 11px;overflow:visible;scroll-snap-type:none}#fashion-edit-{{ section.id }} .fe-products--slider .fe-card{flex-basis:auto}#fashion-edit-{{ section.id }} .fe-controls{display:none}#fashion-edit-{{ section.id }} .fe-media{aspect-ratio:{{ section.settings.mobile_image_ratio }}}#fashion-edit-{{ section.id }} .fe-card-index{font-size:11px;padding-bottom:6px}#fashion-edit-{{ section.id }} .fe-badges{top:7px;left:7px}#fashion-edit-{{ section.id }} .fe-badge{font-size:8px;padding:5px 6px}#fashion-edit-{{ section.id }} .fe-quick{display:none}#fashion-edit-{{ section.id }} .fe-image-corner{right:7px;bottom:7px;width:13px;height:13px}#fashion-edit-{{ section.id }} .fe-details{padding-top:9px}#fashion-edit-{{ section.id }} .fe-card-meta{font-size:7px;letter-spacing:.07em}#fashion-edit-{{ section.id }} .fe-name{font-size:14px}#fashion-edit-{{ section.id }} .fe-price-line{gap:5px;margin-top:5px}#fashion-edit-{{ section.id }} .fe-price{font-size:12px}#fashion-edit-{{ section.id }} .fe-compare{font-size:10px}#fashion-edit-{{ section.id }} .fe-footer-rule{margin-top:23px;font-size:12px;gap:7px}#fashion-edit-{{ section.id }} .fe-vendor{font-size:8px}}
@media(max-width:749px){#fashion-edit-{{ section.id }} .fe-heading{font-size:{{ section.settings.mobile_heading_size }}px}}
@media(prefers-reduced-motion:no-preference){#fashion-edit-{{ section.id }} .fe-card{animation:fe-luxe-in-{{ section.id }} .65s both;animation-delay:calc(var(--fe-order) * 45ms)}@keyframes fe-luxe-in-{{ section.id }}{from{opacity:0;transform:translateY(17px)}to{opacity:1;transform:translateY(0)}}}
@media(prefers-reduced-motion:reduce){#fashion-edit-{{ section.id }} *,#fashion-edit-{{ section.id }} *:before,#fashion-edit-{{ section.id }} *:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

/* RIYAN V3 — GP Wishlist: keep one app-owned interactive heart.
   Style the actual GroPulse control without changing its click or saved state. */
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button {
  position:absolute !important;
  inset:12px 12px auto auto !important;
  z-index:10 !important;
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  width:42px !important;
  min-width:42px !important;
  max-width:42px !important;
  height:42px !important;
  min-height:42px !important;
  padding:0 !important;
  margin:0 !important;
  border:1px solid rgba(89,28,39,.10) !important;
  border-radius:999px !important;
  background:#fffaf7 !important;
  color:#591c27 !important;
  box-shadow:0 4px 18px rgba(35,16,22,.10) !important;
  cursor:pointer;
  line-height:1 !important;
  transform:none;
  transition:background .22s ease, border-color .22s ease, box-shadow .22s ease, transform .22s ease !important;
  -webkit-tap-highlight-color:transparent;
}
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button:hover {
  background:#fff !important;
  box-shadow:0 7px 22px rgba(35,16,22,.15) !important;
  transform:translateY(-1px);
}
#fashion-edit-{{ section.id }} .fe-media .gp-wishlist-button-icon,
#fashion-edit-{{ section.id }} .fe-media .gp-wishlist-button-icon > * {
  display:flex;
  align-items:center;
  justify-content:center;
  width:22px;
  height:22px;
  padding:0;
  margin:0;
  line-height:1;
}
#fashion-edit-{{ section.id }} .fe-media .gp-wishlist-button-icon svg,
#fashion-edit-{{ section.id }} .fe-media .gp-wishlist-button > svg {
  width:21px !important;
  height:21px !important;
  max-width:21px !important;
  max-height:21px !important;
  overflow:visible;
  color:#591c27 !important;
  stroke:#591c27 !important;
  stroke-width:1.8 !important;
  transition:fill .2s ease, stroke .2s ease;
}
/* The app controls whether its heart is outlined or filled.
   A selected heart stays burgundy on a light ivory circle. */
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.active,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.is-active,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.selected,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button[aria-pressed="true"] {
  background:#f6e9e7 !important;
  border-color:rgba(89,28,39,.20) !important;
  color:#591c27 !important;
  box-shadow:0 4px 16px rgba(89,28,39,.10) !important;
}
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.active svg,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.is-active svg,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button.selected svg,
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button[aria-pressed="true"] svg {
  color:#591c27 !important;
  stroke:#591c27 !important;
}
#fashion-edit-{{ section.id }} .fe-media .gp-wishlist-button-text {display:none !important}
#fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button:focus-visible {
  outline:2px solid #591c27 !important;
  outline-offset:3px !important;
}
#fashion-edit-{{ section.id }} .fe-card .fe-media-link {position:relative;z-index:1}
@media(max-width:749px) {
  #fashion-edit-{{ section.id }} .fe-media.card--media .gp-wishlist-button {
    inset:8px 8px auto auto !important;
    width:36px !important;
