<script>
  (function() {

    const section = document.querySelector(
      '#shopify-section-{{ section.id }}'
    );

    if (!section) return;


    const header = section.querySelector('[data-pth-header]');
    const drawer = section.querySelector('[data-pth-drawer]');
    const overlay = section.querySelector('[data-pth-overlay]');
    const openButton = section.querySelector('[data-pth-open]');
    const closeButton = section.querySelector('[data-pth-close]');


    /* ========================================
       TRANSPARENT → SOLID HEADER
    ======================================== */

    function updateHeader() {

      if (!header) return;

      if (window.scrollY > 25) {

        header.classList.add('pth-scrolled');

      } else {

        header.classList.remove('pth-scrolled');

      }

    }

    updateHeader();

    window.addEventListener(
      'scroll',
      updateHeader,
      { passive: true }
    );


    /* Desktop hover solid background */

    if (header) {

      header.addEventListener('mouseenter', function() {
        header.classList.add('pth-hovered');
      });

      header.addEventListener('mouseleave', function() {
        header.classList.remove('pth-hovered');
      });

    }


    /* ========================================
       MOBILE DRAWER
    ======================================== */

    function openDrawer() {

      if (!drawer || !overlay) return;

      drawer.classList.add('is-open');
      overlay.classList.add('is-open');

      drawer.setAttribute('aria-hidden', 'false');
      overlay.setAttribute('aria-hidden', 'false');

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'true');
      }

      document.documentElement.style.overflow = 'hidden';

    }


    function closeDrawer() {

      if (!drawer || !overlay) return;

      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');

      drawer.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('aria-hidden', 'true');

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'false');
      }

      document.documentElement.style.overflow = '';

    }


    if (openButton) {
      openButton.addEventListener('click', openDrawer);
    }


    if (closeButton) {
      closeButton.addEventListener('click', closeDrawer);
    }


    if (overlay) {
      overlay.addEventListener('click', closeDrawer);
    }


    /* ========================================
       MOBILE SUBMENUS
    ======================================== */

    const submenuButtons =
      section.querySelectorAll('.pth-submenu-toggle');


    submenuButtons.forEach(function(button) {

      button.addEventListener('click', function() {

        const parent = button.closest('li');

        if (!parent) return;


        const submenu =
          parent.querySelector('.pth-mobile-submenu');

        if (!submenu) return;


        const currentlyOpen =
          submenu.classList.contains('is-open');


        submenu.classList.toggle(
          'is-open',
          !currentlyOpen
        );


        button.classList.toggle(
          'is-open',
          !currentlyOpen
        );


        button.setAttribute(
          'aria-expanded',
          currentlyOpen ? 'false' : 'true'
        );

      });

    });


    /* ========================================
       ESCAPE CLOSE
    ======================================== */

    document.addEventListener(
      'keydown',
      function(event) {

        if (event.key === 'Escape') {
          closeDrawer();
        }

      }
    );


    /* ========================================
       WINDOW RESIZE
    ======================================== */

    window.addEventListener(
      'resize',
      function() {

        if (window.innerWidth > 989) {
          closeDrawer();
        }

      }
    );

  })();
</script>


