{% liquid
  assign sid = section.id
%}

<section id="RiyanFAQ-{{ sid }}" class="rfq-luxury" style="--rfq-bg:{{ section.settings.background_color }};--rfq-panel:{{ section.settings.card_color }};--rfq-accent:{{ section.settings.accent_color }};--rfq-ink:{{ section.settings.text_color }};--rfq-muted:{{ section.settings.muted_color }};--rfq-line:{{ section.settings.border_color }};--rfq-width:{{ section.settings.max_width }}px;--rfq-gap:{{ section.settings.column_gap }}px;--rfq-radius:{{ section.settings.card_radius }}px;">
  <div class="rfq-luxury__shell">
    {% if section.settings.show_top_line %}
      <div class="rfq-luxury__toprule" aria-hidden="true"><span></span><i>✧</i><span></span></div>
    {% endif %}
    <div class="rfq-luxury__layout">
      <div class="rfq-luxury__editorial {% if section.settings.dark_intro %}rfq-luxury__editorial--dark{% endif %}">
        <div class="rfq-luxury__editorial-inner">
          {% if section.settings.show_giant_letter and section.settings.giant_letter != blank %}
            <span class="rfq-luxury__monogram" aria-hidden="true">{{ section.settings.giant_letter | escape }}</span>
          {% endif %}
          <div class="rfq-luxury__meta">
            <span class="rfq-luxury__meta-dot" aria-hidden="true"></span>
            <span>{{ section.settings.editorial_label | escape }}</span>
          </div>
          <div class="rfq-luxury__editorial-content">
            {% if section.settings.eyebrow != blank %}<div class="rfq-luxury__eyebrow">{{ section.settings.eyebrow | escape }}</div>{% endif %}
            {% if section.settings.heading != blank %}<h2 class="rfq-luxury__title">{{ section.settings.heading | escape }}</h2>{% endif %}
            {% if section.settings.show_divider %}<div class="rfq-luxury__ornament" aria-hidden="true"><span></span>✦<span></span></div>{% endif %}
            {% if section.settings.description != blank %}<div class="rfq-luxury__description rte">{{ section.settings.description }}</div>{% endif %}
            {% if section.settings.show_signature and section.settings.signature_text != blank %}
              <p class="rfq-luxury__signature">{{ section.settings.signature_text | escape }}</p>
            {% endif %}
          </div>
          <div class="rfq-luxury__editorial-bottom">
            <span>THE VEYZARA EXPERIENCE</span><span aria-hidden="true">↗</span>
          </div>
        </div>
      </div>

      <div class="rfq-luxury__main">
        <div class="rfq-luxury__list-head">
          <div>
            {% if section.settings.show_faq_index %}<span class="rfq-luxury__index">01 / CUSTOMER CARE</span>{% endif %}
            {% if section.settings.list_label != blank %}<h3 class="rfq-luxury__list-title">{{ section.settings.list_label | escape }}</h3>{% endif %}
          </div>
          {% if section.settings.show_count %}<span class="rfq-luxury__count">{{ section.blocks.size }} {{ section.settings.count_label | escape }}</span>{% endif %}
        </div>
        <div class="rfq-luxury__accordions" data-single-open="{{ section.settings.single_open }}">
          {% assign rfq_seen = '|' %}
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              {% liquid
                assign rfq_question = block.settings.question | strip
                assign rfq_answer = block.settings.answer
                assign rfq_key = rfq_question | handleize | prepend: '|' | append: '|'
                if rfq_seen contains rfq_key
                  case forloop.index
                    when 4
                      assign rfq_question = 'How can I track my order?'
                      assign rfq_answer = '<p>Use the tracking information shared after dispatch to follow your order.</p>'
                    when 5
                      assign rfq_question = 'Can I get help before ordering?'
                      assign rfq_answer = '<p>Contact our team if you need guidance on sizing, fabrics or product details.</p>'
                    else
                      assign rfq_question = 'Need more help with your order?'
                      assign rfq_answer = '<p>Please contact our support team for assistance with your question.</p>'
                  endcase
                endif
                assign rfq_new_key = rfq_question | handleize | prepend: '|' | append: '|'
                assign rfq_seen = rfq_seen | append: rfq_new_key
              %}
              <details class="rfq-luxury__item" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="rfq-luxury__trigger">
                  <span class="rfq-luxury__question-group">
                    {% if section.settings.show_numbers %}<span class="rfq-luxury__question-number">{{ forloop.index | prepend: '0' }}</span>{% endif %}
                    <span class="rfq-luxury__question-text">{{ rfq_question | escape }}</span>
                  </span>
                  <span class="rfq-luxury__toggle" aria-hidden="true"><span></span><span></span></span>
                </summary>
                <div class="rfq-luxury__answer rte">{{ rfq_answer }}</div>
              </details>
            {% endif %}
          {% endfor %}
        </div>
        {% if section.settings.show_bottom_note and section.settings.bottom_note != blank %}
          <p class="rfq-luxury__note"><span aria-hidden="true">✧</span> {{ section.settings.bottom_note | escape }}</p>
        {% endif %}
        {% if section.settings.show_help_box %}
          <div class="rfq-luxury__help">
            <div class="rfq-luxury__help-mark" aria-hidden="true">✉</div>
            <div class="rfq-luxury__help-copy">
              {% if section.settings.help_title != blank %}<strong>{{ section.settings.help_title | escape }}</strong>{% endif %}
              {% if section.settings.help_text != blank %}<p>{{ section.settings.help_text | escape }}</p>{% endif %}
            </div>
            {% if section.settings.help_link != blank and section.settings.help_link_label != blank %}
              <a class="rfq-luxury__help-link" href="{{ section.settings.help_link }}">{{ section.settings.help_link_label | escape }} <span aria-hidden="true">↗</span></a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
#RiyanFAQ-{{ sid }}{display:block;position:relative;clear:both;width:100%;background:var(--rfq-bg);color:var(--rfq-ink);padding:{{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;isolation:isolate}
#RiyanFAQ-{{ sid }},#RiyanFAQ-{{ sid }} *,#RiyanFAQ-{{ sid }} *::before,#RiyanFAQ-{{ sid }} *::after{box-sizing:border-box}
#RiyanFAQ-{{ sid }} .rfq-luxury__shell{max-width:var(--rfq-width);margin-inline:auto}
#RiyanFAQ-{{ sid }} .rfq-luxury__toprule{display:flex;align-items:center;gap:13px;margin-bottom:27px;color:var(--rfq-accent)}
#RiyanFAQ-{{ sid }} .rfq-luxury__toprule span:first-child{width:55px;height:1px;background:var(--rfq-accent)}
#RiyanFAQ-{{ sid }} .rfq-luxury__toprule span:last-child{flex:1;height:1px;background:var(--rfq-line)}
#RiyanFAQ-{{ sid }} .rfq-luxury__toprule i{font:normal 15px Georgia,serif}
#RiyanFAQ-{{ sid }} .rfq-luxury__layout{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);align-items:stretch;gap:var(--rfq-gap)}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial{min-width:0;position:relative;overflow:hidden;border:1px solid var(--rfq-line);border-radius:var(--rfq-radius);background:var(--rfq-panel);color:var(--rfq-ink)}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial--dark{background:var(--rfq-accent);border-color:var(--rfq-accent);color:#fff7f0}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-inner{min-height:{{ section.settings.intro_min_height }}px;height:100%;display:flex;flex-direction:column;position:relative;overflow:hidden;padding:{{ section.settings.intro_padding }}px}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-inner::before{content:'';position:absolute;width:310px;height:310px;right:-195px;top:15%;border:1px solid currentColor;border-radius:50%;opacity:.1;pointer-events:none}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-inner::after{content:'';position:absolute;width:245px;height:245px;right:-160px;top:21%;border:1px solid currentColor;border-radius:50%;opacity:.09;pointer-events:none}
#RiyanFAQ-{{ sid }} .rfq-luxury__monogram{position:absolute;right:-15px;bottom:43px;font:italic 290px/.75 Georgia,serif;letter-spacing:-.1em;opacity:.055;pointer-events:none;user-select:none}
#RiyanFAQ-{{ sid }} .rfq-luxury__meta{position:relative;display:flex;gap:10px;align-items:center;font-size:9px;letter-spacing:.2em;font-weight:650;text-transform:uppercase;opacity:.75}
#RiyanFAQ-{{ sid }} .rfq-luxury__meta-dot{width:6px;height:6px;flex:0 0 6px;border:1px solid currentColor;transform:rotate(45deg)}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-content{position:relative;margin:auto 0;padding:38px 0 44px}
#RiyanFAQ-{{ sid }} .rfq-luxury__eyebrow{font-size:10px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;opacity:.78;margin-bottom:18px}
#RiyanFAQ-{{ sid }} .rfq-luxury__title{font-family:Georgia,'Times New Roman',serif!important;font-weight:400;font-size:{{ section.settings.heading_size }}px;letter-spacing:-.058em;line-height:1.03;margin:0;color:inherit;max-width:490px;text-wrap:balance}
#RiyanFAQ-{{ sid }} .rfq-luxury__ornament{display:flex;gap:12px;align-items:center;margin:27px 0;color:inherit;opacity:.68;font-size:12px}
#RiyanFAQ-{{ sid }} .rfq-luxury__ornament span{height:1px;width:42px;background:currentColor;opacity:.45}
#RiyanFAQ-{{ sid }} .rfq-luxury__description{font-size:{{ section.settings.description_size }}px;line-height:1.8;max-width:420px;opacity:.87}
#RiyanFAQ-{{ sid }} .rfq-luxury__description p{margin:0 0 10px}
#RiyanFAQ-{{ sid }} .rfq-luxury__description p:last-child{margin:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__signature{margin:24px 0 0;font:italic 15px Georgia,serif;opacity:.8}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-bottom{position:relative;display:flex;justify-content:space-between;align-items:center;gap:15px;padding-top:17px;border-top:1px solid currentColor;font-size:9px;letter-spacing:.2em;font-weight:600;opacity:.68}
#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-bottom span:last-child{font-size:18px;letter-spacing:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__main{min-width:0;display:flex;flex-direction:column;padding:4px 0 0}
#RiyanFAQ-{{ sid }} .rfq-luxury__list-head{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:0 0 22px;border-bottom:1px solid var(--rfq-ink)}
#RiyanFAQ-{{ sid }} .rfq-luxury__index{display:block;font-size:9px;letter-spacing:.2em;color:var(--rfq-accent);font-weight:700;margin-bottom:9px}
#RiyanFAQ-{{ sid }} .rfq-luxury__list-title{font:400 clamp(23px,2.4vw,34px)/1.2 Georgia,serif;color:var(--rfq-ink);margin:0;letter-spacing:-.04em}
#RiyanFAQ-{{ sid }} .rfq-luxury__count{font-size:10px;text-transform:uppercase;color:var(--rfq-muted);letter-spacing:.1em;white-space:nowrap}
#RiyanFAQ-{{ sid }} .rfq-luxury__item{position:relative;margin:0;border:0;border-bottom:1px solid var(--rfq-line);background:transparent;transition:background-color .25s}
#RiyanFAQ-{{ sid }} .rfq-luxury__item[open]{background:var(--rfq-panel)}
#RiyanFAQ-{{ sid }} .rfq-luxury__item::before{content:'';position:absolute;inset:0 auto 0 0;width:2px;background:var(--rfq-accent);transform:scaleY(0);transform-origin:top;transition:transform .3s}
#RiyanFAQ-{{ sid }} .rfq-luxury__item[open]::before{transform:scaleY(1)}
#RiyanFAQ-{{ sid }} .rfq-luxury__trigger{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:17px {{ section.settings.question_horizontal_padding }}px;min-height:{{ section.settings.question_height }}px;cursor:pointer}
#RiyanFAQ-{{ sid }} .rfq-luxury__trigger::-webkit-details-marker{display:none}
#RiyanFAQ-{{ sid }} .rfq-luxury__trigger:focus-visible{outline:2px solid var(--rfq-accent);outline-offset:-3px}
#RiyanFAQ-{{ sid }} .rfq-luxury__question-group{display:flex;align-items:baseline;gap:17px;min-width:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__question-number{flex:0 0 22px;font:italic 13px Georgia,serif;color:var(--rfq-accent)}
#RiyanFAQ-{{ sid }} .rfq-luxury__question-text{font-size:{{ section.settings.question_size }}px;line-height:1.5;font-weight:550;letter-spacing:-.012em;color:var(--rfq-ink);transition:color .25s}
#RiyanFAQ-{{ sid }} .rfq-luxury__toggle{flex:0 0 34px;width:34px;height:34px;position:relative;display:grid;place-items:center;border:1px solid var(--rfq-line);border-radius:50%;background:transparent;transition:background .25s,border-color .25s,transform .25s}
#RiyanFAQ-{{ sid }} .rfq-luxury__toggle span{position:absolute;width:12px;height:1px;background:var(--rfq-accent);transition:opacity .25s,transform .25s}
#RiyanFAQ-{{ sid }} .rfq-luxury__toggle span:last-child{transform:rotate(90deg)}
#RiyanFAQ-{{ sid }} .rfq-luxury__item[open] .rfq-luxury__toggle{background:var(--rfq-accent);border-color:var(--rfq-accent);transform:rotate(180deg)}
#RiyanFAQ-{{ sid }} .rfq-luxury__item[open] .rfq-luxury__toggle span{background:white}
#RiyanFAQ-{{ sid }} .rfq-luxury__item[open] .rfq-luxury__toggle span:last-child{opacity:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__answer{padding:0 {{ section.settings.question_horizontal_padding }}px 22px;color:var(--rfq-muted);font-size:{{ section.settings.answer_size }}px;line-height:1.8}
#RiyanFAQ-{{ sid }} .rfq-luxury__answer p{margin:0 0 10px}
#RiyanFAQ-{{ sid }} .rfq-luxury__answer p:last-child{margin-bottom:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__answer a{color:var(--rfq-accent);text-underline-offset:3px}
#RiyanFAQ-{{ sid }} .rfq-luxury__note{display:flex;align-items:flex-start;gap:10px;margin:19px 0 0;font-size:11px;color:var(--rfq-muted);line-height:1.6}
#RiyanFAQ-{{ sid }} .rfq-luxury__note span{color:var(--rfq-accent)}
#RiyanFAQ-{{ sid }} .rfq-luxury__help{margin-top:auto;padding:25px 0 0;display:flex;align-items:center;gap:17px}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-mark{flex:0 0 42px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:var(--rfq-accent);color:#fff;font-size:19px}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-copy{flex:1;min-width:0}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-copy strong{display:block;font-size:13px;color:var(--rfq-ink);font-weight:650}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-copy p{font-size:11px;line-height:1.6;margin:4px 0 0;color:var(--rfq-muted)}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-link{flex:none;display:inline-flex;gap:7px;align-items:center;padding:11px 12px;border:1px solid var(--rfq-accent);color:var(--rfq-accent);text-decoration:none;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;transition:background .25s,color .25s}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-link:hover{background:var(--rfq-accent);color:#fff}
@media(hover:hover){#RiyanFAQ-{{ sid }} .rfq-luxury__item:not([open]):hover{background:var(--rfq-panel)}#RiyanFAQ-{{ sid }} .rfq-luxury__item:not([open]):hover .rfq-luxury__question-text{color:var(--rfq-accent)}#RiyanFAQ-{{ sid }} .rfq-luxury__item:not([open]):hover .rfq-luxury__toggle{transform:rotate(90deg);border-color:var(--rfq-accent)}}
@media(max-width:989px){#RiyanFAQ-{{ sid }}{padding-left:20px;padding-right:20px}#RiyanFAQ-{{ sid }} .rfq-luxury__layout{grid-template-columns:minmax(0,1fr);gap:30px}#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-inner{min-height:0}#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-content{padding:37px 0}#RiyanFAQ-{{ sid }} .rfq-luxury__main{padding:0}#RiyanFAQ-{{ sid }} .rfq-luxury__help{margin-top:20px}}
@media(max-width:749px){#RiyanFAQ-{{ sid }}{padding:{{ section.settings.mobile_padding_top }}px 14px {{ section.settings.mobile_padding_bottom }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__toprule{margin-bottom:18px}#RiyanFAQ-{{ sid }} .rfq-luxury__layout{gap:23px}#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-inner{padding:{{ section.settings.mobile_intro_padding }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__title{font-size:{{ section.settings.mobile_heading_size }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__description{font-size:{{ section.settings.mobile_description_size }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__editorial-content{padding:29px 0}#RiyanFAQ-{{ sid }} .rfq-luxury__ornament{margin:19px 0}#RiyanFAQ-{{ sid }} .rfq-luxury__monogram{font-size:190px}#RiyanFAQ-{{ sid }} .rfq-luxury__list-head{padding-bottom:15px}#RiyanFAQ-{{ sid }} .rfq-luxury__list-title{font-size:25px}#RiyanFAQ-{{ sid }} .rfq-luxury__trigger{min-height:0;padding:18px 12px;gap:10px}#RiyanFAQ-{{ sid }} .rfq-luxury__question-group{gap:10px}#RiyanFAQ-{{ sid }} .rfq-luxury__question-text{font-size:{{ section.settings.mobile_question_size }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__toggle{flex-basis:30px;width:30px;height:30px}#RiyanFAQ-{{ sid }} .rfq-luxury__answer{padding:0 12px 20px;font-size:{{ section.settings.mobile_answer_size }}px}#RiyanFAQ-{{ sid }} .rfq-luxury__help{flex-wrap:wrap;gap:12px}#RiyanFAQ-{{ sid }} .rfq-luxury__help-link{width:100%;justify-content:center}#RiyanFAQ-{{ sid }} .rfq-luxury__count{font-size:9px}}
@media(prefers-reduced-motion:reduce){#RiyanFAQ-{{ sid }} *,#RiyanFAQ-{{ sid }} *::before,#RiyanFAQ-{{ sid }} *::after{transition:none!important;animation:none!important}}

