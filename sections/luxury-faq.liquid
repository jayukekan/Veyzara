#RiyanFAQ-{{ sid }} .rfq-luxury__toggle{flex:0 0 32px;width:32px;height:32px}
#RiyanFAQ-{{ sid }} .rfq-luxury__answer{padding:0 58px 20px 47px;font-size:13px;line-height:1.75}
#RiyanFAQ-{{ sid }} .rfq-luxury__help{margin-top:25px;padding:19px;border:1px solid var(--rfq-line);border-radius:10px;background:var(--rfq-panel)}
#RiyanFAQ-{{ sid }} .rfq-luxury__help-link{border-radius:3px}
@media(max-width:749px){
 #RiyanFAQ-{{ sid }} .rfq-luxury__list-head{padding-bottom:15px;gap:8px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__list-title{font-size:clamp(25px,6.5vw,31px);line-height:1.15}
 #RiyanFAQ-{{ sid }} .rfq-luxury__index{font-size:8px;letter-spacing:.14em}
 #RiyanFAQ-{{ sid }} .rfq-luxury__count{font-size:8px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__trigger{min-height:60px;padding:14px 7px;gap:11px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__question-group{gap:9px;align-items:center}
 #RiyanFAQ-{{ sid }} .rfq-luxury__question-number{flex-basis:20px;font-size:10px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__question-text{font-size:14px;line-height:1.42;font-weight:600}
 #RiyanFAQ-{{ sid }} .rfq-luxury__toggle{flex-basis:30px;width:30px;height:30px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__answer{padding:0 10px 17px 36px;font-size:12px;line-height:1.7}
 #RiyanFAQ-{{ sid }} .rfq-luxury__help{margin-top:22px;padding:16px;gap:12px;display:grid;grid-template-columns:36px minmax(0,1fr)}
 #RiyanFAQ-{{ sid }} .rfq-luxury__help-mark{width:36px;height:36px;flex-basis:36px}
 #RiyanFAQ-{{ sid }} .rfq-luxury__help-link{grid-column:1 / -1;width:100%;min-height:43px}
}
</style>

<script>
/* Register just once, but support sections re-rendered by the Theme Editor. */
if (!window.riyanLuxuryFaqListener) {
  window.riyanLuxuryFaqListener = true;
  document.addEventListener('toggle', function (event) {
    const opened = event.target;
    if (!(opened instanceof HTMLDetailsElement) || !opened.matches('.rfq-luxury__item') || !opened.open) return;
    const container = opened.closest('.rfq-luxury__accordions');
    if (!container || container.dataset.singleOpen !== 'true') return;
    container.querySelectorAll('.rfq-luxury__item[open]').forEach(function(item) {
      if (item !== opened) item.open = false;
    });
  }, true);
}
</script>

