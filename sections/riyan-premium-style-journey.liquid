<script>
  (function() {
    var root = document.getElementById('rc-editorial-{{ section.id }}');
    if (!root || root.dataset.rcReady === 'true') return;

    root.dataset.rcReady = 'true';

    var tabs = Array.from(root.querySelectorAll('.rc-editorial__tab'));
    var panels = Array.from(root.querySelectorAll('.rc-editorial__panel'));
    var count = root.querySelector('.rc-editorial__count');
    var current = root.querySelector('.rc-editorial__current');
    var progress = root.querySelector('.rc-editorial__progress-bar');
    var index = 0;

    function pad(number) {
      return String(number).padStart(2, '0');
    }

    function activate(nextIndex, focusTab) {
      if (!tabs.length) return;

      index = (nextIndex + tabs.length) % tabs.length;

      tabs.forEach(function(tab, tabIndex) {
        var active = tabIndex === index;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach(function(panel, panelIndex) {
        var active = panelIndex === index;
        panel.hidden = !active;
        panel.classList.toggle('is-active', active);
      });

      if (count) {
        count.textContent = pad(index + 1) + ' / ' + pad(tabs.length);
      }

      if (current) {
        current.textContent = pad(index + 1);
      }

      if (progress) {
        progress.style.width = (((index + 1) / tabs.length) * 100) + '%';
      }

      if (focusTab) {
        tabs[index].focus({ preventScroll: true });
      }

      if (window.matchMedia('(max-width: 989px)').matches) {
        var strip = root.querySelector('.rc-editorial__tabs');
        var activeTab = tabs[index];

        if (strip && activeTab) {
          var target =
            activeTab.offsetLeft -
            strip.offsetLeft -
            (strip.clientWidth - activeTab.clientWidth) / 2;

          strip.scrollTo({
            left: target,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
          });
        }
      }
    }

    tabs.forEach(function(tab, tabIndex) {
      tab.addEventListener('click', function() {
        activate(tabIndex, false);
      });

      tab.addEventListener('keydown', function(event) {
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
          event.preventDefault();
          activate(index + 1, true);
        } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
          event.preventDefault();
          activate(index - 1, true);
        } else if (event.key === 'Home') {
          event.preventDefault();
          activate(0, true);
        } else if (event.key === 'End') {
          event.preventDefault();
          activate(tabs.length - 1, true);
        }
      });
    });

    var next = root.querySelector('.rc-editorial__next');
    var prev = root.querySelector('.rc-editorial__prev');

    if (next) {
      next.addEventListener('click', function() {
        activate(index + 1, false);
      });
    }

    if (prev) {
      prev.addEventListener('click', function() {
        activate(index - 1, false);
      });
    }

    activate(0, false);
  })();
</script>

