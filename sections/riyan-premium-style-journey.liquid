{% comment %}
  RIYAN CREATION — Minimal Editorial Showcase V11
  Clean luxury womenswear layout
  Desktop: Editorial navigation + large campaign visual
  Mobile: Horizontal pill navigation + clean image/card flow
  No external library required
{% endcomment %}

<section
  id="rc-editorial-{{ section.id }}"
  class="rc-editorial"
  style="
    --rc-bg: {{ section.settings.bg }};
    --rc-surface: {{ section.settings.surface }};
    --rc-ink: {{ section.settings.ink }};
    --rc-muted: {{ section.settings.muted }};
    --rc-accent: {{ section.settings.accent }};
    --rc-line: {{ section.settings.line }};
    --rc-radius: {{ section.settings.radius }}px;
    --rc-dh: {{ section.settings.desktop_height }}px;
    --rc-mh: {{ section.settings.mobile_height }}px;
    --rc-photo-bg: {{ section.settings.image_background }};
    --rc-mobile-photo-bg: {{ section.settings.mobile_image_background }};
  "
>
  <div class="rc-editorial__container">

    <header class="rc-editorial__header">
      {% if section.settings.kicker != blank %}
        <div class="rc-editorial__kicker">
          <span></span>
          {{ section.settings.kicker | escape }}
          <span></span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="rc-editorial__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </header>

    <div class="rc-editorial__layout">

      <aside class="rc-editorial__menu">
        <div class="rc-editorial__menu-top">
          <span>{{ section.settings.menu_label | escape }}</span>
          <span class="rc-editorial__count">
            01 / {{ section.blocks.size | prepend: '0' | slice: -2, 2 }}
          </span>
        </div>

        <div class="rc-editorial__tabs" role="tablist" aria-label="Riyan fashion edits">
          {% for block in section.blocks %}
            <button
              type="button"
              class="rc-editorial__tab{% if forloop.first %} is-active{% endif %}"
              id="rc-tab-{{ section.id }}-{{ forloop.index0 }}"
              role="tab"
              aria-controls="rc-panel-{{ section.id }}-{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="rc-editorial__tab-number">
                {{ forloop.index | prepend: '0' | slice: -2, 2 }}
              </span>

              <span class="rc-editorial__tab-copy">
                <strong>{{ block.settings.tab_title | default: 'The Signature Edit' | escape }}</strong>
              </span>

              <span class="rc-editorial__tab-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          {% endfor %}
        </div>
      </aside>

      <div class="rc-editorial__display">
        {% for block in section.blocks %}
          <article
            class="rc-editorial__panel{% if forloop.first %} is-active{% endif %}"
            id="rc-panel-{{ section.id }}-{{ forloop.index0 }}"
            role="tabpanel"
            aria-labelledby="rc-tab-{{ section.id }}-{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
            data-index="{{ forloop.index0 }}"
          >
            <div
              class="rc-editorial__visual rc-editorial__visual--{{ section.settings.image_height }}"
              style="
                --rc-image-position: {{ block.settings.image_position }};
                --rc-mobile-position: {{ block.settings.mobile_image_position }};
              "
            >
              {% if block.settings.image != blank or block.settings.mobile_image != blank %}
                {% assign desktop_photo = block.settings.image | default: block.settings.mobile_image %}

                <picture class="rc-editorial__picture">
                  {% if block.settings.mobile_image != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                        {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                        {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w
                      "
                      sizes="calc(100vw - 32px)"
                    >
                  {% endif %}

                  {{
                    desktop_photo
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 750, 990, 1200, 1500, 1800, 2000',
                      sizes: '(max-width: 749px) calc(100vw - 32px), (max-width: 989px) calc(100vw - 48px), 66vw',
                      class: 'rc-editorial__image',
                      alt: block.settings.tab_title
                  }}
                </picture>
              {% else %}
                <div class="rc-editorial__empty">
                  <span>RIYAN CREATION</span>
                  <small>Add a campaign image for this look</small>
                </div>
              {% endif %}

              
            </div>

            <div class="rc-editorial__content-row">
              <div class="rc-editorial__editorial-copy">

                <h3>{{ block.settings.heading | default: block.settings.tab_title | escape }}</h3>
              </div>

              {% if block.settings.link != blank and block.settings.link_text != blank %}
                <a class="rc-editorial__link" href="{{ block.settings.link }}">
                  <span>{{ block.settings.link_text | escape }}</span>
                  <span class="rc-editorial__link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}

        {% if section.blocks.size > 1 %}
          <div class="rc-editorial__controls">
            <div class="rc-editorial__progress-wrap">
              
              <div class="rc-editorial__progress" aria-hidden="true">
                <span class="rc-editorial__progress-bar"></span>
              </div>
              <span class="rc-editorial__fraction">
                <span class="rc-editorial__current">01</span>
                <span class="rc-editorial__fraction-divider">/</span>
                <span>{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
              </span>
            </div>

            <div class="rc-editorial__arrows">
              <button type="button" class="rc-editorial__prev" aria-label="Previous style">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <button type="button" class="rc-editorial__next" aria-label="Next style">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #rc-editorial-{{ section.id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, color-mix(in srgb, var(--rc-accent) 5%, transparent) 0, transparent 23%),
      var(--rc-bg);
    color: var(--rc-ink);
    padding: {{ section.settings.top_space }}px 0 {{ section.settings.bottom_space }}px;
  }

  #rc-editorial-{{ section.id }} * {
    box-sizing: border-box;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__container {
    width: min({{ section.settings.max_width }}px, calc(100% - 64px));
    margin: 0 auto;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__header {
    max-width: 860px;
    margin: 0 auto 42px;
    text-align: center;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .22em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--rc-accent);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__kicker > span {
    width: 28px;
    height: 1px;
    background: currentColor;
    opacity: .45;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__heading {
    margin: 13px 0 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(38px, 4.2vw, 64px);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -.045em;
    color: var(--rc-ink);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__heading em {
    color: var(--rc-accent);
    font-weight: 400;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__intro {
    max-width: 610px;
    margin: 14px auto 0;
    color: var(--rc-muted);
    font-size: 13px;
    line-height: 1.75;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__layout {
    display: grid;
    grid-template-columns: minmax(260px, .78fr) minmax(0, 1.7fr);
    gap: clamp(34px, 5vw, 82px);
    align-items: center;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__menu,
  #rc-editorial-{{ section.id }} .rc-editorial__display,
  #rc-editorial-{{ section.id }} .rc-editorial__panel {
    min-width: 0;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 4px 16px 0;
    border-bottom: 1px solid var(--rc-line);
    color: var(--rc-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tabs {
    width: 100%;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab {
    position: relative;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 78px;
    padding: 15px 4px 15px 0;
    border: 0;
    border-bottom: 1px solid var(--rc-line);
    background: transparent;
    color: var(--rc-ink);
    text-align: left;
    cursor: pointer;
    transition: padding .3s ease, background .3s ease, color .3s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: 18px;
    bottom: 18px;
    width: 2px;
    border-radius: 99px;
    background: var(--rc-accent);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform .3s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab:hover,
  #rc-editorial-{{ section.id }} .rc-editorial__tab.is-active {
    padding-left: 14px;
    background: color-mix(in srgb, var(--rc-accent) 4%, transparent);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab.is-active::before {
    transform: scaleY(1);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-number {
    align-self: start;
    margin-top: 5px;
    color: var(--rc-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .11em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-copy {
    min-width: 0;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-copy strong {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(18px, 1.65vw, 25px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -.025em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-copy small {
    display: block;
    margin-top: 5px;
    color: var(--rc-muted);
    font-size: 10px;
    line-height: 1.5;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: 50%;
    color: var(--rc-accent);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity .25s ease, transform .25s ease, border-color .25s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab-arrow svg {
    width: 16px;
    height: 16px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__tab:hover .rc-editorial__tab-arrow,
  #rc-editorial-{{ section.id }} .rc-editorial__tab.is-active .rc-editorial__tab-arrow {
    opacity: 1;
    transform: none;
    border-color: var(--rc-line);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__note {
    max-width: 30ch;
    margin: 18px 0 0;
    color: var(--rc-muted);
    font-size: 10px;
    line-height: 1.7;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__panel[hidden] {
    display: none !important;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__panel.is-active {
    animation: rcPanelIn-{{ section.id }} .48s cubic-bezier(.22,.8,.22,1) both;
  }

  @keyframes rcPanelIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--rc-radius);
    background: var(--rc-photo-bg);
    isolation: isolate;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual--fixed {
    height: var(--rc-dh);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: var(--rc-image-position, center center);
    transition: transform .8s cubic-bezier(.22,.8,.22,1);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual--adapt,
  #rc-editorial-{{ section.id }} .rc-editorial__visual--adapt .rc-editorial__picture {
    height: auto;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual--adapt .rc-editorial__image {
    height: auto;
    object-fit: contain;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual:hover .rc-editorial__image {
    transform: scale(1.018);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__visual-frame {
    position: absolute;
    inset: 10px;
    border: 1px solid rgba(255,255,255,.38);
    border-radius: max(0px, calc(var(--rc-radius) - 5px));
    pointer-events: none;
    z-index: 2;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__image-label {
    position: absolute;
    left: 22px;
    top: 22px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 7px 12px;
    border: 1px solid rgba(255,255,255,.54);
    background: rgba(255,255,255,.88);
    box-shadow: 0 10px 30px rgba(20,12,14,.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--rc-accent);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1;
    text-transform: uppercase;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__empty {
    min-height: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 40px;
    text-align: center;
    color: var(--rc-accent);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__empty span {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    letter-spacing: .12em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__empty small {
    color: var(--rc-muted);
    font-size: 11px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__content-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 30px;
    padding: 22px 2px 18px;
    border-bottom: 1px solid var(--rc-line);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__editorial-copy {
    max-width: 560px;
    min-width: 0;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__eyebrow {
    display: block;
    color: var(--rc-accent);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .19em;
    text-transform: uppercase;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__editorial-copy h3 {
    margin: 7px 0 7px;
    color: var(--rc-ink);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(25px, 2.6vw, 38px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.04em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__editorial-copy p {
    max-width: 58ch;
    margin: 0;
    color: var(--rc-muted);
    font-size: 11px;
    line-height: 1.68;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__link {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 43px;
    padding: 0 4px 0 15px;
    border: 1px solid var(--rc-line);
    border-radius: 999px;
    color: var(--rc-ink);
    background: var(--rc-surface);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color .25s ease, background .25s ease, color .25s ease, transform .25s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__link-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--rc-accent);
    color: #fff;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__link-icon svg {
    width: 15px;
    height: 15px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__link:hover {
    border-color: var(--rc-accent);
    transform: translateY(-1px);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 14px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__progress-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__slide-label {
    color: var(--rc-muted);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__progress {
    width: clamp(80px, 10vw, 150px);
    height: 1px;
    overflow: hidden;
    background: var(--rc-line);
  }

  #rc-editorial-{{ section.id }} .rc-editorial__progress-bar {
    display: block;
    width: 0%;
    height: 100%;
    background: var(--rc-accent);
    transition: width .35s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__fraction {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--rc-accent);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .08em;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__fraction-divider {
    color: var(--rc-muted);
    opacity: .55;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__arrows {
    display: flex;
    gap: 8px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__arrows button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--rc-line);
    border-radius: 50%;
    background: var(--rc-surface);
    color: var(--rc-ink);
    cursor: pointer;
    transition: background .25s ease, border-color .25s ease, color .25s ease, transform .25s ease;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__arrows button svg {
    width: 16px;
    height: 16px;
  }

  #rc-editorial-{{ section.id }} .rc-editorial__arrows button:hover {
    border-color: var(--rc-accent);
    background: var(--rc-accent);
    color: #fff;
    transform: translateY(-1px);
  }

  #rc-editorial-{{ section.id }} button:focus-visible,
  #rc-editorial-{{ section.id }} a:focus-visible {
    outline: 2px solid var(--rc-accent);
    outline-offset: 3px;
  }

  @media (max-width: 989px) {
    #rc-editorial-{{ section.id }} .rc-editorial__container {
      width: calc(100% - 48px);
    }

    #rc-editorial-{{ section.id }} .rc-editorial__header {
      margin-bottom: 28px;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__layout {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__menu-top,
    #rc-editorial-{{ section.id }} .rc-editorial__note {
      display: none;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tabs {
      display: flex;
      gap: 8px;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 2px 1px 10px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tabs::-webkit-scrollbar {
      display: none;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tab,
    #rc-editorial-{{ section.id }} .rc-editorial__tab:hover,
    #rc-editorial-{{ section.id }} .rc-editorial__tab.is-active {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
      width: auto;
      min-height: 40px;
      padding: 0 16px;
      border: 1px solid var(--rc-line);
      border-radius: 999px;
      background: var(--rc-surface);
      color: var(--rc-ink);
      scroll-snap-align: start;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tab::before,
    #rc-editorial-{{ section.id }} .rc-editorial__tab-number,
    #rc-editorial-{{ section.id }} .rc-editorial__tab-copy small,
    #rc-editorial-{{ section.id }} .rc-editorial__tab-arrow {
      display: none;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tab.is-active {
      border-color: var(--rc-accent);
      background: var(--rc-accent);
      color: #fff;
    }

    #rc-editorial-{{ section.id }} .rc-editorial__tab-copy strong {
      font-family: inherit;
