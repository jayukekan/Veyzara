{% comment %}

  Riyan Couture Header V14 — Premium Stable Header

  Shopify Dawn compatible

  - Transparent / sticky header

  - Premium desktop mega dropdowns

  - Image menu cards on desktop + mobile

  - Multi-level navigation

  - Premium mobile drawer

{% endcomment %}



{% liquid

  assign header_menu = section.settings.menu
  assign riyan_home_overlay = false
  if request.page_type == 'index' and section.settings.homepage_overlay
    assign riyan_home_overlay = true
  endif

%}



{% if section.settings.logo != blank %}
  <link rel="preload" as="image" href="{{ section.settings.logo | image_url: width: 600 }}" fetchpriority="high">
{% endif %}
{% if section.settings.scrolled_logo != blank and riyan_home_overlay == false %}
  <link rel="preload" as="image" href="{{ section.settings.scrolled_logo | image_url: width: 600 }}" fetchpriority="high">
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Jost:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>

  #shopify-section-{{ section.id }} {

    --pfh-bg: {{ section.settings.solid_background }};
    --pfh-text: {{ section.settings.solid_text }};
    --pfh-transparent-bg: {{ section.settings.transparent_background }};
    --pfh-transparent-text: {{ section.settings.transparent_text }};
    --pfh-accent: {{ section.settings.accent_color }};
    --pfh-border: {{ section.settings.border_color }};
    --pfh-mega-bg: {{ section.settings.mega_background }};
    --pfh-icon-hover: {{ section.settings.icon_hover_background }};

    --pfh-radius: {{ section.settings.menu_radius }}px;

    --pfh-desktop-height: {{ section.settings.desktop_height }}px;

    --pfh-mobile-height: {{ section.settings.mobile_height }}px;

    --pfh-drawer-width: {{ section.settings.drawer_width }}px;
    --pfh-announcement-height: {{ section.settings.announcement_height }}px;
    --pfh-marquee-speed: {{ section.settings.announcement_speed }}s;

    position: relative;

    z-index: 90;

  }



  #shopify-section-{{ section.id }} *,

  #shopify-section-{{ section.id }} *::before,

  #shopify-section-{{ section.id }} *::after { box-sizing: border-box; }



  #shopify-section-{{ section.id }} .pfh-wrapper { position: relative; }



  #shopify-section-{{ section.id }} .pfh-announcement {
    position: {% if section.settings.sticky_header %}fixed{% else %}absolute{% endif %};
    z-index: 10001;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: var(--pfh-announcement-height);
    overflow: hidden;
    background: {{ section.settings.announcement_bg }};
    color: {{ section.settings.announcement_text_color }};
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  #shopify-section-{{ section.id }} .pfh-announcement-track {
    width: max-content;
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    animation: pfhMarquee-{{ section.id }} var(--pfh-marquee-speed) linear infinite;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .pfh-announcement:hover .pfh-announcement-track { animation-play-state: paused; }

  #shopify-section-{{ section.id }} .pfh-announcement-group {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pfh-announcement-item {
    display: inline-flex;
    align-items: center;
    gap: 34px;
    padding: 0 30px;
    color: inherit;
    text-decoration: none;
    font-size: {{ section.settings.announcement_font_size }}px;
    line-height: 1;
    font-weight: 450;
    letter-spacing: .01em;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .pfh-announcement-separator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    font-size: 13px;
    line-height: 1;
    opacity: .92;
  }

  @keyframes pfhMarquee-{{ section.id }} {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(-50%,0,0); }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pfh-announcement-track { animation: none; width: 100%; justify-content: center; }
    #shopify-section-{{ section.id }} .pfh-announcement-group:nth-child(2) { display: none; }
  }

  #shopify-section-{{ section.id }} .pfh-header {

    position: {% if section.settings.sticky_header %}fixed{% else %}absolute{% endif %};

    top: 0;

    left: 0;

    right: 0;

    width: 100%;

    z-index: 9999;

    color: var(--pfh-transparent-text);

    background: {{ section.settings.transparent_background | color_modify: 'alpha', section.settings.transparent_opacity | divided_by: 100.0 }};

    border-bottom: 1px solid {{ section.settings.transparent_border_color | color_modify: 'alpha', section.settings.transparent_border_opacity | divided_by: 100.0 }};

    transition: background .34s cubic-bezier(.2,.7,.2,1), color .3s ease, box-shadow .34s ease, border-color .3s ease, backdrop-filter .3s ease, transform .3s ease;

  }



  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    #shopify-section-{{ section.id }} .pfh-header { top: var(--pfh-announcement-height); }
  {% else %}
    #shopify-section-{{ section.id }} .pfh-header { top: 0; }
  {% endif %}



  #shopify-section-{{ section.id }} .pfh-header.is-solid {
    background: {{ section.settings.solid_background | color_modify: 'alpha', section.settings.solid_opacity | divided_by: 100.0 }};
    color: var(--pfh-text);
    border-bottom-color: var(--pfh-border);
    {% if section.settings.enable_blur %}
      backdrop-filter: blur({{ section.settings.blur_strength }}px);
      -webkit-backdrop-filter: blur({{ section.settings.blur_strength }}px);
    {% endif %}
    {% if section.settings.enable_shadow %}
      box-shadow: 0 12px 34px rgba(20,16,14,{{ section.settings.shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  #shopify-section-{{ section.id }} .pfh-header:not(.is-solid):hover,
  #shopify-section-{{ section.id }} .pfh-header:not(.is-solid).menu-open {
    background: {{ section.settings.menu_open_background | color_modify: 'alpha', section.settings.menu_open_opacity | divided_by: 100.0 }};
    color: var(--pfh-text);
    border-bottom-color: var(--pfh-border);
    {% if section.settings.enable_blur %}
      backdrop-filter: blur({{ section.settings.blur_strength }}px);
      -webkit-backdrop-filter: blur({{ section.settings.blur_strength }}px);
    {% endif %}
  }

  /* Scroll state always takes precedence over hover and menu-open styling. */
  #shopify-section-{{ section.id }} .pfh-header.is-solid,
  #shopify-section-{{ section.id }} .pfh-header.is-solid:hover,
  #shopify-section-{{ section.id }} .pfh-header.is-solid.menu-open {
    background-color: {{ section.settings.solid_background }} !important;
    background-color: {{ section.settings.solid_background | color_modify: 'alpha', section.settings.solid_opacity | divided_by: 100.0 }} !important;
    color: {{ section.settings.solid_text }} !important;
    border-bottom-color: {{ section.settings.border_color }} !important;
  }
  #shopify-section-{{ section.id }} .pfh-header:not(.is-solid):not(:hover):not(.menu-open) {
    background-color: {{ section.settings.transparent_background | color_modify: 'alpha', section.settings.transparent_opacity | divided_by: 100.0 }};
    color: {{ section.settings.transparent_text }};
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pfh-header { transition: none; }
  }

  #shopify-section-{{ section.id }} .pfh-header::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--pfh-accent);
    opacity: .68;
    transform: translateX(-50%);
    transition: width .42s cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .pfh-header.menu-open::after { width: min(100%, {{ section.settings.page_width }}px); }


  #shopify-section-{{ section.id }} .pfh-inner {

    width: 100%;

    max-width: {{ section.settings.page_width }}px;

    min-height: var(--pfh-desktop-height);

    margin: 0 auto;

    padding: 0 {{ section.settings.desktop_side_padding }}px;

    display: grid;

    grid-template-columns: minmax(150px, 240px) minmax(0, 1fr) minmax(150px, 240px);

    align-items: center;

    gap: 24px;
    transition: min-height .3s ease, padding .3s ease;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pfh-header.is-solid .pfh-inner {
      min-height: calc(var(--pfh-desktop-height) - {{ section.settings.scrolled_height_reduction }}px);
    }
  }



  #shopify-section-{{ section.id }} .pfh-nav { grid-column: 2; grid-row: 1; min-width: 0; height: 100%; display: flex; align-items: center; justify-content: center; }

  #shopify-section-{{ section.id }} .pfh-menu { display: flex; align-items: center; gap: {{ section.settings.menu_spacing }}px; margin: 0; padding: 0; list-style: none; }

  #shopify-section-{{ section.id }} .pfh-menu-item { position: static; height: 100%; display: flex; align-items: center; }



  #shopify-section-{{ section.id }} .pfh-menu-link {

    position: relative;

    min-height: var(--pfh-desktop-height);

    display: inline-flex;

    align-items: center;

    gap: 7px;

    color: inherit;

    text-decoration: none;

    font-size: {{ section.settings.menu_font_size }}px;

    line-height: 1;

    font-weight: {{ section.settings.menu_font_weight }};

    letter-spacing: {{ section.settings.menu_letter_spacing }}em;

    {% if section.settings.uppercase_menu %}text-transform: uppercase;{% endif %}

    white-space: nowrap;

  }



  #shopify-section-{{ section.id }} .pfh-menu-link::after {

    content: "";

    position: absolute;

    left: 50%;
    bottom: 14px;
    width: 0;
    height: 1px;
    background: var(--pfh-accent);
    transform: translateX(-50%);
    transition: width .3s cubic-bezier(.2,.7,.2,1);

  }



  #shopify-section-{{ section.id }} .pfh-menu-item:hover > .pfh-menu-link::after,

  #shopify-section-{{ section.id }} .pfh-menu-link[aria-current="page"]::after { width: 100%; }



  #shopify-section-{{ section.id }} .pfh-chevron { width: 12px; height: 12px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform .25s ease; }

  #shopify-section-{{ section.id }} .pfh-menu-item:hover .pfh-chevron { transform: rotate(180deg); }



  #shopify-section-{{ section.id }} .pfh-logo { grid-column: 1; grid-row: 1; justify-self: start; display: flex; align-items: center; justify-content: flex-start; color: inherit; text-decoration: none; line-height: 1; z-index: 3; }

  #shopify-section-{{ section.id }} .pfh-logo img { display: block; width: auto; max-width: {{ section.settings.logo_width }}px; max-height: 70px; object-fit: contain; }

  #shopify-section-{{ section.id }} .pfh-logo-text { color: inherit; font-size: 30px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }



  #shopify-section-{{ section.id }} .pfh-actions { grid-column: 3; grid-row: 1; justify-self: end; display: flex; justify-content: flex-end; align-items: center; gap: {{ section.settings.icon_spacing }}px; }

  #shopify-section-{{ section.id }} .pfh-icon {

    position: relative;

    width: 39px;

    height: 39px;

    padding: 0;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;

    color: inherit;

    text-decoration: none;

    cursor: pointer;

    transition: background .2s ease, transform .2s ease, opacity .2s ease;

  }

  #shopify-section-{{ section.id }} .pfh-icon:hover {
    background: var(--pfh-icon-hover);
    border-color: {{ section.settings.icon_hover_border }};
    transform: translateY(-1px);
  }
  #shopify-section-{{ section.id }} .pfh-header.is-solid .pfh-icon {
    background: {{ section.settings.scrolled_icon_background }};
    border-color: {{ section.settings.scrolled_icon_border }};
  }
  #shopify-section-{{ section.id }} .pfh-header.is-solid .pfh-icon:hover {
    background: var(--pfh-icon-hover);
    border-color: {{ section.settings.icon_hover_border }};
  }

  #shopify-section-{{ section.id }} .pfh-icon svg { width: {{ section.settings.icon_size }}px; height: {{ section.settings.icon_size }}px; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }

  #shopify-section-{{ section.id }} .pfh-cart-count {

    position: absolute;

    top: 0;

    right: -1px;

    min-width: 16px;

    height: 16px;

    padding: 0 4px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 99px;

    background: var(--pfh-accent);

    color: #fff;

    font-size: 9px;

    font-weight: 700;

  }



  /* Desktop mega dropdown â€” editorial fashion mega menu */
  #shopify-section-{{ section.id }} .pfh-mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    padding: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity .22s ease, visibility .22s ease, transform .26s cubic-bezier(.2,.7,.2,1);
  }

  #shopify-section-{{ section.id }} .pfh-menu-item:hover > .pfh-mega,
  #shopify-section-{{ section.id }} .pfh-menu-item:focus-within > .pfh-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .pfh-mega-shell {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: {{ section.settings.mega_padding }}px max({{ section.settings.desktop_side_padding }}px, calc((100vw - {{ section.settings.page_width }}px) / 2 + {{ section.settings.desktop_side_padding }}px));
    background: var(--pfh-mega-bg);
    color: var(--pfh-text);
    border-top: 1px solid rgba(20,20,20,.055);
    border-bottom: 1px solid rgba(20,20,20,.07);
    border-radius: 0;
    box-shadow: 0 24px 50px rgba(28,22,19,.08);
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(420px, .8fr);
    gap: clamp(36px, 4vw, 70px);
    align-items: start;
  }

  #shopify-section-{{ section.id }} .pfh-mega.no-image .pfh-mega-shell { grid-template-columns: 1fr; }

  /* If the Shopify menu has no child links, keep imagery compact instead of stretching full width. */
  #shopify-section-{{ section.id }} .pfh-mega.only-images .pfh-mega-shell {
    grid-template-columns: minmax(0, 1fr) minmax(500px, 620px);
  }
  #shopify-section-{{ section.id }} .pfh-mega.only-images .pfh-mega-links {
    display: flex;
    min-height: 100%;
    align-items: flex-start;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-intro {
    max-width: 390px;
    padding-top: 6px;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-eyebrow {
    display: block;
    margin-bottom: 10px;
    color: var(--pfh-accent);
    font-size: 10px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-title {
    margin: 0 0 12px;
    color: var(--pfh-text);
    font-size: clamp(24px, 2.25vw, 36px);
    line-height: 1.08;
    font-weight: 520;
    letter-spacing: -.025em;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-text {
    margin: 0 0 18px;
    max-width: 330px;
    color: {{ section.settings.submenu_text_color }};
    font-size: 13px;
    line-height: 1.65;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-link,
  #shopify-section-{{ section.id }} .pfh-mega-viewall {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--pfh-text);
    text-decoration: none;
    font-size: 10px;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-link svg,
  #shopify-section-{{ section.id }} .pfh-mega-viewall svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform .2s ease;
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-link:hover svg,
  #shopify-section-{{ section.id }} .pfh-mega-viewall:hover svg { transform: translateX(3px); }

  #shopify-section-{{ section.id }} .pfh-mega-links {
    display: grid;
    grid-template-columns: repeat({{ section.settings.mega_columns }}, minmax(0,1fr));
    gap: 30px clamp(28px, 4vw, 62px);
    align-content: start;
    padding: 3px 0;
  }

  #shopify-section-{{ section.id }} .pfh-mega-group {
    min-width: 0;
    padding-right: 4px;
  }

  #shopify-section-{{ section.id }} .pfh-mega-parent {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--pfh-text);
    text-decoration: none;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 520;
    letter-spacing: .015em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .pfh-mega-parent::after {
    content: "";
    width: 20px;
    height: 1px;
    background: var(--pfh-accent);
    opacity: .65;
  }

  #shopify-section-{{ section.id }} .pfh-mega-sublist { margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .pfh-mega-sublist li + li { margin-top: 11px; }
  #shopify-section-{{ section.id }} .pfh-mega-sublist a {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: {{ section.settings.submenu_text_color }};
    text-decoration: none;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 420;
    letter-spacing: .015em;
    transition: color .2s ease, transform .2s ease;
  }
  #shopify-section-{{ section.id }} .pfh-mega-sublist a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: currentColor;
    opacity: .35;
    transition: width .22s ease;
  }
  #shopify-section-{{ section.id }} .pfh-mega-sublist a:hover { color: var(--pfh-text); transform: translateX(2px); }
  #shopify-section-{{ section.id }} .pfh-mega-sublist a:hover::after { width: 100%; }
  #shopify-section-{{ section.id }} .pfh-mega-viewall { margin-top: 18px; }

  #shopify-section-{{ section.id }} .pfh-promo-grid {
    width: 100%;
    max-width: 620px;
    margin-left: auto;
    display: grid;
    grid-template-columns: repeat({{ section.settings.image_card_columns }}, minmax(0,1fr));
    gap: {{ section.settings.image_card_gap }}px;
    align-self: start;
  }

  #shopify-section-{{ section.id }} .pfh-promo-card {
    position: relative;
    display: block;
    width: 100%;
    height: {{ section.settings.desktop_menu_image_height }}px;
    overflow: hidden;
    border: 1px solid rgba(22,18,16,.075);
    border-radius: {{ section.settings.menu_radius }}px;
    background: #f4f1ed;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    box-shadow: 0 10px 28px rgba(26,20,16,.06);
    transform: translateZ(0);
    transition: transform .32s ease, box-shadow .32s ease, border-color .32s ease;
  }

  #shopify-section-{{ section.id }} .pfh-promo-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,.00) 0%, rgba(0,0,0,.03) 48%, rgba(0,0,0,.70) 100%);
  }
  #shopify-section-{{ section.id }} .pfh-promo-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
  }
  #shopify-section-{{ section.id }} .pfh-promo-card img {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.menu_image_fit }};
    object-position: center {{ section.settings.menu_image_position }};
    transition: transform .72s cubic-bezier(.2,.7,.2,1), filter .35s ease;
  }
  #shopify-section-{{ section.id }} .pfh-promo-card:hover {
    transform: translateY(-5px);
    border-color: rgba(22,18,16,.13);
    box-shadow: 0 16px 34px rgba(26,20,16,.11);
  }
  #shopify-section-{{ section.id }} .pfh-promo-card:hover img { transform: scale(1.045); }

  #shopify-section-{{ section.id }} .pfh-promo-content {
    position: absolute;
    z-index: 2;
    left: 18px;
    right: 18px;
    bottom: 16px;
    text-shadow: 0 2px 14px rgba(0,0,0,.22);
  }
  #shopify-section-{{ section.id }} .pfh-promo-kicker {
    display: block;
    margin-bottom: 6px;
    font-size: 8.5px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    opacity: .9;
  }
  #shopify-section-{{ section.id }} .pfh-promo-title {
    margin: 0;
    font-size: 17px;
    line-height: 1.15;
    font-weight: 540;
    letter-spacing: -.015em;
  }
  #shopify-section-{{ section.id }} .pfh-promo-cta {
    display: inline-flex;
    margin-top: 10px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255,255,255,.82);
    font-size: 9px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 990px) and (max-width: 1240px) {
    #shopify-section-{{ section.id }} .pfh-mega-shell {
      grid-template-columns: minmax(0,1fr) minmax(420px,520px);
      gap: 34px;
      padding-left: 28px;
      padding-right: 28px;
    }
    #shopify-section-{{ section.id }} .pfh-mega-links { gap: 26px 30px; }
    #shopify-section-{{ section.id }} .pfh-promo-grid { gap: 10px; }
  }

  /* Mobile */

  #shopify-section-{{ section.id }} .pfh-mobile-trigger,

