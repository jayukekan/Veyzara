  {% unless riyan_home_overlay %}
    #shopify-section-{{ section.id }} { position: relative !important; height: auto !important; min-height: 0; }
    #shopify-section-{{ section.id }} .pfh-wrapper { display: flow-root; }
    #shopify-section-{{ section.id }} .pfh-header { width: 100%; }
  {% endunless %}


  /* Riyan Couture V13 — final visual system; overrides older inherited styles. */
  #shopify-section-{{ section.id }} {
    --rc-sans: 'Jost', 'Helvetica Neue', Arial, sans-serif;
    --rc-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --rc-rose: #B99385;
    --rc-ease: cubic-bezier(.22,.61,.36,1);
  }
  #shopify-section-{{ section.id }} .pfh-announcement {
    background: {{ section.settings.announcement_bg }};
    color: {{ section.settings.announcement_text_color }};
  }
  #shopify-section-{{ section.id }} .pfh-announcement-item {
    font: 500 15px/1.2 var(--rc-sans);
    letter-spacing: .105em;
  }
  #shopify-section-{{ section.id }} .pfh-inner {
    max-width: {{ section.settings.page_width }}px;
    grid-template-columns: minmax(165px, 250px) minmax(0, 1fr) minmax(165px, 250px);
    column-gap: clamp(16px, 2.8vw, 40px);
  }
  #shopify-section-{{ section.id }} .pfh-menu {
    gap: clamp(22px, 2.65vw, 43px);
  }
  #shopify-section-{{ section.id }} .pfh-menu-link {
    font-family: {% if section.settings.couture_nav_font == 'sans' %}var(--rc-sans){% else %}var(--rc-serif){% endif %};
    font-size: {{ section.settings.couture_nav_size }}px;
    font-weight: {{ section.settings.couture_nav_weight }};
    letter-spacing: {% if section.settings.couture_nav_font == 'sans' %}.055em{% else %}.018em{% endif %};
    line-height: 1.15;
    text-transform: none;
    opacity: 1;
    transition: opacity .22s ease;
  }
  #shopify-section-{{ section.id }} .pfh-menu-link::after {
    bottom: 18px;
    height: 1px;
    background: {{ section.settings.nav_underline_color }};
  }
  #shopify-section-{{ section.id }} .pfh-menu-link:hover {opacity:.85;}
  #shopify-section-{{ section.id }} .pfh-logo-text {
    font-family: var(--rc-serif);
    font-size: clamp(30px, 3vw, 43px);
    font-weight: 600;
    letter-spacing: -.04em;
    text-transform: none;
  }
  #shopify-section-{{ section.id }} .pfh-logo-primary,
  #shopify-section-{{ section.id }} .pfh-logo-scrolled {align-items:center;}
  #shopify-section-{{ section.id }} .pfh-logo-scrolled {display:none;}
  #shopify-section-{{ section.id }} .pfh-header.is-solid .pfh-logo-scrolled,
  #shopify-section-{{ section.id }} .pfh-header.menu-open:not(.is-solid) .pfh-logo-scrolled {display:flex;}
  #shopify-section-{{ section.id }} .pfh-header.is-solid:has(.pfh-logo-scrolled img) .pfh-logo-primary,
  #shopify-section-{{ section.id }} .pfh-header.menu-open:not(.is-solid):has(.pfh-logo-scrolled img) .pfh-logo-primary {display:none;}
  #shopify-section-{{ section.id }} .pfh-actions {gap:clamp(3px, .7vw, 10px);}
  #shopify-section-{{ section.id }} .pfh-header .pfh-icon {
    width:42px;height:42px;border-radius:50%;
    color:inherit !important;
    background:transparent !important;
    border:1px solid transparent !important;
    box-shadow:none !important;
    transition:transform .25s var(--rc-ease), background .25s ease, border-color .25s ease;
  }
  #shopify-section-{{ section.id }} .pfh-header .pfh-icon svg {
    width:{{ section.settings.icon_size }}px;
    height:{{ section.settings.icon_size }}px;
    stroke:currentColor !important;fill:none !important;
    stroke-width:1.6;
  }
  #shopify-section-{{ section.id }} .pfh-header.is-solid .pfh-icon,
  #shopify-section-{{ section.id }} .pfh-header.menu-open .pfh-icon {color:{{ section.settings.solid_text }} !important;}
  #shopify-section-{{ section.id }} .pfh-header .pfh-icon:hover {
    background:rgba(185,147,133,.13) !important;
    border-color:rgba(185,147,133,.28) !important;
    color:inherit !important;
    transform:translateY(-2px);
  }
  #shopify-section-{{ section.id }} .pfh-cart-count {
    background:{{ section.settings.accent_color }};
    color:#fff;font-family:var(--rc-sans);font-weight:700;
  }
  #shopify-section-{{ section.id }} .pfh-mega-shell {
    background:{{ section.settings.mega_background }};
    padding-top:38px;padding-bottom:42px;
    box-shadow:0 25px 60px rgba(46,20,27,.12);
  }
  #shopify-section-{{ section.id }} .pfh-mega-only-title {
    font:600 clamp(32px, 3.2vw, 47px)/1.04 var(--rc-serif);
    letter-spacing:-.035em;
  }
  #shopify-section-{{ section.id }} .pfh-mega-parent {
    font:600 clamp(21px, 1.8vw, 27px)/1.12 var(--rc-serif);
    letter-spacing:-.025em;text-transform:none;
    margin-bottom:17px;
  }
  #shopify-section-{{ section.id }} .pfh-mega-sublist a {
    font:500 13px/1.45 var(--rc-sans);letter-spacing:.025em;
  }
  #shopify-section-{{ section.id }} .pfh-mega-viewall,
  #shopify-section-{{ section.id }} .pfh-mega-only-link {
    font:600 11px/1.2 var(--rc-sans);letter-spacing:.09em;
  }
  #shopify-section-{{ section.id }} .pfh-promo-card {border-radius:3px;}
  #shopify-section-{{ section.id }} .pfh-promo-title {
    font:600 clamp(22px, 2vw, 29px)/1.05 var(--rc-serif);
    letter-spacing:-.025em;
  }
  #shopify-section-{{ section.id }} .pfh-promo-kicker,
  #shopify-section-{{ section.id }} .pfh-promo-cta {
    font-family:var(--rc-sans);font-weight:600;
  }
  #shopify-section-{{ section.id }} .pfh-drawer-title {
    font:600 29px/1.05 var(--rc-serif);letter-spacing:-.025em;
  }
  #shopify-section-{{ section.id }} .pfh-mobile-link {
    font:600 clamp(20px, 5vw, 24px)/1.2 var(--rc-serif);
    letter-spacing:.005em;text-transform:none;
  }
  #shopify-section-{{ section.id }} .pfh-mobile-submenu a {
    font:500 13px/1.45 var(--rc-sans);
  }
  #shopify-section-{{ section.id }} .pfh-mobile-feature-content strong,
  #shopify-section-{{ section.id }} .pfh-mobile-promo strong {
    font-family:var(--rc-serif);font-size:21px;font-weight:600;
  }
  /* Footer menu within the mobile header drawer: visibly heavier, adjustable. */
  #shopify-section-{{ section.id }} .pfh-mobile-footer a,
  #shopify-section-{{ section.id }} .pfh-mobile-footer a span {
    font-family:var(--rc-sans) !important;
    font-weight:{{ section.settings.mobile_footer_weight }} !important;
    font-size:{{ section.settings.mobile_footer_size }}px !important;
    letter-spacing:.025em;
  }
  #shopify-section-{{ section.id }} .pfh-mobile-footer a {
    border-radius:4px;min-height:49px;
    background:rgba(89,28,39,.035);
  }
  #shopify-section-{{ section.id }} .pfh-mobile-footer a:hover {
    border-color:{{ section.settings.accent_color }};
    background:rgba(89,28,39,.065);
  }
  @media screen and (max-width:989px) {
    #shopify-section-{{ section.id }} .pfh-inner {grid-template-columns:1fr auto 1fr;gap:6px;padding:0 12px;}
    #shopify-section-{{ section.id }} .pfh-header .pfh-icon {width:36px;height:40px;}
    #shopify-section-{{ section.id }} .pfh-logo-text {font-size:24px;}
    #shopify-section-{{ section.id }} .pfh-drawer-head {min-height:76px;}
  }
  @media (prefers-reduced-motion:reduce) {
    #shopify-section-{{ section.id }} .pfh-icon,
    #shopify-section-{{ section.id }} .pfh-menu-link {transition:none !important;}
  }


  /* V14 — stable first paint + balanced mobile actions */
  #shopify-section-{{ section.id }} .pfh-header {
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  #shopify-section-{{ section.id }} .pfh-logo { min-width: 0; }
  #shopify-section-{{ section.id }} .pfh-logo img {
    max-inline-size: 100%;
    aspect-ratio: auto;
  }
  #shopify-section-{{ section.id }} .pfh-mobile-wishlist { display: none; }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .pfh-inner {
      grid-template-columns: minmax(82px,1fr) auto minmax(82px,1fr);
      padding-inline: 10px;
    }
    #shopify-section-{{ section.id }} .pfh-mobile-trigger {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 2px;
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .pfh-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 2px;
      min-width: 0;
    }
    #shopify-section-{{ section.id }} .pfh-mobile-wishlist { display: inline-flex; }
    #shopify-section-{{ section.id }} .pfh-wishlist-desktop { display: none !important; }
    #shopify-section-{{ section.id }} .pfh-header .pfh-icon {
      flex: 0 0 38px;
      width: 38px;
      height: 38px;
      min-width: 38px;
    }
    #shopify-section-{{ section.id }} .pfh-logo {
      max-width: min({{ section.settings.mobile_logo_width }}px, 42vw);
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .pfh-logo img {
      width: auto;
      max-width: 100%;
      height: auto;
    }
  }

  @media screen and (max-width: 390px) {
    #shopify-section-{{ section.id }} .pfh-inner {
      grid-template-columns: minmax(76px,1fr) auto minmax(76px,1fr);
      padding-inline: 6px;
    }
    #shopify-section-{{ section.id }} .pfh-header .pfh-icon {
      flex-basis: 35px;
      width: 35px;
      min-width: 35px;
      height: 37px;
    }
  }

  /* Avoid layout/paint flash while the drawer is closed. */
  #shopify-section-{{ section.id }} .pfh-mobile-overlay:not(.is-open) { backdrop-filter: none; -webkit-backdrop-filter: none; }
  #shopify-section-{{ section.id }} .pfh-mobile-drawer:not(.is-open) { visibility: hidden; }
  #shopify-section-{{ section.id }} .pfh-mobile-drawer.is-open { visibility: visible; }

  /* V15 — app-aware wishlist: show exactly one, retaining app badge/state. */
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot { display: inline-flex; align-items:center; justify-content:center; flex:0 0 auto; }
  #shopify-section-{{ section.id }} .pfh-wishlist-mobile-slot { display:none; }
  #shopify-section-{{ section.id }} .pfh-wishlist-desktop-slot { display:inline-flex; }
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot:empty { display:none; }
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot:not(:empty) + .pfh-wishlist-fallback { display:none !important; }
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot > * { position:relative; flex:0 0 auto; margin:0 !important; }
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot a,
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot button { display:inline-flex;align-items:center;justify-content:center;min-width:38px;min-height:38px;padding:0;background:transparent;border:0;color:inherit; }
  #shopify-section-{{ section.id }} .pfh-wishlist-app-slot svg {width:22px;height:22px;}
  @media(max-width:989px) {
    #shopify-section-{{ section.id }} .pfh-wishlist-mobile-slot:not(:empty) { display:inline-flex; }
    #shopify-section-{{ section.id }} .pfh-wishlist-desktop-slot { display:none !important; }
  }
</style>



<div class="pfh-wrapper">

  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="pfh-announcement" role="region" aria-label="Announcement">
      <div class="pfh-announcement-track">
        {% for duplicate in (1..2) %}
          <div class="pfh-announcement-group" {% if duplicate == 2 %}aria-hidden="true"{% endif %}>
            {% for repeat in (1..3) %}
              {% if section.settings.announcement_link != blank %}<a class="pfh-announcement-item" href="{{ section.settings.announcement_link }}">{% else %}<span class="pfh-announcement-item">{% endif %}
                <span>{{ section.settings.announcement_text }}</span>
                <span class="pfh-announcement-separator" aria-hidden="true">✿</span>
                {% if section.settings.announcement_text_2 != blank %}<span>{{ section.settings.announcement_text_2 }}</span><span class="pfh-announcement-separator" aria-hidden="true">✿</span>{% endif %}
              {% if section.settings.announcement_link != blank %}</a>{% else %}</span>{% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}



  <header class="pfh-header{% unless riyan_home_overlay %} is-solid{% endunless %}" data-pfh-header>

    <div class="pfh-inner">

      <nav class="pfh-nav" aria-label="Main navigation">

        {% if header_menu != blank %}

          <ul class="pfh-menu">

            {% for link in header_menu.links %}

              {% liquid

                assign image_count = 0

                for block in section.blocks

                  if block.type == 'menu_image' and block.settings.image != blank

                    assign block_parent_key = block.settings.parent_menu | handleize

                    assign link_title_key = link.title | handleize

                    if block_parent_key == link_title_key

                    assign image_count = image_count | plus: 1

                    endif

                  endif

                endfor

              %}

              <li class="pfh-menu-item">

                <a href="{{ link.url }}" class="pfh-menu-link" {% if link.current %}aria-current="page"{% endif %}>

                  <span>{{ link.title }}</span>

                  {% if link.links != blank or image_count > 0 %}

                    <svg class="pfh-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5L10 12.5L15 7.5"/></svg>

                  {% endif %}

                </a>



                {% if link.links != blank or image_count > 0 %}

                  <div class="pfh-mega {% if image_count == 0 %}no-image{% endif %} {% if link.links == blank %}only-images{% endif %}">

                    <div class="pfh-mega-shell">

                      <div class="pfh-mega-links">

                        {% if link.links == blank and image_count > 0 %}
                          <div class="pfh-mega-only-intro">
                            <span class="pfh-mega-only-eyebrow">Curated collection</span>
                            <p class="pfh-mega-only-title">Explore {{ link.title }}</p>
                            <p class="pfh-mega-only-text">Discover our latest styles, signature edits and new-season favourites.</p>
                            <a href="{{ link.url }}" class="pfh-mega-only-link">
                              <span>View collection</span>
                              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg>
                            </a>
                          </div>
                        {% endif %}

                        {% for childlink in link.links %}

                          <div class="pfh-mega-group">

                            <a href="{{ childlink.url }}" class="pfh-mega-parent">{{ childlink.title }}</a>

                            {% if childlink.links != blank %}

                              <ul class="pfh-mega-sublist">

                                {% for grandchild in childlink.links %}

                                  <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>

                                {% endfor %}

                              </ul>

                              <a href="{{ childlink.url }}" class="pfh-mega-viewall">
                                <span>View all</span>
                                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4"/></svg>
                              </a>

                            {% endif %}

                          </div>

                        {% endfor %}

                      </div>



                      {% if image_count > 0 %}

                        <div class="pfh-promo-grid">

                          {% for block in section.blocks %}

                            {% assign block_parent_key = block.settings.parent_menu | handleize %}

                            {% assign link_title_key = link.title | handleize %}

                            {% if block.type == 'menu_image' and block.settings.image != blank and block_parent_key == link_title_key %}

                              <a class="pfh-promo-card" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ link.url }}{% endif %}" {{ block.shopify_attributes }}>

                                {% assign menu_card_image = block.settings.image %}
                                {% capture menu_card_style %}object-position: center {{ block.settings.image_position }};{% endcapture %}
                                {{ menu_card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 900', alt: block.settings.title, style: menu_card_style }}

                                <div class="pfh-promo-content">

                                  {% if block.settings.kicker != blank %}<span class="pfh-promo-kicker">{{ block.settings.kicker }}</span>{% endif %}

                                  {% if block.settings.title != blank %}<p class="pfh-promo-title">{{ block.settings.title }}</p>{% endif %}

                                  {% if block.settings.cta != blank %}<span class="pfh-promo-cta">{{ block.settings.cta }}</span>{% endif %}

                                </div>

                              </a>

                            {% endif %}

                          {% endfor %}

                        </div>

                      {% endif %}

                    </div>

                  </div>

                {% endif %}

              </li>

            {% endfor %}

          </ul>

        {% endif %}

      </nav>



      <div class="pfh-mobile-trigger">

        <button type="button" class="pfh-icon pfh-menu-button" data-pfh-open aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        </button>

        {% if section.settings.show_wishlist %}
          <span class="pfh-wishlist-app-slot pfh-wishlist-mobile-slot" data-pfh-wishlist-mobile></span>
          <a
            href="{% if section.settings.wishlist_url != blank %}{{ section.settings.wishlist_url }}{% else %}/pages/wishlist{% endif %}"
            class="pfh-icon pfh-mobile-wishlist pfh-wishlist-fallback"
            aria-label="Wishlist"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.9a5.4 5.4 0 0 0-7.6 0L12 6.1l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.6z"/></svg>
          </a>
        {% endif %}

      </div>



      <a href="{{ routes.root_url }}" class="pfh-logo" aria-label="{{ shop.name | escape }}">

        {% if section.settings.logo != blank %}

          <span class="pfh-logo-primary">{{ section.settings.logo | image_url: width: 600 | image_tag: loading: 'eager', widths: '100,150,200,250,300,400,500,600', alt: shop.name }}</span>
          {% if section.settings.scrolled_logo != blank %}
            <span class="pfh-logo-scrolled">{{ section.settings.scrolled_logo | image_url: width: 600 | image_tag: loading: 'eager', widths: '100,150,200,250,300,400,500,600', alt: shop.name }}</span>
          {% endif %}

        {% else %}

          <span class="pfh-logo-text">{{ shop.name }}</span>

        {% endif %}

      </a>



      <div class="pfh-actions">

        {% if section.settings.show_search %}

          <a href="{{ routes.search_url }}" class="pfh-icon pfh-search-button" aria-label="Search">

            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>

          </a>

        {% endif %}



        {% if shop.customer_accounts_enabled and section.settings.show_account %}

          <a href="{{ routes.account_url }}" class="pfh-icon pfh-account-desktop" aria-label="Account">

            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c.7-4 3.2-6 7-6s6.3 2 7 6"/></svg>

          </a>

        {% endif %}



        {% if section.settings.show_wishlist %}
          <span class="pfh-wishlist-app-slot pfh-wishlist-desktop-slot" data-pfh-wishlist-desktop></span>
          <a
            href="{% if section.settings.wishlist_url != blank %}{{ section.settings.wishlist_url }}{% else %}/pages/wishlist{% endif %}"
            class="pfh-icon pfh-wishlist-desktop pfh-wishlist-fallback"
            aria-label="Wishlist"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.9a5.4 5.4 0 0 0-7.6 0L12 6.1l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.5a5.4 5.4 0 0 0 0-7.6z"/></svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}

          <a href="{{ routes.cart_url }}" id="cart-icon-bubble" class="pfh-icon" aria-label="Cart">

            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l1 12h-13l1-12z"/><path d="M9 9V6.5a3 3 0 016 0V9"/></svg>

            {% if cart.item_count > 0 %}<span class="pfh-cart-count">{% if cart.item_count < 100 %}{{ cart.item_count }}{% else %}99+{% endif %}</span>{% endif %}

          </a>

        {% endif %}

      </div>

    </div>

  </header>



  <div class="pfh-mobile-overlay" data-pfh-overlay aria-hidden="true"></div>



  <aside class="pfh-mobile-drawer" data-pfh-drawer aria-hidden="true">

    <div class="pfh-drawer-head">

      <div class="pfh-drawer-brand">

        {% if section.settings.mobile_menu_eyebrow != blank %}<p class="pfh-drawer-eyebrow">{{ section.settings.mobile_menu_eyebrow }}</p>{% endif %}

        <p class="pfh-drawer-title">{{ section.settings.mobile_menu_heading }}</p>

      </div>

      <button type="button" class="pfh-close" data-pfh-close aria-label="Close menu">

        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5L19 19M19 5L5 19" stroke="currentColor" stroke-width="1.5"/></svg>

      </button>

    </div>



    <div class="pfh-drawer-scroll">

      {% if section.settings.mobile_feature_image != blank %}

        <a class="pfh-mobile-feature" href="{% if section.settings.mobile_feature_link != blank %}{{ section.settings.mobile_feature_link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">

          {{ section.settings.mobile_feature_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: section.settings.mobile_feature_title }}

          <div class="pfh-mobile-feature-content">

            {% if section.settings.mobile_feature_kicker != blank %}<small>{{ section.settings.mobile_feature_kicker }}</small>{% endif %}

            {% if section.settings.mobile_feature_title != blank %}<strong>{{ section.settings.mobile_feature_title }}</strong>{% endif %}

          </div>

        </a>

      {% endif %}



      <nav class="pfh-mobile-menu" aria-label="Mobile navigation">

        {% if header_menu != blank %}

          <ul>

            {% for link in header_menu.links %}

              {% liquid

                assign mobile_image_count = 0

                for block in section.blocks

                  if block.type == 'menu_image' and block.settings.image != blank

                    assign block_parent_key = block.settings.parent_menu | handleize

                    assign link_title_key = link.title | handleize

                    if block_parent_key == link_title_key

                    assign mobile_image_count = mobile_image_count | plus: 1

                    endif

                  endif

                endfor

              %}

              <li>

                <div class="pfh-mobile-row">

                  <a href="{{ link.url }}" class="pfh-mobile-link">{{ link.title }}</a>

                  {% if link.links != blank or mobile_image_count > 0 %}

                    <button type="button" class="pfh-sub-toggle" aria-label="Toggle {{ link.title | escape }} submenu" aria-expanded="false">

                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5L10 12.5L15 7.5"/></svg>

                    </button>

                  {% endif %}

                </div>



                {% if link.links != blank or mobile_image_count > 0 %}

                  <div class="pfh-mobile-submenu">

                    <ul>

                      {% for childlink in link.links %}

                        <li>

                          <a href="{{ childlink.url }}">{{ childlink.title }}</a>

                          {% if childlink.links != blank %}

                            <ul class="pfh-mobile-grand">

                              {% for grandchild in childlink.links %}

                                <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>

                              {% endfor %}

                            </ul>

                          {% endif %}

                        </li>

                      {% endfor %}

                    </ul>



                    {% if mobile_image_count > 0 %}

                      <div class="pfh-mobile-images">

                        {% for block in section.blocks %}

                          {% assign block_parent_key = block.settings.parent_menu | handleize %}

                          {% assign link_title_key = link.title | handleize %}

                          {% if block.type == 'menu_image' and block.settings.image != blank and block_parent_key == link_title_key %}

                            <a class="pfh-mobile-promo" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ link.url }}{% endif %}" {{ block.shopify_attributes }}>

                              {% assign menu_card_mobile_image = block.settings.mobile_image | default: block.settings.image %}
                              {% capture menu_card_mobile_style %}object-position: center {{ block.settings.image_position }};{% endcapture %}
                              {{ menu_card_mobile_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', alt: block.settings.title, style: menu_card_mobile_style }}

                              <span>

                                {% if block.settings.kicker != blank %}<small>{{ block.settings.kicker }}</small>{% endif %}

                                {% if block.settings.title != blank %}<strong>{{ block.settings.title }}</strong>{% endif %}

                                {% if block.settings.cta != blank %}<em>{{ block.settings.cta }}</em>{% endif %}

                              </span>

                            </a>

                          {% endif %}

                        {% endfor %}

                      </div>

                    {% endif %}

                  </div>

                {% endif %}

              </li>

            {% endfor %}

          </ul>

        {% endif %}

      </nav>

    </div>



    <div class="pfh-mobile-footer">

      <div class="pfh-mobile-footer-grid">

        {% if shop.customer_accounts_enabled %}

          <a href="{{ routes.account_url }}">

            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c.7-4 3.2-6 7-6s6.3 2 7 6"/></svg>

            <span>{% if customer %}My account{% else %}Login{% endif %}</span>

          </a>

        {% endif %}

        <a href="{{ routes.search_url }}">

          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4 4"/></svg>

          <span>Search</span>

        </a>

      </div>

    </div>

  </aside>

</div>



<script>

(function(){

  const section = document.querySelector('#shopify-section-{{ section.id }}');

  if (!section) return;



  const header = section.querySelector('[data-pfh-header]');

  const drawer = section.querySelector('[data-pfh-drawer]');

  const overlay = section.querySelector('[data-pfh-overlay]');

  const openBtn = section.querySelector('[data-pfh-open]');

  const closeBtn = section.querySelector('[data-pfh-close]');
  const megaItems = section.querySelectorAll('.pfh-menu-item');

  megaItems.forEach((item) => {
    if (!item.querySelector('.pfh-mega')) return;
    item.addEventListener('mouseenter', () => header && header.classList.add('menu-open'));
    item.addEventListener('mouseleave', () => header && header.classList.remove('menu-open'));
    item.addEventListener('focusin', () => header && header.classList.add('menu-open'));
    item.addEventListener('focusout', (event) => {
      if (!item.contains(event.relatedTarget)) header && header.classList.remove('menu-open');
    });
  });



  const setHeaderState = () => {
    if (!header) return;
    const scrollTop = Math.max(
      window.pageYOffset || 0,
      document.documentElement.scrollTop || 0,
      document.body.scrollTop || 0
    );
    const isScrolled = {{ riyan_home_overlay | json }} === false || scrollTop > {{ section.settings.scroll_trigger }};
    header.classList.toggle('is-solid', isScrolled);
    header.dataset.scrollState = isScrolled ? 'solid' : 'transparent';
  };




  /* Keep the wishlist app's original icon (and counter), instead of drawing a second icon.
     Many Shopify wishlist apps inject their own heart after page load. */
  const wishlistMobileSlot = section.querySelector('[data-pfh-wishlist-mobile]');
  const wishlistDesktopSlot = section.querySelector('[data-pfh-wishlist-desktop]');
  const wishEnabled = {{ section.settings.show_wishlist | json }};
  let wishlistOrigin = null;
  let managedWishlist = null;
  const wishlistSelectors = [
    '.header__icon--wishlist',
    '[data-wishlist-icon]',
    '.swym-wishlist',
    '.swym-wishlist-icon',
    '.wk-icon',
    '.iwishHeader',
    'a[href*="/pages/wishlist"]',
    'a[href*="/apps/wishlist"]'
  ].join(',');
  const relocateWishlist = () => {
    if (!wishEnabled || !wishlistMobileSlot || !wishlistDesktopSlot) return;
    const all = [...section.querySelectorAll(wishlistSelectors)];
    const item = managedWishlist?.isConnected ? managedWishlist : all.find(el =>
      !el.matches('.pfh-wishlist-fallback') &&
      !el.closest('.pfh-mobile-drawer') &&
      !el.closest('.pfh-mega') &&
      !el.closest('.pfh-wishlist-app-slot')
    );
    if (!item) return;
    managedWishlist = item;
    if (!wishlistOrigin) {
      wishlistOrigin = document.createComment('Original wishlist position');
      item.parentNode.insertBefore(wishlistOrigin, item);
    }
    const target = window.innerWidth <= 989 ? wishlistMobileSlot : wishlistDesktopSlot;
    if (item.parentNode !== target) target.appendChild(item);
  };
  relocateWishlist();
  const wishObserver = new MutationObserver(() => relocateWishlist());
  wishObserver.observe(section, {childList:true,subtree:true});
  window.addEventListener('resize', relocateWishlist, {passive:true});
  document.addEventListener('shopify:section:unload', (event) => {
    if (event.target !== section) return;
    wishObserver.disconnect();
  });

  const openDrawer = () => {

    if (!drawer || !overlay) return;

    drawer.classList.add('is-open');

    overlay.classList.add('is-open');

    drawer.setAttribute('aria-hidden','false');

    overlay.setAttribute('aria-hidden','false');

    if (openBtn) openBtn.setAttribute('aria-expanded','true');

    document.documentElement.style.overflow = 'hidden';

  };



  const closeDrawer = () => {

    if (!drawer || !overlay) return;

    drawer.classList.remove('is-open');

    overlay.classList.remove('is-open');

    drawer.setAttribute('aria-hidden','true');

    overlay.setAttribute('aria-hidden','true');

    if (openBtn) openBtn.setAttribute('aria-expanded','false');

    document.documentElement.style.overflow = '';

  };



  setHeaderState();

  let pfhScrollTicking = false;
  const requestHeaderState = () => {
    if (pfhScrollTicking) return;
    pfhScrollTicking = true;
    window.requestAnimationFrame(() => {
      setHeaderState();
      pfhScrollTicking = false;
    });
  };

  window.addEventListener('scroll', requestHeaderState, {passive:true});
  window.addEventListener('pageshow', setHeaderState);
  document.addEventListener('shopify:section:load', setHeaderState);
  document.addEventListener('shopify:section:select', setHeaderState);

  if (openBtn) openBtn.addEventListener('click', openDrawer);

  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

  if (overlay) overlay.addEventListener('click', closeDrawer);



  section.querySelectorAll('.pfh-sub-toggle').forEach((button) => {

    button.addEventListener('click', () => {

      const row = button.closest('.pfh-mobile-row');

      const submenu = row ? row.nextElementSibling : null;

      if (!submenu || !submenu.classList.contains('pfh-mobile-submenu')) return;



      const willOpen = !submenu.classList.contains('is-open');



      if ({{ section.settings.mobile_one_open | json }}) {

        section.querySelectorAll('.pfh-mobile-submenu.is-open').forEach((other) => {

          if (other !== submenu) {

            other.classList.remove('is-open');

            const otherBtn = other.previousElementSibling?.querySelector('.pfh-sub-toggle');

            if (otherBtn) {

              otherBtn.classList.remove('is-open');

              otherBtn.setAttribute('aria-expanded','false');

            }

          }

        });

      }



      submenu.classList.toggle('is-open', willOpen);

      button.classList.toggle('is-open', willOpen);

      button.setAttribute('aria-expanded', willOpen ? 'true' : 'false');

    });

  });



  document.addEventListener('keydown', (event) => {

    if (event.key === 'Escape') closeDrawer();

  });



  window.addEventListener('resize', () => {

    if (window.innerWidth > 989) closeDrawer();

  });

})();

</script>



