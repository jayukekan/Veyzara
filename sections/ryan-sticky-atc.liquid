{% if request.page_type == 'product' and product != blank %}
{% assign ry_variant = product.selected_or_first_available_variant %}
<div id="ry-sticky-{{ section.id }}" class="ry-sticky" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}" data-initial-id="{{ ry_variant.id }}" data-money-format="{{ shop.money_format | escape }}" hidden>
  <div class="ry-sticky__inner">
    <div class="ry-sticky__info">
      {% if section.settings.show_image %}
        <div class="ry-sticky__image">
          {% assign ry_image = ry_variant.featured_image | default: product.featured_image %}
          {% if ry_image %}<img src="{{ ry_image | image_url: width: 160 }}" width="56" height="68" alt="{{ product.title | escape }}" loading="lazy">{% endif %}
        </div>
      {% endif %}
      <div class="ry-sticky__meta">
        <div class="ry-sticky__title">{{ product.title | escape }}</div>
        <div class="ry-sticky__prices"><strong data-ry-price>{{ ry_variant.price | money }}</strong><del data-ry-compare {% unless ry_variant.compare_at_price > ry_variant.price %}hidden{% endunless %}>{{ ry_variant.compare_at_price | money }}</del><span class="ry-sticky__option" data-ry-option>{% unless product.has_only_default_variant %}{{ ry_variant.title | escape }}{% endunless %}</span></div>
      </div>
    </div>
    <button class="ry-sticky__button" type="button" data-ry-action {% unless ry_variant.available %}disabled{% endunless %}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m13 2-8 12h7l-1 8 8-12h-7l1-8Z"/></svg><span data-ry-label>{% if ry_variant.available %}{{ section.settings.button_text | escape }}{% else %}Sold out{% endif %}</span><span class="ry-sticky__arrow" aria-hidden="true">→</span></button>
  </div>
  {% if section.settings.show_trust %}<div class="ry-sticky__trust">✦ {{ section.settings.trust_text | escape }}</div>{% endif %}
  <script type="application/json" data-ry-variants>{{ product.variants | json }}</script>
</div>
{% style %}
{{ section.settings.title_font | font_face: font_display: 'swap' }}
{{ section.settings.body_font | font_face: font_display: 'swap' }}
{% endstyle %}
<style>
#ry-sticky-{{ section.id }}{
  --ry-wine:{{ section.settings.accent }};--ry-gold:{{ section.settings.gold }};
  --ry-bg:{{ section.settings.background }};
  position:fixed;inset:auto 0 0;z-index:{{ section.settings.z_index }};
  background:var(--ry-bg);color:#33272A;
  border-top:1px solid #e4d5c7;
  box-shadow:0 -18px 55px rgba(44,20,25,.13),0 -1px 0 rgba(255,255,255,.85) inset;
  transform:translateY(110%);opacity:0;visibility:hidden;pointer-events:none;
  transition:transform .48s cubic-bezier(.16,1,.3,1),opacity .4s ease,visibility .4s ease;
  font-family:{{ section.settings.body_font.family | json }},Arial,sans-serif;
}
#ry-sticky-{{ section.id }}[hidden]{display:none!important}
#ry-sticky-{{ section.id }}.is-visible{transform:translateY(0);opacity:1;visibility:visible;pointer-events:auto}
#ry-sticky-{{ section.id }} *,#ry-sticky-{{ section.id }} *::before,#ry-sticky-{{ section.id }} *::after{box-sizing:border-box}
#ry-sticky-{{ section.id }}::before{content:"";position:absolute;top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,transparent,var(--ry-gold) 30%,#ead5b5 50%,var(--ry-gold) 70%,transparent);opacity:.8}
#ry-sticky-{{ section.id }} .ry-sticky__inner{max-width:1360px;margin:0 auto;padding:12px 30px;display:flex;align-items:center;gap:17px}
#ry-sticky-{{ section.id }} .ry-sticky__monogram{height:46px;width:46px;display:grid;place-items:center;flex-shrink:0;border:1px solid #dfc9b2;border-radius:50%;font-family:Georgia,'Times New Roman',serif;font-size:17px;letter-spacing:-1px;color:var(--ry-wine);background:#fbf6f0}
#ry-sticky-{{ section.id }} .ry-sticky__monogram span{color:var(--ry-gold);margin:0 1px}
#ry-sticky-{{ section.id }} .ry-sticky__info{flex:1;min-width:0;display:flex;align-items:center;gap:12px}
#ry-sticky-{{ section.id }} .ry-sticky__image{height:63px;width:52px;flex-shrink:0;overflow:hidden;border-radius:2px;background:#f6efe9;border:1px solid #e8ddd4}
#ry-sticky-{{ section.id }} .ry-sticky__image img{height:100%;width:100%;object-fit:cover;display:block}
#ry-sticky-{{ section.id }} .ry-sticky__meta{min-width:0;flex:1}
#ry-sticky-{{ section.id }} .ry-sticky__eyebrow{display:block;margin-bottom:3px;font-size:9px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:#a07b57}
#ry-sticky-{{ section.id }} .ry-sticky__title{font-family:{{ section.settings.title_font.family | json }},Georgia,serif;font-size:{{ section.settings.title_size }}px;line-height:1.25;font-weight:500;letter-spacing:.15px;color:#37232b;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;max-width:580px}
#ry-sticky-{{ section.id }} .ry-sticky__prices{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:5px;color:#8d8180;font-size:11px}
#ry-sticky-{{ section.id }} [data-ry-price]{font-family:{{ section.settings.body_font.family | json }},Arial,sans-serif;color:var(--ry-wine);font-size:17px;line-height:1.3;font-weight:750;letter-spacing:.05px}
#ry-sticky-{{ section.id }} [data-ry-compare]{font-size:12px;color:#a89a98;text-decoration-thickness:1px}
#ry-sticky-{{ section.id }} [data-ry-compare][hidden]{display:none}
#ry-sticky-{{ section.id }} .ry-sticky__option{max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:3px 8px;border:1px solid #e8d9cf;background:#fbf7f3;color:#785b54;font-size:10px;line-height:1.4;border-radius:2px}
#ry-sticky-{{ section.id }} .ry-sticky__option:empty{display:none}
#ry-sticky-{{ section.id }} .ry-sticky__button{position:relative;min-width:250px;min-height:53px;display:flex;justify-content:center;align-items:center;gap:13px;padding:13px 22px;background:var(--ry-wine);border:1px solid var(--ry-wine);border-radius:3px;color:#fff;cursor:pointer;overflow:hidden;isolation:isolate;font-family:{{ section.settings.body_font.family | json }},Arial,sans-serif;font-size:12px;font-weight:650;letter-spacing:1.6px;text-transform:uppercase;box-shadow:0 4px 16px rgba(89,28,39,.13);transition:background .28s,transform .28s,box-shadow .28s}
#ry-sticky-{{ section.id }} .ry-sticky__button:hover:not(:disabled){background:#72313f;transform:translateY(-1px);box-shadow:0 7px 23px rgba(89,28,39,.2)}
#ry-sticky-{{ section.id }} .ry-sticky__button:focus-visible{outline:2px solid var(--ry-gold);outline-offset:3px}
#ry-sticky-{{ section.id }} .ry-sticky__button:disabled{background:#9a8788;border-color:#9a8788;cursor:not-allowed;box-shadow:none}
#ry-sticky-{{ section.id }} .ry-sticky__button svg{flex-shrink:0}
#ry-sticky-{{ section.id }} .ry-sticky__arrow{font-size:19px;line-height:1;color:#e5c7a5;font-family:Georgia,serif;transition:transform .2s}
#ry-sticky-{{ section.id }} .ry-sticky__button:hover .ry-sticky__arrow{transform:translateX(4px)}
#ry-sticky-{{ section.id }} .ry-sticky__trust{border-top:1px solid #f0e9e2;background:#fbf8f5;text-align:center;font-size:10px;letter-spacing:1px;color:#836c62;padding:7px 12px}

/* Editorial microinteractions */
#ry-sticky-{{ section.id }} .ry-sticky__button::before{content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 25%,rgba(255,255,255,.18) 48%,transparent 70%);transform:translateX(-150%);pointer-events:none;z-index:-1}
#ry-sticky-{{ section.id }} .ry-sticky__button:hover:not(:disabled)::before{animation:ry-shine-{{ section.id }} .85s ease-out 1}
#ry-sticky-{{ section.id }} .ry-sticky__image img{transition:transform .6s cubic-bezier(.2,.8,.2,1)}
#ry-sticky-{{ section.id }} .ry-sticky__image:hover img{transform:scale(1.09)}
#ry-sticky-{{ section.id }}.is-visible .ry-sticky__image{animation:ry-rise-{{ section.id }} .55s .1s both}
#ry-sticky-{{ section.id }}.is-visible .ry-sticky__meta{animation:ry-rise-{{ section.id }} .58s .16s both}
#ry-sticky-{{ section.id }}.is-visible .ry-sticky__button{animation:ry-rise-{{ section.id }} .58s .22s both}
#ry-sticky-{{ section.id }} .ry-sticky__option{transition:border-color .2s,background .2s}
#ry-sticky-{{ section.id }} .ry-sticky__option:not(:empty){border-color:#dfcbb7;background:linear-gradient(135deg,#fffaf5,#f8f0e9)}
@keyframes ry-rise-{{ section.id }}{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:translateY(0)}}
@keyframes ry-shine-{{ section.id }}{from{transform:translateX(-150%)}to{transform:translateX(150%)}}

@media(max-width:749px){
#ry-sticky-{{ section.id }} .ry-sticky__inner{padding:10px 12px;gap:0}
#ry-sticky-{{ section.id }} .ry-sticky__monogram{display:none}
#ry-sticky-{{ section.id }} .ry-sticky__info{display:none}
#ry-sticky-{{ section.id }} .ry-sticky__image{height:47px;width:38px}
#ry-sticky-{{ section.id }} .ry-sticky__eyebrow{font-size:7px;letter-spacing:1.1px;margin-bottom:2px}
#ry-sticky-{{ section.id }} .ry-sticky__title{font-size:13px;max-width:100%}
#ry-sticky-{{ section.id }} .ry-sticky__prices{gap:5px;margin-top:3px;font-size:9px}
#ry-sticky-{{ section.id }} [data-ry-price]{font-size:13px}
#ry-sticky-{{ section.id }} [data-ry-compare]{font-size:10px}
#ry-sticky-{{ section.id }} .ry-sticky__option{max-width:82px;font-size:8px;padding:2px 5px}
#ry-sticky-{{ section.id }} .ry-sticky__button{width:100%;min-width:0;min-height:50px;padding:12px 16px;gap:8px;border-radius:7px;font-size:12px;letter-spacing:1px}
#ry-sticky-{{ section.id }} .ry-sticky__button svg{width:15px;height:15px}
#ry-sticky-{{ section.id }} .ry-sticky__arrow{display:none}
#ry-sticky-{{ section.id }} .ry-sticky__trust{display:none}
}
@media(max-width:360px){#ry-sticky-{{ section.id }} .ry-sticky__button{font-size:11px}}
@media(prefers-reduced-motion:reduce){#ry-sticky-{{ section.id }},#ry-sticky-{{ section.id }} .ry-sticky__button,#ry-sticky-{{ section.id }} .ry-sticky__image img{transition:none}#ry-sticky-{{ section.id }}.is-visible .ry-sticky__image,#ry-sticky-{{ section.id }}.is-visible .ry-sticky__meta,#ry-sticky-{{ section.id }}.is-visible .ry-sticky__button,#ry-sticky-{{ section.id }} .ry-sticky__button:hover::before{animation:none}}
</style>
<script>
(function(){
  const id='ry-sticky-{{ section.id }}';
  function init(){
    const bar=document.getElementById(id);if(!bar||bar.dataset.ready==='1')return;
    const variants=JSON.parse(bar.querySelector('[data-ry-variants]').textContent);
    const price=bar.querySelector('[data-ry-price]'),compare=bar.querySelector('[data-ry-compare]'),option=bar.querySelector('[data-ry-option]'),image=bar.querySelector('.ry-sticky__image img'),button=bar.querySelector('[data-ry-action]'),label=bar.querySelector('[data-ry-label]');
    const productId=String(bar.dataset.productId),initial=String(bar.dataset.initialId),moneyFormat=bar.dataset.moneyFormat;
    const buttonText={{ section.settings.button_text | json }};
    let form=null,mainButton=null,buyNowButton=null,observer=null,visible=true,currentId=initial,lastVariant=null,refreshFrame=0;
    function findForm(){
      const selectors=['product-info form[action*="/cart/add"]','[id^="MainProduct-"] form[action*="/cart/add"]','[id^="ProductInfo-"] form[action*="/cart/add"]','.product__info-container form[action*="/cart/add"]','form[id^="product-form-"]'];
      for(const selector of selectors){for(const f of document.querySelectorAll(selector)){if(!f.closest('.quick-add-modal,dialog,[role="dialog"],.ry-sticky')&&f.querySelector('[name="id"]')&&f.querySelector('[type="submit"]'))return f;}}
      return null;
    }
    function getMainButton(f){return f&&f.querySelector('button[type="submit"][name="add"],button[type="submit"],input[type="submit"]')}
    function getBuyNowButton(f){return f&&f.querySelector('.gokwik-buy-now:not([hidden]),.shopify-payment-button__button,.shopify-payment-button [role="button"]')}
    function money(cents){if(window.Shopify&&typeof Shopify.formatMoney==='function'){try{return Shopify.formatMoney(cents,moneyFormat)}catch(e){}}return new Intl.NumberFormat('en-IN',{style:'currency',currency:{{ cart.currency.iso_code | default: 'INR' | json }}}).format(cents/100)}
    function selectedId(){const el=form&&form.querySelector('[name="id"]');if(el&&el.value)return String(el.value);return new URLSearchParams(location.search).get('variant')||currentId}
    function update(){const v=variants.find(x=>String(x.id)===selectedId());if(!v){button.disabled=false;label.textContent='Select options';lastVariant=null;return}lastVariant=v;currentId=String(v.id);price.textContent=money(v.price);compare.hidden=!(v.compare_at_price>v.price);if(!compare.hidden)compare.textContent=money(v.compare_at_price);if(option)option.textContent=v.title==='Default Title'?'':v.title;const src=v.featured_image&&v.featured_image.src;if(src&&image&&image.dataset.variantSrc!==src){image.src=src;image.dataset.variantSrc=src}button.disabled=!v.available;label.textContent=v.available?buttonText:'Sold out'}
    function queueUpdate(){cancelAnimationFrame(refreshFrame);refreshFrame=requestAnimationFrame(update)}
    function show(){if(!mainButton){bar.classList.remove('is-visible');return;}const r=mainButton.getBoundingClientRect();visible=r.bottom>0&&r.top<innerHeight;bar.classList.toggle('is-visible',!visible&&scrollY>{{ section.settings.scroll_threshold }})}
    function bind(){const f=findForm();if(!f){bar.classList.remove('is-visible');return}const b=getMainButton(f),buy=getBuyNowButton(f);if(f!==form||b!==mainButton){form=f;mainButton=b;if(observer)observer.disconnect();if(mainButton&&'IntersectionObserver'in window){observer=new IntersectionObserver(show,{threshold:0});observer.observe(mainButton)}}buyNowButton=buy;queueUpdate();show()}
    async function fallbackBuyNow(){const root=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';const original=label.textContent;button.disabled=true;label.textContent='Processing…';try{const response=await fetch(root+'cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:new FormData(form)});if(!response.ok)throw new Error('Unable to start checkout');window.location.assign(root+'checkout')}catch(error){button.disabled=false;label.textContent=original;form.scrollIntoView({behavior:'smooth',block:'center'})}}
    button.addEventListener('click',function(){bind();if(!form||!mainButton)return;update();if(!lastVariant||!lastVariant.available||mainButton.disabled||mainButton.getAttribute('aria-disabled')==='true'){form.scrollIntoView({behavior:'smooth',block:'center'});return}if(buyNowButton&&!buyNowButton.disabled&&buyNowButton.getAttribute('aria-disabled')!=='true'&&!buyNowButton.classList.contains('disabled')){buyNowButton.click();return}fallbackBuyNow()});
    document.addEventListener('change',function(e){if(form&&(form.contains(e.target)||e.target.closest('variant-selects,variant-radios'))){setTimeout(update,0);setTimeout(update,120)}});
    document.addEventListener('input',function(e){if(form&&form.contains(e.target))setTimeout(update,0)});
    document.addEventListener('variant:change',queueUpdate);document.addEventListener('product:variant-change',queueUpdate);
    window.addEventListener('popstate',queueUpdate);window.addEventListener('scroll',show,{passive:true});window.addEventListener('resize',show);
    document.body.appendChild(bar);bar.hidden=false;bar.dataset.ready='1';bind();setTimeout(bind,500);
    document.addEventListener('shopify:section:load',function(){setTimeout(bind,100)});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
{% endif %}
{% schema %}
{
  "name": "Riyan Luxury Sticky",
  "tag": "section",
  "class": "section-ry-sticky-cart",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type":"header","content":"Luxury design"},
    {"type":"font_picker","id":"title_font","label":"Product title font","default":"playfair_display_n4"},
    {"type":"font_picker","id":"body_font","label":"Details and button font","default":"assistant_n4"},
    {"type":"range","id":"title_size","label":"Desktop title size","min":13,"max":23,"step":1,"default":17},
    {"type":"color","id":"accent","label":"Button and price color","default":"#591C27"},
    {"type":"color","id":"gold","label":"Accent color","default":"#B39170"},
    {"type":"color","id":"background","label":"Bar background","default":"#FFFFFF"},
    {"type":"text","id":"button_text","label":"Button text","default":"Buy Now"},
    {"type":"checkbox","id":"show_image","label":"Show product image","default":true},
    {"type":"checkbox","id":"show_trust","label":"Show trust message","default":false},
    {"type":"text","id":"trust_text","label":"Trust message","default":"Secure checkout • Crafted for elegance"},
    {"type":"header","content":"Behavior"},
    {"type":"range","id":"scroll_threshold","label":"Minimum scroll (px)","min":0,"max":600,"step":25,"default":200},
    {"type":"range","id":"z_index","label":"Layer priority","min":100,"max":1000,"step":50,"default":900}
  ],
  "presets": [{"name":"Riyan Luxury Sticky"}]
}
{% endschema %}
