{%- capture sp_media_grid_css -%}
<style>
  #sp-{{ section.id }}.sp-media-section {padding: {{ section.settings.padding_top }}px 0 {{section.settings.padding_bottom}}px 0;background: {{section.settings.bg_color}};}   
  #sp-{{ section.id }} .sp-page-width {max-width: {{ section.settings.section_max_width }}px;width: 100%;padding: 0 20px;margin: 0 auto;}
  #sp-{{ section.id }} .sp-page-width.sp-full-page-width {max-width:100%;}
  #sp-{{ section.id }} .sp-media-grid {display: grid;align-items: center;gap: {{ section.settings.grid_gap }}px;position: relative;z-index: 2;}
  #sp-{{ section.id }} .sp-media-grid-item {position: relative;padding: 0;height: 100%;overflow: hidden;border-radius: {{ section.settings.media_radius }}px;transition: .25s all ease;box-shadow: 0 0 5px 0 rgba(0, 0, 0, 0.20);}
  #sp-{{ section.id }} .sp-media-img {position: relative;width: 100%;height: auto;object-fit: cover;aspect-ratio: {{section.settings.media_aspect_ratio}};transition: all .5s;display: block;}
  #sp-{{ section.id }} .sp-media-video { position: relative;width: 100%;object-fit: cover;aspect-ratio: {{section.settings.media_aspect_ratio}};transition: all .5s;display: block; } 
  #sp-{{ section.id }} .sp-media-video-wrapper svg {position: absolute;top: calc(50% - ({{ section.settings.play_button_size }}px / 2));
  left: calc(50% - ({{ section.settings.play_button_size }}px / 2));cursor: pointer;transition: all .5s;visibility: hidden;opacity: 0;filter: drop-shadow(1px 1px 2px rgba(0, 0, 0, 0.25));height: {{section.settings.play_button_size}}px;width: {{section.settings.play_button_size}}px;color: {{section.settings.play_btn_bg_color}};}
  #sp-{{ section.id }} .sp-media-video-wrapper .sp-pause-button.sp-active-btn {opacity: 1;visibility: visible;}
  #sp-{{ section.id }} .sp-media-video-wrapper:hover .sp-play-button.sp-active-btn {opacity: 1;visibility: visible;}
  #sp-{{ section.id }} .sp-media-grid-title {margin: 0 auto 30px;} 
  #sp-{{ section.id }} .sp-media-grid-heading {margin: 0 0 20px;font-size: {{ section.settings.title_font_size }}px;color: {{section.settings.title_color}};font-weight: 500;} 
  #sp-{{ section.id }} .sp-media-grid-desc p {margin: 0;font-size: {{ section.settings.content_font_size }}px;line-height: 1.4;color: {{section.settings.content_color}};} 
  
  @media only screen and (min-width: 768px){ 
    #sp-{{ section.id }} .sp-media-grid {display: grid;}
    #sp-{{ section.id }} .sp-desk-media-grid-3 {grid-template-columns: 1fr 1fr 1fr;}
    #sp-{{ section.id }} .sp-desk-media-grid-4 {grid-template-columns: 1fr 1fr 1fr 1fr;}
  }  
  
  @media only screen and (max-width: 767px){
    #sp-{{ section.id }}.sp-media-section {padding: {{ section.settings.mob_padding_top }}px 0 {{section.settings.mob_padding_bottom}}px 0;}  
    #sp-{{ section.id }} .sp-media-grid{gap: 10px;}
    #sp-{{ section.id }} .sp-media-video-wrapper svg{height: 40px;width: 40px;top: calc(50% - (40px / 2));left: calc(50% - (40px / 2));}
    #sp-{{ section.id }} .sp-mob-media-grid-2 {grid-template-columns: 1fr 1fr;}
    #sp-{{ section.id }} .sp-mob-media-grid-1 {grid-template-columns: 1fr;}
    #sp-{{ section.id }} .sp-media-grid-heading {margin: 0 0 10px;font-size: 26px;} 
    #sp-{{ section.id }} .sp-media-grid-desc p {font-size: 14px;} 
  } 
</style>
{%- endcapture -%}
{{- sp_media_grid_css | strip_newlines -}}

<div id="sp-{{ section.id }}" class="sp-media-section">
  <div class="sp-page-width {% if section.settings.full_width %}sp-full-page-width{% endif %}">
    {% if section.settings.title != blank or section.settings.content != blank %}
      <div class="sp-media-grid-title sp-title-align-{{ section.settings.text_align }}">
        {% if section.settings.title != blank %}
          <h2 class="sp-media-grid-heading">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.content != blank %}
          <div class="sp-media-grid-desc sp-section-desc">
            {{ section.settings.content }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="sp-media-grid sp-mob-media-grid-{{ section.settings.mobile_column }} sp-desk-media-grid-{{ section.settings.desk_column }}">  
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'image' %}
              <div class="sp-media-grid-item">
                {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', class: 'sp-media-img', alt: block.settings.image.alt }}
                {% else %}
                  <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 500 500' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='496' height='496' fill='%23D8D8D8' stroke='%23D8D8D8' stroke-width='4'/%3E%3C/g%3E%3C/svg%3E" width="" height="" loading="lazy" class="sp-media-img" alt="media-grid" >
                {% endif %}
                {% if block.settings.link != blank %}</a>{% endif %}
              </div>

            {% when 'video' %}
              <div class="sp-media-grid-item">
                <div class="sp-media-video-wrapper">
                  {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                  {% if block.settings.video != blank %}
                    {% if block.settings.poster %}
                      {% assign poster = block.settings.poster | image_url: width: 600 %}
                      {{ block.settings.video | video_tag:
                        image_size: '1100x',
                        class: 'sp-media-video',
                        playsinline: block.settings.video_inline,
                        autoplay: block.settings.video_autoplay,
                        loop: block.settings.video_loop,
                        controls: block.settings.video_controls,
                        muted: block.settings.video_muted,
                        preload: 'metadata',
                        poster: poster
                      }}
                    {% else %}
                      {{ block.settings.video | video_tag:
                        image_size: '1100x',
                        class: 'sp-media-video',
                        playsinline: block.settings.video_inline,
                        autoplay: block.settings.video_autoplay,
                        loop: block.settings.video_loop,
                        controls: block.settings.video_controls,
                        muted: block.settings.video_muted
                      }}
                    {% endif %}
                  {% else %}
                    <video class="sp-media-video" playsinline="true" autoplay="autoplay" loop="loop" muted="muted" preload="metadata" poster="">
                      <source src="https://cdn.shopify.com/videos/c/o/v/8cf086028a28474aa666c2665d04e016.mp4" type="video/mp4">
                    </video>
                  {% endif %}
                  {% if block.settings.link != blank %}</a>{% endif %}
                  {% if section.settings.play_button %}
                    <svg class="sp-pause-button sp-play-pause-button{% if block.settings.video_autoplay == false or block.settings.video_muted == false %} sp-active-btn{% endif %}" width="50px" height="50px" viewBox="0 0 90 90" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g id="media-grid" transform="translate(-325, -205)" fill="currentcolor" fill-rule="nonzero"><g transform="translate(40, 145)"><g transform="translate(230, 0)"><path d="M99.5,60 C105.655833,60 111.440833,61.168125 116.855,63.504375 C122.269167,65.840625 126.97875,69.01125 130.98375,73.01625 C134.98875,77.02125 138.159375,81.7308333 140.495625,87.145 C142.831875,92.5591667 144,98.3441667 144,104.5 C144,110.655833 142.831875,116.440833 140.495625,121.855 C138.159375,127.269167 134.98875,131.97875 130.98375,135.98375 C126.97875,139.98875 122.269167,143.159375 116.855,145.495625 C111.440833,147.831875 105.655833,149 99.5,149 C93.3441667,149 87.5591667,147.831875 82.145,145.495625 C76.7308333,143.159375 72.02125,139.98875 68.01625,135.98375 C64.01125,131.97875 60.840625,127.269167 58.504375,121.855 C56.168125,116.440833 55,110.655833 55,104.5 C55,98.3441667 56.168125,92.5591667 58.504375,87.145 C60.840625,81.7308333 64.01125,77.02125 68.01625,73.01625 C72.02125,69.01125 76.7308333,65.840625 82.145,63.504375 C87.5591667,61.168125 93.3441667,60 99.5,60 Z M90,85 L90,125 L121,105 L90,85 Z" id="Shape"></path></g></g></g></g></svg>
                    <svg class="sp-play-button sp-play-pause-button{% if block.settings.video_autoplay and block.settings.video_muted == true %} sp-active-btn{% endif %}" width="50px" height="50px" viewBox="0 0 90 90" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g id="media-grid" transform="translate(-402, -205)" fill="currentcolor"><g id="Group-21" transform="translate(40, 145)"><g id="Group-20" transform="translate(230, 0)"><path d="M176.5,60 C182.655833,60 188.440833,61.168125 193.855,63.504375 C199.269167,65.840625 203.97875,69.01125 207.98375,73.01625 C211.98875,77.02125 215.159375,81.7308333 217.495625,87.145 C219.831875,92.5591667 221,98.3441667 221,104.5 C221,110.655833 219.831875,116.440833 217.495625,121.855 C215.159375,127.269167 211.98875,131.97875 207.98375,135.98375 C203.97875,139.98875 199.269167,143.159375 193.855,145.495625 C188.440833,147.831875 182.655833,149 176.5,149 C170.344167,149 164.559167,147.831875 159.145,145.495625 C153.730833,143.159375 149.02125,139.98875 145.01625,135.98375 C141.01125,131.97875 137.840625,127.269167 135.504375,121.855 C133.168125,116.440833 132,110.655833 132,104.5 C132,98.3441667 133.168125,92.5591667 135.504375,87.145 C137.840625,81.7308333 141.01125,77.02125 145.01625,73.01625 C149.02125,69.01125 153.730833,65.840625 159.145,63.504375 C164.559167,61.168125 170.344167,60 176.5,60 Z M167.073333,88 C164.823693,88 163,89.8236935 163,92.0733333 L163,119.926667 C163,122.176307 164.823693,124 167.073333,124 C169.322973,124 171.146667,122.176307 171.146667,119.926667 L171.146667,92.0733333 C171.146667,89.8236935 169.322973,88 167.073333,88 Z M185.873333,88 C183.623693,88 181.8,89.8236935 181.8,92.0733333 L181.8,119.926667 C181.8,122.176307 183.623693,124 185.873333,124 C188.122973,124 189.946667,122.176307 189.946667,119.926667 L189.946667,92.0733333 C189.946667,89.8236935 188.122973,88 185.873333,88 Z" id="Combined-Shape"></path></g></g></g></g></svg>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
  </div>
</div>

<script>
  {% if section.settings.play_button %}
    var sp_videos = document.querySelectorAll(`#sp-{{ section.id }} .sp-media-video-wrapper video`);
    if(sp_videos.length > 0){
      for(var x=0; x<sp_videos.length; x++) {
        sp_videos[x].closest(".sp-media-video-wrapper").querySelectorAll(".sp-play-pause-button").forEach(playPauseBtn => {
          playPauseBtn.addEventListener("click", function(){
            this.closest(".sp-media-video-wrapper").querySelector(".sp-active-btn").classList.remove("sp-active-btn");
              if(this.closest(".sp-media-video-wrapper").querySelector("video").paused){
                this.closest(".sp-media-video-wrapper").querySelector(".sp-play-button").classList.add("sp-active-btn");
                this.closest(".sp-media-video-wrapper").querySelector("video").play();
              }
              else{
                this.closest(".sp-media-video-wrapper").querySelector(".sp-pause-button").classList.add("sp-active-btn");
                this.closest(".sp-media-video-wrapper").querySelector("video").pause();
              }
          });
        });
      }
    }
  {% endif %}
</script>

{% schema %}
{
  "name": "SH: Media grid",
  "tag": "section",
  "class": "sh-section-hub-main",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Display Media in Style"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>The media grid lets you display images and videos in a cool grid format. Stacks or converts to slideshow on mobile!</p>"
    },
    {
      "type":"text_alignment",
      "id":"text_align",
      "label": "Text alignment",
      "default": "center"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Height",
      "options": [
        {
          "value": "16 / 10",
          "label": "Small"
        },
        {
          "value": "1 / 1",
          "label": "Medium"
        },
        {
          "value": "9 / 12",
          "label": "Large"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "paragraph",
      "content": "Number of columns"
    },
    {
      "type": "select",
      "id":"desk_column",
      "label": "Desktop",
      "options":[
        { "label": "3 column", "value": "3" },
        { "label": "4 column", "value": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id":"mobile_column",
      "label": "Mobile",
      "options":[
        { "label": "1 column", "value": "1" },
        { "label": "2 column", "value": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 25,
      "label": "Space between media (Desktop)"
    },
    {
      "type": "range",
      "id": "media_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Media border radius",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "play_button",
      "label": "Show play / pause button (For video)",
      "default": false
    },
    {
      "type": "header",
      "content": "Font size"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Content",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#121212"
    },
    { 
      "type": "paragraph",
      "content": "Play button"
    },
    { 
      "type": "color",
      "id": "play_btn_bg_color",
      "label": "Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id":"play_button_size",
      "min": 10,
      "max": 70,
      "step": 1, 
      "unit": "px",
      "label": "Size (Desktop)",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "paragraph",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    },
    {
      "type": "paragraph",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "mob_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "mob_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section width"
    },
    {
      "type": "checkbox",
      "label": "Full width",
      "id": "full_width",
      "default": false
    },
    {
      "type": "text",
      "id": "section_max_width",
      "label": "Width (in px)",
      "default": "1140",
      "info": "Will apply when full width is disabled"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name":"Image",
      "settings": [
        {
          "type": "image_picker",
          "id":"image",
          "label": "Image"
        },
        {
          "type": "url",
          "id":"link",
          "label": "Optional link"
        }
      ]
    },
    {
      "type": "video",
      "name":"Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        },
        {
          "type": "checkbox",
          "id": "video_inline",
          "label": "Play inline",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_controls",
          "label": "Show video controls",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "video_muted",
          "label": "Mute video",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SH: Media grid",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "video"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer","header"]
  }
}
{% endschema %}
